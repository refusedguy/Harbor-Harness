<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Directory.Build.targets — applied AFTER SDK targets.
    Used for: test discovery, runtime-specific config, AOT publish defaults.
  -->

  <PropertyGroup>
    <!-- Test projects: use TUnit, generate test artifacts -->
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <OutputType Condition="$(IsTestProject) == 'true'">Exe</OutputType>
    <IsPackable Condition="$(IsTestProject) == 'true'">false</IsPackable>
    <GenerateDocumentationFile Condition="$(IsTestProject) == 'true'">false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Test projects: TUnit + Microsoft Testing Platform (version pinned via Directory.Packages.props) -->
  <ItemGroup Condition="$(IsTestProject) == 'true'">
    <PackageReference Include="TUnit"/>
  </ItemGroup>

  <!-- Source generators: enable for all projects -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- NativeAOT publish defaults (per-project opt-in via PublishAot=true) -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetricsSupport>false</MetricsSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>true</StripSymbols>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
  </PropertyGroup>

  <!-- Embed provider JSON configs so they ship with the binary -->
  <ItemGroup Condition="'$(EmbedProviders)' == 'true'">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)providers\*.json"/>
  </ItemGroup>

  <!--
    THE PER-TEST ALLOCATION CENSUS (tests/AllocationCensus.cs).

    TUnit's generator discovers a hook in the compilation it generates FOR, so
    a measurement that lives in a helper ASSEMBLY is never discovered and never
    runs. The census therefore has to be COMPILED INTO every test project, and
    this is the line that does it.

    The condition is `$(IsTestProject) == 'true'` — the SAME condition that
    injects the TUnit package reference above, and for the same reason: the
    census is TUnit code, so it belongs in exactly the projects that got TUnit.
    A condition that asked "does this project reference TUnit?" instead would
    MISS every project that receives TUnit through the injection — which is
    most of them: `Harbor.Config.Tests` and `Harbor.Tui.Tests` declare no
    TUnit reference of their own and get one from this file. Asking the same
    question the injection asks is what keeps the two sets identical.

    The projects that opt OUT of TUnit (`IsTestProject=false`:
    `Harbor.TestKit.Generators`, `Harbor.Benchmarks`, `Harbor.Telemetry.Fixtures`
    and the analyzer canary) therefore do not carry the census either.

    The file is INTERNAL, so no test assembly's public surface grows, and two
    assemblies that both carry it never collide.

    The census is OFF unless HARBOR_ALLOC_CENSUS=1 is set: the file reads no
    counter and writes no line without that variable, so a normal run pays
    nothing for it.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)tests\AllocationCensus.cs" Link="AllocationCensus.cs"/>
  </ItemGroup>

</Project>
