<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Plugin.FileTree</PackageId>
    <Description>Sample Harbor plugin — visualize directory structure as a tree.</Description>
    <PackageTags>harbor;plugin;tree;sample</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <!-- #957: Microsoft.Extensions.Logging removed. The plugin only uses
         ILogger<T> and LogInformation, both from Microsoft.Extensions.Logging.Abstractions
         (reached through Harbor.Abstractions). -->
  </ItemGroup>

</Project>
