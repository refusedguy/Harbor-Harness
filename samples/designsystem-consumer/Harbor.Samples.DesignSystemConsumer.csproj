<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Acceptance proof for the "Design System as Product" sprint: this consumer
    references ONLY Harbor.DesignSystem (no other Harbor project, no UI
    framework) and must build clean. `dotnet run` prints the active theme and
    asserts that the package assembly carries zero Harbor.* assembly refs.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Harbor.DesignSystem/Harbor.DesignSystem.csproj"/>
  </ItemGroup>

</Project>
