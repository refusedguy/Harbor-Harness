<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Versioning -->
    <Version>0.4.0-alpha</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <Authors>Harbor Contributors</Authors>
    <Company>Harbor</Company>
    <Product>Harbor</Product>
    <Copyright>MIT</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/refusedguy/Harbor-Harness</PackageProjectUrl>
    <RepositoryUrl>https://github.com/refusedguy/Harbor-Harness</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build features -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <!--
      Every project a Release build touches must be BUILT in Release (#1921).

      MSBuild's solution build does not do that on its own, and the reason is
      worth writing down because nothing in the build output says it happened:

        1. `AssignProjectConfiguration` maps every <ProjectReference> onto the
           SOLUTION's configuration table (dotnet/msbuild,
           src/Tasks/AssignProjectConfiguration.cs). A referenced project that is
           not a member of the solution has no row in that table, so the mapping
           cannot be resolved for it.
        2. For an unresolvable reference the task sets
           `GlobalPropertiesToRemove = "Configuration;Platform"` on the item, and
           the MSBuild call that builds the reference honours it
           Microsoft.Common.CurrentVersion.targets (line 1850),
           `RemoveProperties="%(...GlobalPropertiesToRemove);..."`).
        3. The child therefore starts with NO Configuration at all, and
           Microsoft.Common.CurrentVersion.targets (line 149) answers that with
           `<Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>`.

      Measured on CI run 39389070999: three of the 112 projects that Release
      build compiled produced `bin/Debug` output and no `bin/Release` output at
      all — src/Harbor.CodeGen (the source generator that runs inside every
      other project's compilation), external/ConsoleEx/SharpConsoleUI (the
      vendored UI kit that ships inside the CLI) and apps/Harbor.App.Avalonia.
      The three are exactly the projects that the solution pulls in through a
      <ProjectReference> and that are NOT rows of Harbor.slnx; every other
      project in the graph is a row and was built in Release.

      `ShouldUnsetParentConfigurationAndPlatform` is MSBuild's own switch for
      this. It defaults to true for a solution build
      Microsoft.Common.CurrentVersion.targets (line 1584) and that default is what
      unsets the configuration. Set to false, a reference the solution cannot map
      inherits the CONFIGURATION of the project that references it, so the whole
      graph is built in the configuration the caller asked for.

      The other mitigation is to make every project a row of Harbor.slnx, and
      for src/Harbor.CodeGen and apps/Harbor.App.Avalonia that is worth doing
      too. It cannot be the whole answer, though: a row for the vendored
      external/ConsoleEx/SharpConsoleUI dangles whenever the submodule is not
      checked out, and BuildGraphCoverageRule.NoSolutionRow_IsDangling fails
      the build then. This switch covers the vendored tree, contrib/ and every
      project added to the graph later without a row.
    -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>

    <!--
      The second half of the same fix: a project reference STATES the
      configuration it builds its child in.

      The switch above makes an unmappable reference INHERIT the referencing
      project's configuration. Inheritance is one channel, and it is not the
      only one MSBuild uses to decide how a referenced project is built: a
      reference can also be built through a path that does not carry the
      parent's Configuration, and then the child falls back to
      Microsoft.Common.CurrentVersion.targets (line 149) — Debug.

      Measured on CI run 39407510139 (the run that carried the switch above):
      src/Harbor.CodeGen was built TWICE — once in Release (the solution's own
      path) and once in Debug (a second path), and the Debug build's output
      directory is what the Release build's dependency copies were compared
      against. The Release build was correct — no Debug-built assembly reached
      any Release bin — but a project was still being compiled in Debug inside
      a Release build, which is the defect #1921 is about.

      `SetConfiguration` is the metadata MSBuild's own
      Microsoft.Common.CurrentVersion.targets (line 2150) passes to the MSBuild call
      that builds a referenced project, so setting it here makes the child's
      configuration an EXPLICIT global property instead of an inherited one:
      the child is built in the configuration of the build that asks for it,
      whichever path asks.

      The default applies to every <ProjectReference> in the repository. A
      reference to a project that IS a row of Harbor.slnx is unaffected: the
      solution's own configuration map overwrites this metadata for it
      (AssignProjectConfiguration.SetMetadata), and the solution's map is the
      authority there.
    -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
    </ProjectReference>
  </ItemDefinitionGroup>

    <!--
      Feature-flag defaults (see Harbor.Hosting.csproj F2.2 plumbing).

      The HarborWith* properties used to be defined ONLY inside apps/*.csproj,
      so plain `dotnet build` evaluated src/Harbor.Hosting with an empty value:
      no plugin ProjectReferences, no DefineConstants, runtime log printed
      "Feature flags: plugins=False" and the entire CS-plugin pipeline was dead
      code outside NUKE-driven release builds. These defaults make a standard
      `dotnet build` produce what actually ships. Env override:
      HARBOR_MINIMAL=true keeps the stripped profile (matches Cli's mapping);
      explicit /p:HarborWith*=false still wins when passed directly.
    -->
    <HarborWithPlugins Condition="'$(HarborWithPlugins)' == '' AND '$(HARBOR_MINIMAL)' != 'true'">true</HarborWithPlugins>
    <HarborWithPlugins Condition="'$(HARBOR_MINIMAL)' == 'true'">false</HarborWithPlugins>

    <!--
      Slice A (#1144): daemon on/off. Default keeps the full IPC graph
      (in-process + server + client); with-daemon=false (NUKE spelling carries
      the usual double-hyphen prefix) or HARBOR_MINIMAL drops the Server/Client
      assemblies so the binary is single-process only.
      HarborWithRenderer above deliberately has no HARBOR_MINIMAL row.
    -->
    <HarborWithDaemon Condition="'$(HarborWithDaemon)' == '' AND '$(HARBOR_MINIMAL)' != 'true'">true</HarborWithDaemon>
    <HarborWithDaemon Condition="'$(HARBOR_MINIMAL)' == 'true'">false</HarborWithDaemon>

    <!--
      Slice A (#1144): build-time renderer selection. Default composes every
      backend (status quo); the NUKE with-renderer flag narrows it (see
      src/Harbor.Hosting/Harbor.Hosting.csproj for what each value excludes).
      Case-insensitive in MSBuild; canonical lowercase spellings.

      It currently excludes NOTHING: the one backend it could leave out was the
      vendored SharpConsoleUI renderer, and that backend left the product for
      contrib/tui/. The vocabulary is kept so the single-renderer CLI has a
      place to land and so a misspelled value still fails the build.
    -->
    <HarborWithRenderer Condition="'$(HarborWithRenderer)' == ''">all</HarborWithRenderer>

    <!-- Debugging -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Performance: enable optimizations always (even in Debug for lib code) -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

    <!-- Allow unsafe: NEVER. Project rule. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!--
      NuGet audit — pinned, not inherited (#1857).

      This file is the one that governs the whole solution: src/, tests/,
      apps/, samples/ and tools/ all import it (apps/, tests/ and src/ do it
      by RELATIVE path, because the project-file analyzer can only follow an
      import it can resolve on disk, see src/Directory.Build.props). The two
      places it does NOT reach are build/ (the NUKE tool, which declares
      that it does not inherit solution-wide strictness) and contrib/ (not
      built by CI). Both are noted here so the claim "the audit is pinned
      repository-wide" is not read as covering them.

      WHAT THE SDK DEFAULT ACTUALLY IS, and the previous version of this
      comment got it wrong, which is why it is written out now.
      NuGet 7.0 (the .NET 10 SDK) changed the default of `NuGetAuditMode`:
      it now defaults to `all` for a project that targets `net10.0` or
      higher, and to `direct` below that. Harbor targets net10.0, so the
      SDK default on this repository is ALREADY `all`. `direct`, what an
      earlier version of this comment called the default, is the pre-NuGet-7.0
      (.NET 8/9 SDK) behaviour, and is still the default for a project below
      net10.0. The pin is therefore NOT what turns the audit on today. What
      it does is make the gate a property of the repository instead of a
      property of the SDK: a reader who deletes these two lines because they
      "look redundant" removes the guarantee, and a future SDK that changes
      the default again cannot narrow the gate under us.

      `NuGetAuditLevel` is the other half, and the SDK default there is
      `low`, which reports EVERY advisory: NU1901 (low), NU1902 (moderate),
      NU1903 (high), NU1904 (critical). This repository pins `moderate`, so
      NU1902/NU1903/NU1904 are reported and NU1901 is not. That is a
      deliberate narrowing, not an accident: a low-severity advisory in a
      transitive package this repository does not control would, under the
      zero-warning gate (TreatWarningsAsErrors=true), break every build in
      the repository the day the advisory is published. The severities
      this repository has actually had to act on are the moderate and high
      ones (the MessagePack and ImageSharp advisories, NU1902/NU1903, whose
      per-project suppressions #1911 removed).

      The mode is `all` because Directory.Packages.props turns on
      `CentralPackageTransitivePinningEnabled` and pins the transitive
      versions of SixLabors.ImageSharp and MessagePack on purpose: a
      transitive advisory is Harbor's subject, not the SDK's business to
      decide.
    -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <!--
    The project-file analyzer's severity table reaches the compiler through
    this item (#1857). `EditorConfigFiles` is what the C# task passes to the
    compiler as /analyzerconfig:, and the file is added HERE rather than left
    to the SDK's discovery, because the SDK discovers a `.globalconfig` by
    walking up from the COMPILED SOURCES: a project that compiles no source
    file of its own (a meta-package, a test project whose sources moved into
    Harbor.TestKit) would discover nothing, and every rule in the table would
    fall back to its shipped default — which is Warning, and
    TreatWarningsAsErrors promotes that to an error.

    The file is named `Directory.Build.globalconfig` rather than
    `.globalconfig` so the SDK's discovery does not add the same file twice
    (two copies make Roslyn report a duplicate-key warning for every key in
    it, and that warning is an error here).
  -->
  <ItemGroup>
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)Directory.Build.globalconfig" />
  </ItemGroup>

  <!-- NativeAOT opt-in per project; default off -->
  <PropertyGroup>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <!--
      XML doc comment warnings are noisy and not actionable in the hot loop of
      authoring interfaces — many cref references intentionally span to
      implementations living further out (e.g. ProviderRegistry.Freeze in
      Harbor.Registries) that cannot be referenced from Harbor.Abstractions
      without breaking the dependency inversion. CS1570 (malformed XML),
      CS1571 (duplicate param tag),
      CS1574 (unresolved cref), and CS0419 (ambiguous cref) are suppressed so
      documentation improvements can land incrementally without blocking the
      build.
    -->
    <NoWarn>$(NoWarn);CS1570;CS1571;CS1574;CS0419</NoWarn>

    <!--
      New Sonar rules introduced by SonarAnalyzer.CSharp 10.29 upgrade.
      Each requires per-call-site code refactoring that is out of scope for
      the package-update task; tracked as a follow-up:

        S6444 — Regex without match timeout (62 call sites across TUI renderers,
                WebFetchTool, MarkdownRenderer). Fix = pass `TimeSpan` to every
                `new Regex(...)` and `Regex.Replace(...)` call.
        S4036 — ProcessStartInfo.FileName must be an absolute path (10 sites in
                GitToolsPlugin, TscCompiler, NotificationTuiRenderer). Fix =
                resolve tool path via `PathHelper` / `Where` lookup before launch.
        S2245 — Use RandomNumberGenerator instead of System.Random (2 sites in
                Harbor.App.Blazor ViewModels.cs).
        S3267 — Simplify foreach+if into .Where() LINQ (2 sites in RipGrepTool).

      These are NoWarn'd here so the upgraded analyzers ship today; the code
      refactors land in a follow-up commit. The codes also remain disabled for
      downstream analyzer consumers (PrivateAssets=all), so the suppressions do
      not leak out of the Harbor source build.
    -->
    <NoWarn>$(NoWarn);S6444;S4036;S2245;S3267</NoWarn>
  </PropertyGroup>

  <!--
    Central Package Management (CPM):
      All package versions are pinned in Directory.Packages.props.
      Projects declare only <PackageReference Include="..." /> (no Version).
      Analyzers are pulled in here as solution-wide defaults; their versions
      are also pinned in Directory.Packages.props.

      See docs/CENTRAL_PACKAGE_MANAGEMENT.md for the full guide.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Banned API analyzer input (Microsoft.CodeAnalysis.BannedApiAnalyzers, RS0030).
    The analyzer package is referenced above, but the rules in /BannedSymbols.txt
    were dead until ROP-D Z2: (a) the file was never listed in AdditionalFiles,
    and (b) the analyzer only reads files named `BannedSymbols.txt` or
    `BannedSymbols.*.txt` — the old `BannedApi.txt` name was invisible to it.
    Every new use of a banned API now fails the build. Accepted legacy
    exemptions carry a documented reason at the call site
    (#pragma warning disable RS0030 // reason) and are catalogued by class in
    BannedSymbols.txt itself.
  -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!--
    #1844: the dynamic-code ban (#626) — /BannedSymbols.DynamicCode.txt.

    THE CONVENTION is written down in
    tests/Harbor.Architecture.Tests/ReflectionConventionRule.cs; the RULE is
    the ban file, and the compiler enforces it. Before this the same rule was a
    hand-written regex over the source text (plus a comment stripper, plus ten
    planted controls): the compiler already knows how to say "this symbol is
    banned here", and saying it in the compiler's language is both shorter and
    stricter — it matches the SYMBOL, so a type alias, a different spelling or
    a comment cannot slip past.

    THE PLUGIN EXCEPTION IS EXPRESSED BY THE TOOL, NOT BY A COMMENT
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    `src/Harbor.Plugins.*` loads code at run time because loading code at run
    time IS the plugin product. The exemption is therefore not a pragma at the
    call site and not a baseline subtracted by a scanner: the ban file is simply
    NOT ADDED to the plugin projects' AdditionalFiles, so the compiler never
    sees the rule there. The exemption is the absence of the file, which is a
    thing the tool enforces rather than a thing a reader has to believe.

    `$(MSBuildProjectName)` (not a path) is the predicate, so the check does
    not depend on how the checkout spells `/` versus `\`. The prefix lives in a
    property so it is ONE fact with ONE home: the convention's prose, this
    condition, and the architecture test that reads both.
  -->
  <PropertyGroup>
    <HarborDynamicCodeBanExemptProjectNamePrefix>Harbor.Plugins.</HarborDynamicCodeBanExemptProjectNamePrefix>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.DynamicCode.txt"
                     Condition="!$(MSBuildProjectName.StartsWith('$(HarborDynamicCodeBanExemptProjectNamePrefix)'))" />
  </ItemGroup>

  <!--
    RS0030 policy: production code (src/, apps/, contrib/tui, contrib/apps)
    enforces banned-API violations as errors via the global
    TreatWarningsAsErrors above; accepted legacy exemptions live as pragmas at
    their call sites and are catalogued in BannedSymbols.txt itself. The
    exemption below is matched on the PROJECT PATH, so it also reaches
    `samples/` (samples/plugins included) and every project under a directory
    named `tests`: those projects are not in the error set today.

    Test, benchmark and E2E-driver projects are exempted centrally below:
    benchmark GlobalSetup/IterationSetup, Avalonia-headless marshaling helpers
    and IPC test fixtures block on async setup by design (their lifecycles are
    synchronous), and failing CI on those would train people to ignore the
    analyzer. `NoWarn` hides the diagnostic COMPLETELY: the rules are NOT
    visible as warnings in those builds, so review is the only backstop for a
    banned call in test code. The package edge of the same ban (a package that
    drags a banned assembly into a test project's bin/) is a different gate:
    tools/check-test-packages.py, with named exceptions in
    tools/test-package-exceptions.txt. AGENTS.md §"What NOT to do" #2 states
    the scope of the ban.
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('tests')) or $(MSBuildProjectDirectory.Contains('samples'))">
    <NoWarn>$(NoWarn);RS0030</NoWarn>
    <!--
      CFE0001 policy for tests: the guard's ONLY value is protecting shipped
      code paths from a ResultFailureException at runtime. In a test, that
      exception IS the failure signal — `(await store.CreateAsync(...)).Value`
      throwing means the fixture broke, which is exactly what the test should
      do. Measured on this branch: 174 CFE0001 sites, 100% of them in tests/,
      0 in src/. All 174 are the same false positive — the guard is a bare
      `Assert.That(result.IsSuccess).IsTrue()` statement, and the analyzer's
      walker only models `if`-scoped and ternary checks, so it never sees it.

      Suppressed here (same condition as RS0030, same reasoning) rather than
      with 174 call-site pragmas. Production is NOT covered by this condition:
      src/apps/contrib keep CFE0001 at full severity, so a new unguarded
      .Value there is still a build error.
    -->
    <NoWarn>$(NoWarn);CFE0001</NoWarn>
  </PropertyGroup>

  <!--
    ANALYZER SCOPE (issue #1801).

    Every analyzer package below is declared ONCE, in this file, and every
    PackageReference carries the condition that turns it off. WHERE a family
    runs is a separate decision from WHICH family runs, and it is written
    down in one place: tools/analyzer-scope.json. The gate that keeps this
    file and that table in step is tools/check-analyzer-scope.py.

    THE THREE SCOPE FILES. A project under src/, apps/ or tests/ imports
    the NEAREST Directory.Build.props, and each of those three files states
    the scope of every family it wants to change BEFORE it imports this
    one. A property assigned in a props file wins over the default below,
    and a global property (the command line) wins over both — which is what
    lets the measurement harness turn exactly one family off for a whole
    build with `-p:HarborAnalyzerSonar=off`, and nothing else.

    THE DEFAULT BELOW IS THE ROOT SCOPE: the projects that import this file
    and no other — samples/, tools/ and contrib/. A family whose default is
    `off` runs only where a scope file turns it on.

    WHY THE SCOPE IS A DECISION AND NOT A DETAIL. The nine analyzer
    packages used to be referenced by every project in the tree. The cost
    of that was measured rather than guessed (issue #1801; the numbers are
    in docs/ANALYZERS.md): a family that produces no finding in a tree
    still runs its analyzers over every compilation in that tree, once per
    analyzer class in the package.

    AND THE SEVERITY TABLE CANNOT SWITCH THAT COST OFF. That is the
    measurement that decides the shape of this file: the compiler's own
    analyzer report (`-p:ReportAnalyzer=true`) attributes 45.5 s of the
    build to `VSTHRD010MainThreadUsageAnalyzer` — a rule this repository
    sets to `severity = none`. Roslyn runs the analyzer and drops the
    diagnostic afterwards; the work is already paid. So `severity = none`
    is a way of not hearing a rule, not a way of not running it, and the
    SCOPE is the only lever that removes the cost.

    So the scope is written down or it drifts back: a package declared in
    this file is declared for EVERY tree. The gate is what keeps that from
    happening again.
  -->
  <PropertyGroup>
    <HarborAnalyzerRoslynator Condition="'$(HarborAnalyzerRoslynator)' == ''">on</HarborAnalyzerRoslynator>
    <HarborAnalyzerSonar Condition="'$(HarborAnalyzerSonar)' == ''">off</HarborAnalyzerSonar>
    <HarborAnalyzerNetAnalyzers Condition="'$(HarborAnalyzerNetAnalyzers)' == ''">on</HarborAnalyzerNetAnalyzers>
    <HarborAnalyzerAsyncFixer Condition="'$(HarborAnalyzerAsyncFixer)' == ''">off</HarborAnalyzerAsyncFixer>
    <HarborAnalyzerReflection Condition="'$(HarborAnalyzerReflection)' == ''">on</HarborAnalyzerReflection>
    <HarborAnalyzerBannedApi Condition="'$(HarborAnalyzerBannedApi)' == ''">on</HarborAnalyzerBannedApi>
    <HarborAnalyzerMeziantou Condition="'$(HarborAnalyzerMeziantou)' == ''">on</HarborAnalyzerMeziantou>
    <HarborAnalyzerDiLifetime Condition="'$(HarborAnalyzerDiLifetime)' == ''">off</HarborAnalyzerDiLifetime>
    <HarborAnalyzerCfe Condition="'$(HarborAnalyzerCfe)' == ''">on</HarborAnalyzerCfe>
    <HarborAnalyzerProjectFile Condition="'$(HarborAnalyzerProjectFile)' == ''">on</HarborAnalyzerProjectFile>
    <HarborAnalyzerVsThreading Condition="'$(HarborAnalyzerVsThreading)' == ''">on</HarborAnalyzerVsThreading>
    <HarborAnalyzerExcubo Condition="'$(HarborAnalyzerExcubo)' == ''">on</HarborAnalyzerExcubo>
    <HarborAnalyzerPublicApi Condition="'$(HarborAnalyzerPublicApi)' == ''">on</HarborAnalyzerPublicApi>
  </PropertyGroup>

  <!-- Analyzers: comprehensive static analysis (versions pinned in Directory.Packages.props) -->
  <!--
    Every analyzer package below carries `ExcludeAssets="runtime"` next to
    `<PrivateAssets>all</PrivateAssets>` (#1857, rule Proj0037). An analyzer
    package ships no runtime assembly, so listing `runtime` in IncludeAssets is
    exactly the state in which the IDE offers a type the program cannot load
    at run time. Excluding the runtime asset changes nothing for these packages
    — they have none — and it states the intent.

    ATTRIBUTE form, not a child element: Proj0037 reads the attribute
    (`reference.Element.Attribute("ExcludeAssets")`) and ignores the child
    element NuGet also accepts. NuGet reads both forms as the same item
    metadata, so the attribute is the only form that satisfies the rule.

    The IncludeAssets list itself stays: it enumerates the asset kinds an
    analyzer package contributes (analyzers, buildtransitive). Rule Proj0026
    ("remove IncludeAssets when redundant") disagrees and is switched off with
    a reason in /Directory.Build.globalconfig.
  -->
  <ItemGroup>
    <!-- Code style + quality -->
    <PackageReference Include="Roslynator.Analyzers" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerRoslynator)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerSonar)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Microsoft official analyzers -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerNetAnalyzers)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Async best practices -->
    <PackageReference Include="AsyncFixer" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerAsyncFixer)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Reflection correctness (member-by-member), NOT a dynamic-code rule: the
         package ships 46 member-lookup rules (REFL001-REFL046) and none of them
         is about Assembly.Load / AssemblyLoadContext / Reflection.Emit. The
         dynamic-code ban is RS0030 over BannedSymbols.DynamicCode.txt, below. -->
    <PackageReference Include="ReflectionAnalyzers" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerReflection)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Banned API analyzer (rules in /BannedSymbols.txt, wired via AdditionalFiles above) -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerBannedApi)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Performance-focused analyzer -->
    <PackageReference Include="Meziantou.Analyzer" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerMeziantou)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      DI lifetime analyzer — DependencyInjection.Lifetime.Analyzers, which ships
      37 diagnostics (DI001–DI037, no gap). The four promoted to `error` are
      DI003 captive dependency, DI015 unresolvable dependency, DI017 circular
      dependency and DI019 scoped service resolved from the root provider. The
      per-rule severity table is .editorconfig, the only place the mapping is
      written down; this comment states the promoted four and defers the rest
      to it rather than re-listing the numbering.

      The count moved with the version: 2.18.24 shipped 26 ids (DI001–DI022,
      DI024–DI027 — DI023 was unused), 3.7.8 ships 37 (#1897). Eleven ids were
      added and none removed; each new id has its own row in .editorconfig at
      the severity the package ships it with, and docs/ANALYZERS.md carries the
      per-id decision and the reason.

      The numbering used to be mis-stated right here — "DI001 captive
      dependency ... DI003 circular dependency" — and the mismatch was not
      cosmetic. A reader told DI003 means a cycle audits the Avalonia DI graph
      for a cycle, finds none (there are none), and concludes the rule is
      satisfied; the rule that actually needed reading is the captive-dependency
      one, whose demotion went unexamined for a year (#865). A wrong id in a
      comment is worse than no comment, because it is checkable-looking.

      Solution-wide: every project that consumes
      Microsoft.Extensions.DependencyInjection gets checked. Default severity is
      warning.
    -->
    <PackageReference Include="DependencyInjection.Lifetime.Analyzers" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerDiLifetime)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      CFE0001 — "check IsSuccess or IsFailure before accessing Value from
      result object". A mechanical guard for the §ROP-001 crash class: `.Value`
      on a failed Result<T> throws ResultFailureException.

      SCOPE — solution-wide, like every other analyzer above, and that is
      deliberate rather than an oversight. CFE0001 fires only where the
      analyzer can resolve a `CSharpFunctionalExtensions.Result` symbol, i.e.
      only in projects where CSharpFunctionalExtensions is referenced. Adding
      the reference per-project "only where CFE is referenced" would be
      strictly WORSE: Harbor.Abstractions references CFE *transitively*, so
      Harbor.Application, Harbor.Registries and Harbor.Tools.Builtin — the
      projects with by far the most Result<T> traffic — would carry the crash
      risk while being left unguarded. Solution-wide is what actually covers
      the sites that matter.

      ZERO-DEPENDENCY RULE — this does not violate Harbor.Abstractions'
      "no new dependencies" constraint, for two reasons. (1) It is a
      build-time-only analyzer with PrivateAssets=all: nothing flows to
      consumers, nothing is packed into the assembly, no runtime code path
      changes. (2) Harbor.Abstractions already carries build-time tooling of
      exactly this shape — ZLinq.DropInGenerator, a source generator, is
      referenced there with the same IncludeAssets/PrivateAssets pair. The
      constraint is about RUNTIME dependencies, and this is not one.

      CFE0002 is Info and disabled by default; it is deliberately left off
      (docs/ROP-API-INVENTORY.md §5 — low value, Harbor's Result.Failure<T>
      sites are mostly not in an inferable position).

      1.4.1 exists and is NOT taken (#1897): it adds no diagnostic id, but
      its rewritten `ResultValueWalker` crashes the compiler with AD0001 on
      five production projects, which under this repository's
      TreatWarningsAsErrors=true means those projects fail to compile — and a
      project that does not compile emits no CFE0001 at all, so the guard
      would go blind exactly where the crash class lives. The measurement is
      in docs/ROP-API-INVENTORY.md §5.1. The pin stays at 1.3.0.
    -->
    <PackageReference Include="CSharpFunctionalExtensions.Analyzers" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerCfe)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Project-file analyzer (#1857) — 190+ rules over the MSBuild project files
      rather than over C#. Only three of them are adopted (Proj0037,
      Proj0040, Proj0041) and they are errors; the rest are off with a written
      reason, family by family, in /Directory.Build.globalconfig.

      The severity table cannot live in .editorconfig: a diagnostic reported on
      a project file reaches the compiler as an ADDITIONAL FILE, and Roslyn
      applies syntax-tree level editor config only to diagnostics that have a
      source tree. A global analyzer config is the only per-rule mechanism that
      reaches them, which is why /Directory.Build.globalconfig exists, and it
      is wired to the compiler by hand in this file (see the EditorConfigFiles
      item above) because the SDK's own discovery of a `.globalconfig` walks up
      from the compiled sources and misses every project that compiles none.
    -->
    <PackageReference Include="DotNetProjectFile.Analyzers" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerProjectFile)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      ReferenceTrimmer 3.5.13 (#1853) — the unused-reference detector.

      It is OFF by default and ON in exactly one place: the `build` job in
      .github/workflows/ci.yml, whose compile step sets the
      `HarborReferenceTrimmer` property. Since #2108 that compile is the
      ordinary one — the analyzer runs INSIDE the build the lane already pays
      for, instead of in a second job that compiled the whole tree again
      (260 s, 22 % of the pull-request lane's runner-minutes, for one gate).

      The analyzer runs Roslyn's GetUsedAssemblyReferences over every
      compilation in the solution, and its findings are warnings — which
      TreatWarningsAsErrors=true (set above) would turn into build errors on
      the day the package was added. A gate that is red on the tree it lands
      on is a gate nobody lands, so the RT codes are demoted back to warnings
      (the PropertyGroup below) and compared against a baseline by the
      `check-reference-trimmer` gate, which runs in the same job.

      The property is a global property, so `/p:HarborReferenceTrimmer=true`
      reaches the restore as well as the build. The restore matters: the
      package has to be in the assets file before the compiler can load the
      analyzer, and a restore without the property would write an assets file
      the build then does not agree with. CI sets it as an ENVIRONMENT
      variable on the compile step, which MSBuild reads as a property for the
      restore and the build alike.

      PrivateAssets=all: this is a build-time tool, and nothing it brings may
      reach a consumer of a published Harbor package. ExcludeAssets="runtime"
      because the package ships no runtime assembly (its .nuspec carries no
      lib/ folder — only analyzers/dotnet/, build/ and buildMultiTargeting/),
      so there is nothing for the program to load at run time. The `build`
      asset IS needed: the package's props/targets and its
      ReferenceTrimmer.Tasks.dll live there.
    -->
    <PackageReference Include="ReferenceTrimmer" ExcludeAssets="runtime"
                     Condition="'$(HarborReferenceTrimmer)' == 'true'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    THE ANALYZER'S FINDINGS ARE WARNINGS, NOT ERRORS (#1853, #2108).

    TreatWarningsAsErrors=true (above) would turn every RT0001/RT0002/RT0003
    into a build error, so the tree would not build with the analyzer on. The
    findings are not defects the build should refuse: they are CANDIDATES that
    a human has to read, and the `check-reference-trimmer` gate compares them
    with `tools/reference-trimmer-baseline.txt` — a ratchet that goes red on a
    NEW finding and on a finding the tree no longer produces.

    So the RT codes are demoted back to warnings HERE, and only when the
    analyzer is on. `WarningsNotAsErrors` is the right switch for that (it
    maps to the compiler's `/warnaserror-:<ids>`, and a specific id always
    wins over the general setting); `NoWarn` would be wrong — it would hide
    the findings from the compiler's output altogether, and the gate would
    read an empty log and call it clean.

    RT0000 and RT9999 are demoted too: they are statements about the quality
    of the answer (the doc file was off; the analyzer itself failed), and the
    gate reports them as RT-DOC-OFF and RT-ANALYZER-ERROR. The build should
    not fail on them either — the GATE is where they are answered.
  -->
  <PropertyGroup Condition="'$(HarborReferenceTrimmer)' == 'true'">
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RT0000;RT0001;RT0002;RT0003;RT9999</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Release architecture gate (compile-time, not runtime):
      `dotnet build Harbor.slnx -c Release` re-runs the Harbor.Architecture.Tests
      suite (47 layer rules) against the freshly built assemblies as part of the
      build itself. Any layering regression fails the build on CI immediately —
      no PR review or separate test step needed. Works together with the
      BannedApiAnalyzers gate above (banned symbol ⇒ RS0030 build error).

      Scope: runs once, after tests/Harbor.Architecture.Tests is built (its
      ProjectReferences are already fresh by then). Skipped for design-time /
      IDE builds. A test-platform direct run with a no-build flag (no Build
      target) never triggers it. Escape hatch: property HarborArchGate=false.
  -->
  <PropertyGroup>
    <HarborArchGate Condition="'$(HarborArchGate)' == ''">true</HarborArchGate>
  </PropertyGroup>

  <!--
    The Condition below is ONE line on purpose. An attribute value that spans
    several lines crashes the project-file analyzer (#1857) with
    `AD0001: ... 'end' must not be less than 'start'`: the analyzer looks for
    the closing quote on the attribute's first line only, and a value that
    continues on the next line leaves it with an end position of (0,0).
    MSBuild has no way to express several conditions on one attribute without
    a multi-line value, so the conjunction is one long line.
  -->
  <Target Name="HarborArchitectureGate"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(HarborArchGate)' == 'true' AND '$(MSBuildProjectName)' == 'Harbor.Architecture.Tests' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingInsideVisualStudio)' != 'true'">
    <!-- Evaluated HERE, at execution time: at Directory.Build.props import
         time $(IntermediateOutputPath) is still empty, which used to scatter
         the gate log into the project dir instead of obj/. -->
    <PropertyGroup>
      <HarborArchGateLog>$(IntermediateOutputPath)harbor-arch-gate.log</HarborArchGateLog>
    </PropertyGroup>
    <Message Importance="high" Text="[arch-gate] Harbor architecture tests: $(TargetFileName)" />
    <!--
      ConsoleToMSBuild="true": MSBuild captures and writes the output itself, so
      the log file is produced by the task rather than by shell redirection. The
      previous form redirected with `> log` and then ran `tail -30` on failure to
      surface diagnostics - but `tail` does not exist on Windows, so the
      test-os (windows-latest) job failed with exit code 9009 ("command not
      found") the moment the gate ran there. The gate is OS-agnostic now and the
      failure diagnostics still reach the build log.
    -->
    <Exec Command="dotnet exec &quot;$(TargetPath)&quot;"
          IgnoreExitCode="false"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="HarborArchGateExitCode" />
    </Exec>
    <ReadLinesFromFile File="$(HarborArchGateLog)"
                      Condition="'$(HarborArchGateExitCode)' != '0' AND Exists('$(HarborArchGateLog)')">
      <Output TaskParameter="Lines" ItemName="HarborArchGateLogLines" />
    </ReadLinesFromFile>
    <Error Condition="'$(HarborArchGateExitCode)' != '0'"
           Text="Harbor architecture tests failed (exit code $(HarborArchGateExitCode)). Full log: $(HarborArchGateLog)%0A%0A@(HarborArchGateLogLines)" />
  </Target>

</Project>
