<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Versioning -->
    <Version>0.4.0-alpha</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <Authors>Harbor Contributors</Authors>
    <Company>Harbor</Company>
    <Product>Harbor</Product>
    <Copyright>MIT</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/harbor-sh/harbor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/harbor-sh/harbor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build features -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <!-- Debugging -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Performance: enable optimizations always (even in Debug for lib code) -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

    <!-- Allow unsafe: NEVER. Project rule. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NativeAOT opt-in per project; default off -->
  <PropertyGroup>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <!--
      XML doc comment warnings are noisy and not actionable in the hot loop of
      authoring interfaces — many cref references intentionally span to
      Harbor.Core implementations (e.g. ProviderRegistry.Freeze) that cannot be
      referenced from Harbor.Abstractions without breaking the dependency
      inversion. CS1570 (malformed XML), CS1571 (duplicate param tag),
      CS1574 (unresolved cref), and CS0419 (ambiguous cref) are suppressed so
      documentation improvements can land incrementally without blocking the
      build.
    -->
    <NoWarn>$(NoWarn);CS1570;CS1571;CS1574;CS0419</NoWarn>

    <!--
      New Sonar rules introduced by SonarAnalyzer.CSharp 10.29 upgrade.
      Each requires per-call-site code refactoring that is out of scope for
      the package-update task; tracked as a follow-up:

        S6444 — Regex without match timeout (62 call sites across TUI renderers,
                WebFetchTool, MarkdownRenderer). Fix = pass `TimeSpan` to every
                `new Regex(...)` and `Regex.Replace(...)` call.
        S4036 — ProcessStartInfo.FileName must be an absolute path (10 sites in
                GitToolsPlugin, TscCompiler, NotificationTuiRenderer). Fix =
                resolve tool path via `PathHelper` / `Where` lookup before launch.
        S2245 — Use RandomNumberGenerator instead of System.Random (2 sites in
                Harbor.App.Blazor ViewModels.cs).
        S3267 — Simplify foreach+if into .Where() LINQ (2 sites in RipGrepTool).

      These are NoWarn'd here so the upgraded analyzers ship today; the code
      refactors land in a follow-up commit. The codes also remain disabled for
      downstream analyzer consumers (PrivateAssets=all), so the suppressions do
      not leak out of the Harbor source build.
    -->
    <NoWarn>$(NoWarn);S6444;S4036;S2245;S3267</NoWarn>
  </PropertyGroup>

  <!--
    Central Package Management (CPM):
      All package versions are pinned in Directory.Packages.props.
      Projects declare only <PackageReference Include="..." /> (no Version).
      Analyzers are pulled in here as solution-wide defaults; their versions
      are also pinned in Directory.Packages.props.

      See docs/CENTRAL_PACKAGE_MANAGEMENT.md for the full guide.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Analyzers: comprehensive static analysis (versions pinned in Directory.Packages.props) -->
  <ItemGroup>
    <!-- Code style + quality -->
    <PackageReference Include="Roslynator.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Microsoft official analyzers -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Async best practices -->
    <PackageReference Include="AsyncFixer">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Reflection detection (AOT-friendliness) -->
    <PackageReference Include="ReflectionAnalyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Banned API analyzer (configure in .bannedapi.txt) -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Performance-focused analyzer -->
    <PackageReference Include="Meziantou.Analyzer">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- DI lifetime analyzer (DI001 captive dependency, DI002 lifetime mismatch,
         DI003 circular dependency, DI004 transient disposed by singleton).
         Solution-wide: every project that consumes Microsoft.Extensions.DependencyInjection
         gets checked. Severity is configured in .editorconfig (default = warning). -->
    <PackageReference Include="DependencyInjection.Lifetime.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
