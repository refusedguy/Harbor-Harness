<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Versioning -->
    <Version>0.4.0-alpha</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <Authors>Harbor Contributors</Authors>
    <Company>Harbor</Company>
    <Product>Harbor</Product>
    <Copyright>MIT</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/refusedguy/Harbor-Harness</PackageProjectUrl>
    <RepositoryUrl>https://github.com/refusedguy/Harbor-Harness</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build features -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <!--
      Feature-flag defaults (see Harbor.Hosting.csproj F2.2 plumbing).

      The HarborWith* properties used to be defined ONLY inside apps/*.csproj,
      so plain `dotnet build` evaluated src/Harbor.Hosting with an empty value:
      no plugin ProjectReferences, no DefineConstants, runtime log printed
      "Feature flags: plugins=False" and the entire CS-plugin pipeline was dead
      code outside NUKE-driven release builds. These defaults make a standard
      `dotnet build` produce what actually ships. Env override:
      HARBOR_MINIMAL=true keeps the stripped profile (matches Cli's mapping);
      explicit /p:HarborWith*=false still wins when passed directly.
    -->
    <HarborWithPlugins Condition="'$(HarborWithPlugins)' == '' AND '$(HARBOR_MINIMAL)' != 'true'">true</HarborWithPlugins>
    <HarborWithPlugins Condition="'$(HARBOR_MINIMAL)' == 'true'">false</HarborWithPlugins>

    <!--
      Slice A (#1144): daemon on/off. Default keeps the full IPC graph
      (in-process + server + client); with-daemon=false (NUKE spelling carries
      the usual double-hyphen prefix) or HARBOR_MINIMAL drops the Server/Client
      assemblies so the binary is single-process only.
      HarborWithRenderer above deliberately has no HARBOR_MINIMAL row.
    -->
    <HarborWithDaemon Condition="'$(HarborWithDaemon)' == '' AND '$(HARBOR_MINIMAL)' != 'true'">true</HarborWithDaemon>
    <HarborWithDaemon Condition="'$(HARBOR_MINIMAL)' == 'true'">false</HarborWithDaemon>

    <!--
      Slice A (#1144): build-time renderer selection. Default composes every
      backend (status quo); the NUKE with-renderer flag narrows it (see
      src/Harbor.Hosting/Harbor.Hosting.csproj for what each value excludes).
      Case-insensitive in MSBuild; canonical lowercase spellings.

      It currently excludes NOTHING: the one backend it could leave out was the
      vendored SharpConsoleUI renderer, and that backend left the product for
      contrib/tui/. The vocabulary is kept so the single-renderer CLI has a
      place to land and so a misspelled value still fails the build.
    -->
    <HarborWithRenderer Condition="'$(HarborWithRenderer)' == ''">all</HarborWithRenderer>

    <!-- Debugging -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Performance: enable optimizations always (even in Debug for lib code) -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

    <!-- Allow unsafe: NEVER. Project rule. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!--
      NuGet audit — pinned, not inherited (#1857).

      The SDK default is `NuGetAuditMode=direct` (direct dependencies only) and
      `NuGetAuditLevel=low`. Both defaults are the wrong shape for this
      repository: Directory.Packages.props turns on
      `CentralPackageTransitivePinningEnabled` and pins the transitive versions
      of SixLabors.ImageSharp and MessagePack on purpose, so a transitive
      advisory is Harbor's subject and not the SDK's business to decide.
      Leaving the mode at the default would let a vulnerable transitive
      through the gate, which is exactly the class this repository has already
      had to reason about (NU1902/NU1903 for MessagePack and ImageSharp).

      `all` audits direct AND transitive dependencies; `moderate` is the
      smallest level that still reports the advisories the audit exists for.
      Both are pinned here so the SDK default cannot change the gate under us.
    -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <!--
    The project-file analyzer's severity table reaches the compiler through
    this item (#1857). `EditorConfigFiles` is what the C# task passes to the
    compiler as /analyzerconfig:, and the file is added HERE rather than left
    to the SDK's discovery, because the SDK discovers a `.globalconfig` by
    walking up from the COMPILED SOURCES: a project that compiles no source
    file of its own (a meta-package, a test project whose sources moved into
    Harbor.TestKit) would discover nothing, and every rule in the table would
    fall back to its shipped default — which is Warning, and
    TreatWarningsAsErrors promotes that to an error.

    The file is named `Directory.Build.globalconfig` rather than
    `.globalconfig` so the SDK's discovery does not add the same file twice
    (two copies make Roslyn report a duplicate-key warning for every key in
    it, and that warning is an error here).
  -->
  <ItemGroup>
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)Directory.Build.globalconfig" />
  </ItemGroup>

  <!-- NativeAOT opt-in per project; default off -->
  <PropertyGroup>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <!--
      XML doc comment warnings are noisy and not actionable in the hot loop of
      authoring interfaces — many cref references intentionally span to
      implementations living further out (e.g. ProviderRegistry.Freeze in
      Harbor.Registries) that cannot be referenced from Harbor.Abstractions
      without breaking the dependency inversion. CS1570 (malformed XML),
      CS1571 (duplicate param tag),
      CS1574 (unresolved cref), and CS0419 (ambiguous cref) are suppressed so
      documentation improvements can land incrementally without blocking the
      build.
    -->
    <NoWarn>$(NoWarn);CS1570;CS1571;CS1574;CS0419</NoWarn>

    <!--
      New Sonar rules introduced by SonarAnalyzer.CSharp 10.29 upgrade.
      Each requires per-call-site code refactoring that is out of scope for
      the package-update task; tracked as a follow-up:

        S6444 — Regex without match timeout (62 call sites across TUI renderers,
                WebFetchTool, MarkdownRenderer). Fix = pass `TimeSpan` to every
                `new Regex(...)` and `Regex.Replace(...)` call.
        S4036 — ProcessStartInfo.FileName must be an absolute path (10 sites in
                GitToolsPlugin, TscCompiler, NotificationTuiRenderer). Fix =
                resolve tool path via `PathHelper` / `Where` lookup before launch.
        S2245 — Use RandomNumberGenerator instead of System.Random (2 sites in
                Harbor.App.Blazor ViewModels.cs).
        S3267 — Simplify foreach+if into .Where() LINQ (2 sites in RipGrepTool).

      These are NoWarn'd here so the upgraded analyzers ship today; the code
      refactors land in a follow-up commit. The codes also remain disabled for
      downstream analyzer consumers (PrivateAssets=all), so the suppressions do
      not leak out of the Harbor source build.
    -->
    <NoWarn>$(NoWarn);S6444;S4036;S2245;S3267</NoWarn>
  </PropertyGroup>

  <!--
    Central Package Management (CPM):
      All package versions are pinned in Directory.Packages.props.
      Projects declare only <PackageReference Include="..." /> (no Version).
      Analyzers are pulled in here as solution-wide defaults; their versions
      are also pinned in Directory.Packages.props.

      See docs/CENTRAL_PACKAGE_MANAGEMENT.md for the full guide.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Banned API analyzer input (Microsoft.CodeAnalysis.BannedApiAnalyzers, RS0030).
    The analyzer package is referenced above, but the rules in /BannedSymbols.txt
    were dead until ROP-D Z2: (a) the file was never listed in AdditionalFiles,
    and (b) the analyzer only reads files named `BannedSymbols.txt` or
    `BannedSymbols.*.txt` — the old `BannedApi.txt` name was invisible to it.
    Every new use of a banned API now fails the build. Accepted legacy
    exemptions carry a documented reason at the call site
    (#pragma warning disable RS0030 // reason) and are catalogued by class in
    BannedSymbols.txt itself.
  -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!--
    #1844: the dynamic-code ban (#626) — /BannedSymbols.DynamicCode.txt.

    THE CONVENTION is written down in
    tests/Harbor.Architecture.Tests/ReflectionConventionRule.cs; the RULE is
    the ban file, and the compiler enforces it. Before this the same rule was a
    hand-written regex over the source text (plus a comment stripper, plus ten
    planted controls): the compiler already knows how to say "this symbol is
    banned here", and saying it in the compiler's language is both shorter and
    stricter — it matches the SYMBOL, so a type alias, a different spelling or
    a comment cannot slip past.

    THE PLUGIN EXCEPTION IS EXPRESSED BY THE TOOL, NOT BY A COMMENT
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    `src/Harbor.Plugins.*` loads code at run time because loading code at run
    time IS the plugin product. The exemption is therefore not a pragma at the
    call site and not a baseline subtracted by a scanner: the ban file is simply
    NOT ADDED to the plugin projects' AdditionalFiles, so the compiler never
    sees the rule there. The exemption is the absence of the file, which is a
    thing the tool enforces rather than a thing a reader has to believe.

    `$(MSBuildProjectName)` (not a path) is the predicate, so the check does
    not depend on how the checkout spells `/` versus `\`. The prefix lives in a
    property so it is ONE fact with ONE home: the convention's prose, this
    condition, and the architecture test that reads both.
  -->
  <PropertyGroup>
    <HarborDynamicCodeBanExemptProjectNamePrefix>Harbor.Plugins.</HarborDynamicCodeBanExemptProjectNamePrefix>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.DynamicCode.txt"
                     Condition="!$(MSBuildProjectName.StartsWith('$(HarborDynamicCodeBanExemptProjectNamePrefix)'))" />
  </ItemGroup>

  <!--
    RS0030 policy: production code (src/, apps/, contrib/tui, contrib/apps,
    samples/plugins) enforces banned-API violations as errors via the global
    TreatWarningsAsErrors above; accepted legacy exemptions live as pragmas at
    their call sites and are catalogued in BannedSymbols.txt itself.

    Test, benchmark and E2E-driver projects are exempted centrally below:
    benchmark GlobalSetup/IterationSetup, Avalonia-headless marshaling helpers
    and IPC test fixtures block on async setup by design (their lifecycles are
    synchronous), and failing CI on those would train people to ignore the
    analyzer. The rules stay visible there as diagnostics for new code review.
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('tests')) or $(MSBuildProjectDirectory.Contains('samples'))">
    <NoWarn>$(NoWarn);RS0030</NoWarn>
    <!--
      CFE0001 policy for tests: the guard's ONLY value is protecting shipped
      code paths from a ResultFailureException at runtime. In a test, that
      exception IS the failure signal — `(await store.CreateAsync(...)).Value`
      throwing means the fixture broke, which is exactly what the test should
      do. Measured on this branch: 174 CFE0001 sites, 100% of them in tests/,
      0 in src/. All 174 are the same false positive — the guard is a bare
      `Assert.That(result.IsSuccess).IsTrue()` statement, and the analyzer's
      walker only models `if`-scoped and ternary checks, so it never sees it.

      Suppressed here (same condition as RS0030, same reasoning) rather than
      with 174 call-site pragmas. Production is NOT covered by this condition:
      src/apps/contrib keep CFE0001 at full severity, so a new unguarded
      .Value there is still a build error.
    -->
    <NoWarn>$(NoWarn);CFE0001</NoWarn>
  </PropertyGroup>

  <!-- Analyzers: comprehensive static analysis (versions pinned in Directory.Packages.props) -->
  <!--
    Every analyzer package below carries `ExcludeAssets="runtime"` next to
    `<PrivateAssets>all</PrivateAssets>` (#1857, rule Proj0037). An analyzer
    package ships no runtime assembly, so listing `runtime` in IncludeAssets is
    exactly the state in which the IDE offers a type the program cannot load
    at run time. Excluding the runtime asset changes nothing for these packages
    — they have none — and it states the intent.

    ATTRIBUTE form, not a child element: Proj0037 reads the attribute
    (`reference.Element.Attribute("ExcludeAssets")`) and ignores the child
    element NuGet also accepts. NuGet reads both forms as the same item
    metadata, so the attribute is the only form that satisfies the rule.

    The IncludeAssets list itself stays: it enumerates the asset kinds an
    analyzer package contributes (analyzers, buildtransitive). Rule Proj0026
    ("remove IncludeAssets when redundant") disagrees and is switched off with
    a reason in /Directory.Build.globalconfig.
  -->
  <ItemGroup>
    <!-- Code style + quality -->
    <PackageReference Include="Roslynator.Analyzers" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Microsoft official analyzers -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Async best practices -->
    <PackageReference Include="AsyncFixer" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Reflection detection (AOT-friendliness) -->
    <PackageReference Include="ReflectionAnalyzers" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Banned API analyzer (rules in /BannedSymbols.txt, wired via AdditionalFiles above) -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Performance-focused analyzer -->
    <PackageReference Include="Meziantou.Analyzer" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      DI lifetime analyzer — DependencyInjection.Lifetime.Analyzers, which ships
      26 diagnostics (DI001–DI022, DI024–DI027; DI023 is unused). The four
      promoted to `error` are DI003 captive dependency, DI015 unresolvable
      dependency, DI017 circular dependency and DI019 scoped service resolved
      from the root provider. The per-rule severity table is .editorconfig, the
      only place the mapping is written down; this comment states the promoted
      four and defers the rest to it rather than re-listing the numbering.

      The numbering used to be mis-stated right here — "DI001 captive
      dependency ... DI003 circular dependency" — and the mismatch was not
      cosmetic. A reader told DI003 means a cycle audits the Avalonia DI graph
      for a cycle, finds none (there are none), and concludes the rule is
      satisfied; the rule that actually needed reading is the captive-dependency
      one, whose demotion went unexamined for a year (#865). A wrong id in a
      comment is worse than no comment, because it is checkable-looking.

      Solution-wide: every project that consumes
      Microsoft.Extensions.DependencyInjection gets checked. Default severity is
      warning.
    -->
    <PackageReference Include="DependencyInjection.Lifetime.Analyzers" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      CFE0001 — "check IsSuccess or IsFailure before accessing Value from
      result object". A mechanical guard for the §ROP-001 crash class: `.Value`
      on a failed Result<T> throws ResultFailureException.

      SCOPE — solution-wide, like every other analyzer above, and that is
      deliberate rather than an oversight. CFE0001 fires only where the
      analyzer can resolve a `CSharpFunctionalExtensions.Result` symbol, i.e.
      only in projects where CSharpFunctionalExtensions is referenced. Adding
      the reference per-project "only where CFE is referenced" would be
      strictly WORSE: Harbor.Abstractions references CFE *transitively*, so
      Harbor.Application, Harbor.Registries and Harbor.Tools.Builtin — the
      projects with by far the most Result<T> traffic — would carry the crash
      risk while being left unguarded. Solution-wide is what actually covers
      the sites that matter.

      ZERO-DEPENDENCY RULE — this does not violate Harbor.Abstractions'
      "no new dependencies" constraint, for two reasons. (1) It is a
      build-time-only analyzer with PrivateAssets=all: nothing flows to
      consumers, nothing is packed into the assembly, no runtime code path
      changes. (2) Harbor.Abstractions already carries build-time tooling of
      exactly this shape — ZLinq.DropInGenerator, a source generator, is
      referenced there with the same IncludeAssets/PrivateAssets pair. The
      constraint is about RUNTIME dependencies, and this is not one.

      CFE0002 is Info and disabled by default; it is deliberately left off
      (docs/ROP-API-INVENTORY.md §5 — low value, Harbor's Result.Failure<T>
      sites are mostly not in an inferable position).
    -->
    <PackageReference Include="CSharpFunctionalExtensions.Analyzers" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Project-file analyzer (#1857) — 190+ rules over the MSBuild project files
      rather than over C#. Only three of them are adopted (Proj0037,
      Proj0040, Proj0041) and they are errors; the rest are off with a written
      reason, family by family, in /Directory.Build.globalconfig.

      The severity table cannot live in .editorconfig: a diagnostic reported on
      a project file reaches the compiler as an ADDITIONAL FILE, and Roslyn
      applies syntax-tree level editor config only to diagnostics that have a
      source tree. A global analyzer config is the only per-rule mechanism that
      reaches them, which is why /Directory.Build.globalconfig exists, and it
      is wired to the compiler by hand in this file (see the EditorConfigFiles
      item above) because the SDK's own discovery of a `.globalconfig` walks up
      from the compiled sources and misses every project that compiles none.
    -->
    <PackageReference Include="DotNetProjectFile.Analyzers" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Release architecture gate (compile-time, not runtime):
      `dotnet build Harbor.slnx -c Release` re-runs the Harbor.Architecture.Tests
      suite (47 layer rules) against the freshly built assemblies as part of the
      build itself. Any layering regression fails the build on CI immediately —
      no PR review or separate test step needed. Works together with the
      BannedApiAnalyzers gate above (banned symbol ⇒ RS0030 build error).

      Scope: runs once, after tests/Harbor.Architecture.Tests is built (its
      ProjectReferences are already fresh by then). Skipped for design-time /
      IDE builds. A test-platform direct run with a no-build flag (no Build
      target) never triggers it. Escape hatch: property HarborArchGate=false.
  -->
  <PropertyGroup>
    <HarborArchGate Condition="'$(HarborArchGate)' == ''">true</HarborArchGate>
  </PropertyGroup>

  <!--
    The Condition below is ONE line on purpose. An attribute value that spans
    several lines crashes the project-file analyzer (#1857) with
    `AD0001: ... 'end' must not be less than 'start'`: the analyzer looks for
    the closing quote on the attribute's first line only, and a value that
    continues on the next line leaves it with an end position of (0,0).
    MSBuild has no way to express several conditions on one attribute without
    a multi-line value, so the conjunction is one long line.
  -->
  <Target Name="HarborArchitectureGate"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(HarborArchGate)' == 'true' AND '$(MSBuildProjectName)' == 'Harbor.Architecture.Tests' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingInsideVisualStudio)' != 'true'">
    <!-- Evaluated HERE, at execution time: at Directory.Build.props import
         time $(IntermediateOutputPath) is still empty, which used to scatter
         the gate log into the project dir instead of obj/. -->
    <PropertyGroup>
      <HarborArchGateLog>$(IntermediateOutputPath)harbor-arch-gate.log</HarborArchGateLog>
    </PropertyGroup>
    <Message Importance="high" Text="[arch-gate] Harbor architecture tests: $(TargetFileName)" />
    <!--
      ConsoleToMSBuild="true": MSBuild captures and writes the output itself, so
      the log file is produced by the task rather than by shell redirection. The
      previous form redirected with `> log` and then ran `tail -30` on failure to
      surface diagnostics - but `tail` does not exist on Windows, so the
      test-os (windows-latest) job failed with exit code 9009 ("command not
      found") the moment the gate ran there. The gate is OS-agnostic now and the
      failure diagnostics still reach the build log.
    -->
    <Exec Command="dotnet exec &quot;$(TargetPath)&quot;"
          IgnoreExitCode="false"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="HarborArchGateExitCode" />
    </Exec>
    <ReadLinesFromFile File="$(HarborArchGateLog)"
                      Condition="'$(HarborArchGateExitCode)' != '0' AND Exists('$(HarborArchGateLog)')">
      <Output TaskParameter="Lines" ItemName="HarborArchGateLogLines" />
    </ReadLinesFromFile>
    <Error Condition="'$(HarborArchGateExitCode)' != '0'"
           Text="Harbor architecture tests failed (exit code $(HarborArchGateExitCode)). Full log: $(HarborArchGateLog)%0A%0A@(HarborArchGateLogLines)" />
  </Target>

</Project>
