<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Tui.Spectre.Fullscreen</PackageId>
    <Description>Harbor full-screen TUI renderer using Spectre.Console — live layout, panels, inline input.</Description>
    <PackageTags>harbor;tui;spectre;fullscreen</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harbor.Tui.Contrib.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\..\..\src\Harbor.Terminal.Abstractions\Harbor.Terminal.Abstractions.csproj"/>
    <!-- #462: SlashCommandCatalog — the single slash-command registry the CLI
         dispatcher binds handlers to. LayoutBuilder and FullscreenTuiRenderer
         derive their hint/autocomplete lists from it instead of hardcoding a
         copy that drifted. Presentation → Domain edge, rule-conforming. -->
    <ProjectReference Include="..\..\..\src\Harbor.Ui.Framework.Abstractions\Harbor.Ui.Framework.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
