<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Tui.NickConsoleEx — a CONTRIBUTED (unbuilt-by-CI) TUI backend over the
    vendored nickprotop/ConsoleEx submodule (SharpConsoleUI).

    It is NOT part of Harbor.slnx and NOT part of contrib/Contrib.slnx: the
    vendored submodule it needs is not checked out by CI, and the whole point
    of the move is that the product does not compile SharpConsoleUI.

    To build it, see README.md in this folder.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Tui.NickConsoleEx</PackageId>
    <Description>Harbor TUI — wrapper backend over nickprotop/ConsoleEx (SharpConsoleUI): an ITuiRenderer adapter that hosts a Harbor chat window on SharpConsoleUI's window system. ADDITIVE backend — does not replace Harbor.Tui.CellForge.</Description>
    <PackageTags>harbor;tui;sharpconsoleui;wrapper</PackageTags>
    <!--
      SharpConsoleUI (vendored submodule contrib/external/ConsoleEx) declares
      Spectre.Console >= 0.55.0; contrib/external/Directory.Build.targets
      retargets that edge to the Harbor root pin 0.54.0 (RazorConsole compat),
      so the normal root CPM + transitive pinning apply unmodified here.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      The vendored tree. Its boundary props live in contrib/external/ so the
      root Directory.Build.props (CPM, TreatWarningsAsErrors, the reflection
      ban) does NOT leak into third-party source.
    -->
    <ProjectReference Include="..\..\external\ConsoleEx\SharpConsoleUI\SharpConsoleUI.csproj"/>
    <!--
      src/ is three levels up from contrib/tui/Harbor.Tui.NickConsoleEx/.
      The contrib -> src direction is allowed (the reverse is what the
      architecture guard forbids): see tests/Harbor.Architecture.Tests/
      ContribIsolationRules.cs.
    -->
    <ProjectReference Include="..\..\..\src\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\..\..\src\Harbor.Terminal.Abstractions\Harbor.Terminal.Abstractions.csproj"/>
    <ProjectReference Include="..\..\..\src\Harbor.CodeGen\Harbor.CodeGen.csproj">
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
