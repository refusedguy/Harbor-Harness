<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Scripting.Bridge — the `Harbor` global object exposed to scripts.

    Types:
      - ScriptTool              (ITool wrapper around a script function)
      - ScriptBridgeExtensions  (fluent setup helpers for ScriptGlobals)

    Note: ScriptGlobals itself lives in Harbor.Scripting.Abstractions
    because IScriptEngine.Evaluate takes it as a parameter — keeping it in
    Abstractions avoids a circular dep (Engines → Abstractions + Bridge).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Scripting.Bridge</PackageId>
    <Description>Harbor script bridge — ScriptTool (ITool wrapper) and ScriptGlobals fluent extensions.</Description>
    <PackageTags>harbor;scripting;bridge;harbor-global;tool-wrapper</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Scripting.Abstractions\Harbor.Scripting.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CSharpFunctionalExtensions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
