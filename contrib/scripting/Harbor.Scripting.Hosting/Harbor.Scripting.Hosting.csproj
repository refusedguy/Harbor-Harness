<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Scripting.Hosting — composition root for the scripting pipeline.

    Public types:
      - ScriptHost         (composes IScriptEngine + IScriptStore + IScriptCompiler
                            into a load/evaluate pipeline)
      - ScriptHostOptions  (ContinueOnFailure, etc.)
      - ScriptInstance     (a loaded script with evaluation metadata)

    Depends on all 5 sibling scripting layers + Abstractions.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Scripting.Hosting</PackageId>
    <Description>Harbor script host — orchestrates storage → compilation → engines pipeline.</Description>
    <PackageTags>harbor;scripting;hosting;orchestrator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Scripting.Abstractions\Harbor.Scripting.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Scripting.Storage\Harbor.Scripting.Storage.csproj"/>
    <ProjectReference Include="..\Harbor.Scripting.Compilation\Harbor.Scripting.Compilation.csproj"/>
    <ProjectReference Include="..\Harbor.Scripting.Engines\Harbor.Scripting.Engines.csproj"/>
    <ProjectReference Include="..\Harbor.Scripting.Bridge\Harbor.Scripting.Bridge.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
