<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.E2E.Tui.SpectreTui - end-to-end tests for the Spectre.Tui-based
    interactive TUI renderer. Spawns `dotnet exec Harbor.App.Cli.dll` inside
    a pseudo-terminal (via TuiDriver + `script -qfc`) with HARBOR_TUI=spectre-tui,
    drives it with keystrokes, and asserts on the ANSI-stripped screen buffer.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707;S3267;S2365;S2445;S6618;TUnit0055</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\tests\Harbor.E2E.Framework\Harbor.E2E.Framework.csproj"/>
    <ProjectReference Include="..\..\..\apps\Harbor.App.Cli\Harbor.App.Cli.csproj"/>
  </ItemGroup>

</Project>
