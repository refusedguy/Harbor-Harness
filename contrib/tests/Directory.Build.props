<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    contrib/tests/Directory.Build.props — mirrors tests/Directory.Build.props
    for test projects that moved into contrib/ (sprint 2). Imports the repo-root
    Directory.Build.props so central package management and analyzer settings
    keep applying.
  -->
  <!--
    THE ANALYZER SCOPE OF THIS TREE (issue #1801) — the same as tests/: only
    Sonar is turned on here. contrib/ mirrors the product, and the gate over
    the scope (tools/check-analyzer-scope.py) holds the copies of a tree to
    the same value. BEFORE the import: the root file evaluates every analyzer
    PackageReference's Condition while it is read, so a property set after
    the import would come too late.
  -->
  <PropertyGroup>
    <HarborAnalyzerSonar>on</HarborAnalyzerSonar>
  </PropertyGroup>

  <!--
    The solution-wide Directory.Build.props is imported by RELATIVE path, not by
    the GetPathOfFileAbove function. MSBuild evaluates both to the same file
    (this directory's parent's parent), but the project-file analyzer (#1857)
    can only follow an import it can resolve on disk, and a property function
    is not resolvable to it: with the function form the analyzer never sees
    the solution-wide props, so the properties pinned there (NuGetAuditMode,
    NuGetAuditLevel) look unset and the rules that read them fire. Same shape
    as tests/Directory.Build.props and contrib/apps/Directory.Build.props.
  -->
  <Import Project="../../Directory.Build.props"/>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1861;S5445;S3011</NoWarn>
  </PropertyGroup>

</Project>
