@* StatusBar - bottom strip showing current status + token/cost counts.
   Reads from UiStore and uses the platform-agnostic StatusMappers helpers
   so the label / brush-key format stays identical across Blazor, Avalonia,
   WPF, MAUI, and the TUI renderers. *@
@inject UiStore Store
@using Harbor.Ui.Framework.Converters
@implements IDisposable

<div class="statusbar">
    <div class="status-section">
        <span class="@("status-dot status-" + StatusMappers.StatusToBrushKey(Store.State.Status).ToLowerInvariant())">
            @StatusMappers.StatusToBrushKey(Store.State.Status)
        </span>
        <span>@Store.State.Status</span>
    </div>
    <div class="status-section">
        <span class="status-pill">in: @StatusMappers.TokensToCompact(Store.State.Cost.TokensIn)</span>
        <span class="status-pill">out: @StatusMappers.TokensToCompact(Store.State.Cost.TokensOut)</span>
        <span class="status-pill">@StatusMappers.CostToUsd(Store.State.Cost.CostUsd)</span>
    </div>
</div>

@code {
protected override void OnInitialized()
{
    Store.Changed += OnChanged;
}

private async void OnChanged(object? _, UiStateChangedEventArgs __)
{
    await InvokeAsync(StateHasChanged).ConfigureAwait(false);
}

public void Dispose()
{
    Store.Changed -= OnChanged;
}
}
