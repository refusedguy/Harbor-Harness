<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    contrib/apps/Directory.Build.props — composition-root-specific analyzers.

    Every project under apps/ is a Harbor composition root (Cli, Avalonia in main; Wpf,
    Blazor, Maui in contrib). These are the only projects that wire up the DI container,
    so they are the only projects that need Excubo's [Exposes] validation.

    The DI lifetime analyzer (DependencyInjection.Lifetime.Analyzers) is added
    solution-wide in /Directory.Build.props because captive dependency and
    lifetime mismatch detection is valuable everywhere (libraries can declare
    Singleton types too).

    Excubo.Analyzers.Annotations provides the [Exposes(typeof(T))] attribute.
    Excubo.Analyzers.DependencyInjectionValidation is the analyzer that enforces it.
  -->

  <!--
    THE ANALYZER SCOPE OF THIS TREE (issue #1801) — the same four families
    as apps/, for the same reasons. contrib/ mirrors the product, and the
    gate over the scope (tools/check-analyzer-scope.py) holds the copies of
    a tree to the same value. BEFORE the import: the root file evaluates
    every analyzer PackageReference's Condition while it is read, so a
    property set after the import would come too late.
  -->
  <PropertyGroup>
    <HarborAnalyzerAsyncFixer>on</HarborAnalyzerAsyncFixer>
    <HarborAnalyzerBannedApi>on</HarborAnalyzerBannedApi>
    <HarborAnalyzerDiLifetime>on</HarborAnalyzerDiLifetime>
    <HarborAnalyzerCfe>on</HarborAnalyzerCfe>
  </PropertyGroup>

  <!--
    Imported by RELATIVE path, not by the GetPathOfFileAbove function: MSBuild
    evaluates both to the same file (this directory's parent), but the
    project-file analyzer (#1857) can only follow an import it can resolve on
    disk, and a property function is not resolvable to it. With the function
    form the analyzer never sees the solution-wide props.
  -->
  <Import Project="../../Directory.Build.props"/>

  <ItemGroup>
    <!-- Annotation attribute (compile-time only) — needed so composition roots
         can put [Exposes(typeof(IAgent))] on their BuildHost methods. -->
    <PackageReference Include="Excubo.Analyzers.Annotations" ExcludeAssets="runtime">
      <IncludeAssets>compile; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Analyzer that validates [Exposes] declarations against actual
         services.AddXxx<T>() registrations in the method body. -->
    <PackageReference Include="Excubo.Analyzers.DependencyInjectionValidation" ExcludeAssets="runtime" Condition="'$(HarborAnalyzerExcubo)' != 'off'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
