<UserControl x:Class="Harbor.App.Wpf.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Harbor.App.Wpf.ViewModels"
             Background="{DynamicResource App.Background}">
    <DockPanel Margin="6">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource App.Surface}"
                Padding="6,4" Margin="0,0,0,6" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Diff: " Foreground="{DynamicResource App.TextMuted}" />
                    <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource App.Text}" />
                    <TextBlock Text=" · " Foreground="{DynamicResource App.TextMuted}" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource App.Accent}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Refresh" Padding="10,4" Margin="0,0,4,0"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="Accept" Padding="10,4" Margin="0,0,4,0"
                            Background="{DynamicResource App.Success}" Foreground="Black"
                            Command="{Binding AcceptAllCommand}" />
                    <Button Content="Reject" Padding="10,4"
                            Background="{DynamicResource App.Error}" Foreground="White"
                            Command="{Binding RejectAllCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Side-by-side diff -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Hunks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiffHunkViewModel}">
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding Header}"
                                       FontFamily="JetBrains Mono, Consolas, monospace"
                                       FontSize="11"
                                       Foreground="{DynamicResource App.AccentSecondary}" />
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DiffLineViewModel}">
                                        <Border Background="{Binding LineBackground}"
                                                Padding="6,1">
                                            <TextBlock Text="{Binding Text}"
                                                       FontFamily="JetBrains Mono, Consolas, monospace"
                                                       FontSize="12"
                                                       Foreground="{Binding LineForeground}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
