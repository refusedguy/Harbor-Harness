<UserControl x:Class="Harbor.App.Wpf.Controls.ChatBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Harbor.App.Wpf.Converters">
    <!--
        ChatBubble — reusable WPF chat row component.

        Mirrors the Avalonia Harbor.App.Avalonia.Views.Components.ChatBubble
        control. Bindable properties:
          - RoleLabel  (string) — short lowercase role label
          - Text       (string) — message body
          - BrushKey   (string) — resource key for the role accent color
          - Timestamp  (string?) — optional, hidden when null/empty
          - IsCompact  (bool)   — tighter padding for tool/system lines

        The role pill's accent color and the message text color are both
        driven by BrushKey (resolved by BrushKeyConverter at bind time).
    -->
    <UserControl.Resources>
        <conv:BrushKeyConverter x:Key="BrushKey" />
    </UserControl.Resources>
    <Grid Margin="0,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Role pill -->
        <Border Grid.Column="0"
                Background="{DynamicResource App.Surface}"
                CornerRadius="6"
                Padding="8,3"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                BorderBrush="{Binding BrushKey, Converter={StaticResource BrushKey}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderThickness="2,0,0,0">
            <TextBlock Text="{Binding RoleLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontFamily="Consolas"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{Binding BrushKey, Converter={StaticResource BrushKey}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>

        <!-- Message body -->
        <Border Grid.Column="1"
                Background="{DynamicResource App.Mantle}"
                CornerRadius="8"
                Padding="14,10"
                Margin="10,0,0,0"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="{Binding BrushKey, Converter={StaticResource BrushKey}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Text="{Binding Timestamp, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="10"
                           FontFamily="Consolas"
                           HorizontalAlignment="Right"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource App.TextMuted}"
                           Visibility="{Binding Timestamp, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
