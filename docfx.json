{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/Harbor.Abstractions/Harbor.Abstractions.csproj"]
        },
        {
          "files": ["src/Harbor.Abstractions.Contracts/Harbor.Abstractions.Contracts.csproj"]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["README.md"]
      },
      {
        "files": ["docs/**/*.md", "docs/toc.yml"]
      },
      {
        "files": ["src/**/README.md"]
      },
      {
        "files": ["api/*.md"]
      }
    ],
    "resource": [],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "Harbor"
    },
    "template": ["default"],
    "markdownEngineName": "markdig"
  }
}
