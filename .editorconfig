# .editorconfig — Harbor .NET project
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,json5,yaml,yml,xml,csproj,props,targets}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[*.{cs,csx}]
# .NET code style settings
# https://learn.microsoft.com/dotnet/fundamentals/code-analysis/code-style-rule-options

# Naming conventions
dotnet_naming_rule.private_fields.severity = suggestion
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = camel_case_underscore
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_underscore.required_prefix = _
dotnet_naming_style.camel_case_underscore.capitalization = camel_case

# this. qualification
dotnet_style_qualification_for_field = true:suggestion
dotnet_style_qualification_for_property = true:suggestion
dotnet_style_qualification_for_method = true:suggestion
dotnet_style_qualification_for_event = true:suggestion

# Language keywords vs BCL types
dotnet_style_predefined_type_for_member_parameters = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion

# Modifiers
dotnet_style_require_accessibility_modifiers = always:suggestion
dotnet_style_readonly_field = true:suggestion

# Parentheses preferences
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:silent

# Expression-level preferences
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_explicit_tuple_names = true:suggestion
dotnet_style_prefer_inferred_tuple_names = true:suggestion
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_simplified_interpolation = true:suggestion
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion

# Null-checking preferences
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# C# preferences
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_indexers = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_operators = when_on_single_line:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_local_functions = when_on_single_line:silent

# Pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:silent
csharp_style_prefer_not_pattern = true:suggestion

# Expression-level
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_style_unused_value_assignment_preference = discard_variable:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:silent
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

# File scoped namespaces
csharp_style_namespace_declarations = file_scoped:suggestion

# Using directives
csharp_using_directive_placement = outside_namespace:suggestion

# Collection expressions (C# 12+)
csharp_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Newline settings
csharp_new_lines_before_braces = all
csharp_new_lines_before_else = true
csharp_new_lines_before_catch = true
csharp_new_lines_before_finally = true
csharp_new_lines_before_members_in_object_initializers = true
csharp_new_lines_before_members_in_anonymous_types = true
csharp_new_lines_between_query_expression_clauses = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents_when_block = false

# Spacing
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_around_declaration_statements = do_not_ignore

# Wrapping
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# ============================================================================
# ANALYZER SEVERITIES
# ============================================================================

# --- Naming ---
dotnet_diagnostic.CA1707.severity = none # we use underscores in tests
dotnet_diagnostic.CA1708.severity = suggestion

# --- Async ---
dotnet_diagnostic.CA2007.severity = suggestion # ConfigureAwait
dotnet_diagnostic.CA2008.severity = suggestion # don't create tasks without TaskScheduler
dotnet_diagnostic.CA2012.severity = error # ValueTask correct usage
dotnet_diagnostic.CA2247.severity = error # TaskCT args

# --- Performance ---
dotnet_diagnostic.CA1825.severity = error # empty array allocation
dotnet_diagnostic.CA1827.severity = suggestion # Any instead of Count
dotnet_diagnostic.CA1828.severity = suggestion # CountAsync instead of Count
dotnet_diagnostic.CA1829.severity = suggestion # Length instead of Count
dotnet_diagnostic.CA1830.severity = suggestion # strongly-typed enum methods
dotnet_diagnostic.CA1834.severity = suggestion # StringBuilder.Append(char)
dotnet_diagnostic.CA1835.severity = suggestion # ReadAsync(Memory<byte>)
dotnet_diagnostic.CA1836.severity = suggestion # IsEmpty instead of Count == 0
dotnet_diagnostic.CA1837.severity = suggestion # Environment.ProcessId
dotnet_diagnostic.CA1838.severity = suggestion # avoid StringBuilder.Append(char) for single chars
dotnet_diagnostic.CA1841.severity = suggestion # Dictionary.Contains(Key)
dotnet_diagnostic.CA1842.severity = suggestion # DoNotUseSkipWithAny
dotnet_diagnostic.CA1845.severity = suggestion # span-based string methods
dotnet_diagnostic.CA1846.severity = suggestion # AsSpan instead of substring
dotnet_diagnostic.CA1847.severity = suggestion # Math.Clamp
dotnet_diagnostic.CA1852.severity = suggestion # seal internal types
dotnet_diagnostic.CA1854.severity = suggestion # TryGetValue instead of ContainsKey + indexer
dotnet_diagnostic.CA1855.severity = suggestion # UseSpanClearInsteadOfFill
dotnet_diagnostic.CA1856.severity = suggestion # ConstantExpected
dotnet_diagnostic.CA1859.severity = suggestion # use concrete types for perf
dotnet_diagnostic.CA1860.severity = suggestion # avoid LINQ Any for empty check
dotnet_diagnostic.CA1861.severity = none # params arrays (we use them in tests)
dotnet_diagnostic.CA1862.severity = suggestion # StringComparison
dotnet_diagnostic.CA1863.severity = suggestion # CompositeFormat
dotnet_diagnostic.CA1864.severity = suggestion # use niche
dotnet_diagnostic.CA1865.severity = suggestion # char-based methods
dotnet_diagnostic.CA1866.severity = suggestion # char-based methods
dotnet_diagnostic.CA1867.severity = suggestion # StringComparison
dotnet_diagnostic.CA1868.severity = suggestion # guard clauses
dotnet_diagnostic.CA1869.severity = suggestion # cache static regex
dotnet_diagnostic.CA1870.severity = suggestion # coerce to concrete type
dotnet_diagnostic.CA1871.severity = none # DoNotPassNullableStructToArgumentNullExceptionThrowIfNull
dotnet_diagnostic.CA1872.severity = suggestion # Use ArrayEmpty

# --- Sonar ---
dotnet_diagnostic.SA1101.severity = none # prefix local calls with this
dotnet_diagnostic.S1694.severity = none # abstract record for discriminated unions is OK
dotnet_diagnostic.S101.severity = none # allow LlmEvent-style acronyms in PascalCase
dotnet_diagnostic.S3237.severity = none # value appenders
dotnet_diagnostic.S4136.severity = none # method overloads adjacent (ergonomics > rule)
dotnet_diagnostic.S1144.severity = none # unused private fields (often intentional scaffolding)
dotnet_diagnostic.S2325.severity = none # make static (sometimes breaks DI)
dotnet_diagnostic.S3242.severity = none # use more general type
dotnet_diagnostic.S4487.severity = none # unread private field (DI often requires them)
dotnet_diagnostic.S2933.severity = none # make readonly (sometimes reassigned by design)
dotnet_diagnostic.S1450.severity = none # remove unused private field (DI)
dotnet_diagnostic.S1066.severity = none # merge if statements (readability)
dotnet_diagnostic.S3358.severity = none # nested ternary (sometimes clear)
dotnet_diagnostic.S1172.severity = none # unused parameter (interface compliance)
dotnet_diagnostic.CA2024.severity = none # reader.EndOfStream async (we use ReadLineAsync)
dotnet_diagnostic.S6966.severity = none # await Console.WriteLineAsync (we use sync Console)
dotnet_diagnostic.S6608.severity = none # indexing at 0 vs First()
dotnet_diagnostic.S5445.severity = none # GetTempFileName in tests
dotnet_diagnostic.S3011.severity = none # reflection in tests
dotnet_diagnostic.S1075.severity = none # hardcoded absolute paths (defaults)
dotnet_diagnostic.S6580.severity = none # format provider in date parsing
dotnet_diagnostic.S1481.severity = none # unused local var (sometimes helpful)
dotnet_diagnostic.S1135.severity = none # TODO comments (we use them intentionally)
dotnet_diagnostic.S3881.severity = none # IDisposable pattern (we use simple Dispose)
dotnet_diagnostic.MA0008.severity = none # StructLayout on structs (not always needed)
dotnet_diagnostic.S4144.severity = none # identical method implementations (sometimes intentional)
dotnet_diagnostic.S3427.severity = suggestion # constructor signature overlap (intentional for MemoryPack dual-ctor pattern)

