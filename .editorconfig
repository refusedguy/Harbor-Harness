# --- Reflection (ReflectionAnalyzers 0.3.1) ---
# 46 rules, REFL001-REFL046. The two lines that used to sit here configured
# REL0001 and REL0002 — ids that do not exist in the package (read out of
# analyzers/dotnet/cs/ReflectionAnalyzers.dll in the 0.3.1 nupkg), so they
# configured nothing at all. All 46 real rules ship enabled by default: 45 as
# `warning`, REFL007 as `hidden`. Until this block they ran at those
# defaults, unconfigured and unrecorded.
#
# WHAT THE PACKAGE IS: 46 member-by-member rules for System.Reflection —
# binding flags, overloads, `nameof`, generic type arguments, `InvokeMember`
# targets. It is NOT a dynamic-code rule: the shipped analyzer carries no rule
# for `Assembly.Load`, `AssemblyLoadContext`, `Reflection.Emit`, `TypeBuilder`
# or `DynamicMethod` (the DLL's user-string heap holds no such string; the one
# `Reflection.Emit` name in it, `System.Reflection.Emit.AssemblyBuilder`, is
# an entry of REFL037's type-existence table). The dynamic-code ban in src/ +
# apps/ is the compiler's: RS0030 over BannedSymbols.DynamicCode.txt.
#
# TWO SEVERITIES, AND THE LINE BETWEEN THEM:
#   * `warning` — the rule reports a reflective call that cannot work as
#     written: the member does not exist, the types do not match, the
#     delegate has the wrong signature. In src/ and apps/ `warning` is
#     promoted to an error by TreatWarningsAsErrors=true, which is where a
#     broken reflective call is a real defect. Measured on a green CI build of
#     dev (86b52adc, #1905): 41 findings, every one of them under tests/,
#     none under src/ or apps/.
#   * `suggestion` — the rule asks for a different spelling, not a different
#     behaviour (use `nameof`, name the binding flags, use `typeof`). Visible
#     in the IDE, never promoted, and 33 of the 41 findings.
#
# The four `warning` rules that DO have findings in tests/ are demoted there
# by the path-scoped block at the end of this file, one row each with its own
# reason; they are not defects, and a defect deserves a `warning`.
#
# --- Reflection: correctness (warning) ---
dotnet_diagnostic.REFL001.severity = warning # the cast target is not the member's return type, so the cast throws at run time
dotnet_diagnostic.REFL002.severity = warning # the invoked method returns void, so the captured result is always null
dotnet_diagnostic.REFL003.severity = warning # the member does not exist on a sealed, static or interface type, so the lookup can never succeed
dotnet_diagnostic.REFL004.severity = warning # more than one member matches the filter, so the lookup is ambiguous
dotnet_diagnostic.REFL005.severity = warning # the binding flags match no member at all, so the lookup returns null
dotnet_diagnostic.REFL009.severity = warning # the referenced member is not known to exist, and the result is not null-checked
dotnet_diagnostic.REFL011.severity = warning # a duplicated BindingFlag is a copy-paste slip in the flag expression
dotnet_diagnostic.REFL013.severity = warning # the member exists but is of another kind, so the cast below it throws
dotnet_diagnostic.REFL015.severity = warning # the member lives on the containing type, so the lookup on this type misses it
dotnet_diagnostic.REFL017.severity = warning # nameof names a different member than the one the lookup asks for
dotnet_diagnostic.REFL018.severity = warning # an explicitly implemented member is not found by name, so the lookup misses it
dotnet_diagnostic.REFL019.severity = warning # no member matches the given types, so the lookup returns null
dotnet_diagnostic.REFL020.severity = warning # more than one interface matches the name, so the lookup is ambiguous
dotnet_diagnostic.REFL021.severity = warning # the named type does not exist, so the lookup returns null (the package ships no documentation page for this id)
dotnet_diagnostic.REFL023.severity = warning # the type does not implement the interface, so the cast below it throws
dotnet_diagnostic.REFL025.severity = warning # the arguments do not match the member's parameters, so the call throws
dotnet_diagnostic.REFL026.severity = warning # the object has no parameterless constructor, so Activator.CreateInstance throws
dotnet_diagnostic.REFL028.severity = warning # the cast target is not the member's return type, so the cast throws at run time
dotnet_diagnostic.REFL030.severity = warning # the obj argument is not of the type the member expects, so the call throws
dotnet_diagnostic.REFL031.severity = warning # the generic arguments do not satisfy the type parameters, so the call throws
dotnet_diagnostic.REFL032.severity = warning # the named dependency does not exist, so the attribute's target is missing
dotnet_diagnostic.REFL033.severity = warning # the argument type differs from the parameter type, so no member matches
dotnet_diagnostic.REFL034.severity = warning # MakeGeneric on a type that is not a generic definition throws at run time
dotnet_diagnostic.REFL035.severity = warning # Invoke on a generic definition throws at run time
dotnet_diagnostic.REFL036.severity = warning # CreateInstance returns null when it cannot construct, and the result is not checked
dotnet_diagnostic.REFL037.severity = warning # the named type does not exist, so the lookup returns null
dotnet_diagnostic.REFL041.severity = warning # the delegate's signature does not match the target, so CreateDelegate throws
dotnet_diagnostic.REFL042.severity = warning # the first argument must be a reference type, so the call throws
dotnet_diagnostic.REFL043.severity = warning # the first argument's type does not match the member's, so the call throws
dotnet_diagnostic.REFL044.severity = warning # the attribute is read with the wrong attribute type, so the check reads nothing
dotnet_diagnostic.REFL045.severity = warning # the flags match no member, so the lookup returns null
dotnet_diagnostic.REFL046.severity = warning # the default member does not exist, so InvokeMember throws

# --- Reflection: spelling (suggestion) ---
dotnet_diagnostic.REFL006.severity = suggestion # the binding flags are wider than they need to be; the same members match
dotnet_diagnostic.REFL007.severity = suggestion # the flags are written in an unusual order; the same set is produced (ships hidden)
dotnet_diagnostic.REFL008.severity = suggestion # name the binding flags explicitly; the loose overload is slower and more fragile
dotnet_diagnostic.REFL010.severity = suggestion # the generic GetCustomAttribute<T> states the attribute type in the source
dotnet_diagnostic.REFL012.severity = suggestion # Attribute.IsDefined() answers the same question in one call
dotnet_diagnostic.REFL014.severity = suggestion # GetMember().AccessorMethod reads the accessor without a second lookup
dotnet_diagnostic.REFL016.severity = suggestion # nameof keeps the member name in step with a rename
dotnet_diagnostic.REFL022.severity = suggestion # the fully qualified name survives a using-directive change
dotnet_diagnostic.REFL024.severity = suggestion # null says "no types" without allocating an empty array
dotnet_diagnostic.REFL027.severity = suggestion # Type.EmptyTypes is the shared empty array
dotnet_diagnostic.REFL029.severity = suggestion # naming the types keeps the lookup stable when an overload is added
dotnet_diagnostic.REFL038.severity = suggestion # RunClassConstructor runs the static constructor exactly once
dotnet_diagnostic.REFL039.severity = suggestion # typeof(T) is the type, without the instance lookup
dotnet_diagnostic.REFL040.severity = suggestion # IsInstanceOfType answers the same question without a cast

# --- vs-threading (Microsoft.VisualStudio.Threading.Analyzers 18.12.1) ---
#
# THE PACKAGE IS NOT REFERENCED ANY MORE (#2109). These rows are INERT
# today: nothing loads the analyzer, so none of these severities is read.
# They are kept because they are the table that would apply if the package
# came back, and because a bare re-reference WITHOUT them would turn the
# tree red: four of the package's rules are Error by default. The version
# this repository last measured is 18.12.1.
#
# The package shipped 29 rules: VSTHRD001-004, VSTHRD010-013, VSTHRD100-117,
# VSTHRD200-202 (VSTHRD201 included; the upstream index documents 28 of them).
# It was wired to src/ + apps/ only — tests/ has its own async culture and
# already lifts TreatWarningsAsErrors.
#
# EXACTLY ONE RULE WAS ON. VSTHRD110 ("Observe result of async calls") is the
# one this repository asked for, and it sat at `suggestion`: it is a guard on
# the future, not a fix of a present defect, and `suggestion` is not promoted
# by TreatWarningsAsErrors. The two sites it would have flagged are fixed in
# #1852.
#
# EVERY OTHER RULE IS `none`, with a reason, because the package's defaults
# are NOT this repository's defaults: four of its rules are Error by default
# (VSTHRD004, VSTHRD011, VSTHRD107, VSTHRD109) and would turn existing code
# into a red build on the day the package is added, and a large part of the
# family is written against JoinableTaskFactory — a library Harbor does not
# reference and does not want to.
#
# WHY IT WAS REMOVED, IN ONE LINE: the family cost 103.7 analyzer-seconds on
# the whole build (run 39527271843, `-p:ReportAnalyzer=true`), and 85.8 of
# those seconds — 83 % — were VSTHRD010, the rule this very table silences.
# A rule at `severity = none` is silenced; the analyzer that implements it
# still runs over every compilation. The gate that decides "is this an
# unobserved Task?" is HARCH003 (a house analyzer that resolves the TYPE,
# #1852), and it is a Warning, so it fails the build where VSTHRD110 only
# suggested.
dotnet_diagnostic.VSTHRD001.severity = none # legacy thread switching; the package's own AdditionalFiles list SynchronizationContext.Post/Send, which the UI shells use
dotnet_diagnostic.VSTHRD002.severity = none # synchronous waits; Harbor's sync-over-async policy is a source rule of its own (BackgroundTaskSyncResultRule, ToolDispatcherSyncResultRule)
dotnet_diagnostic.VSTHRD003.severity = none # "awaiting foreign Tasks" is every await in the product
dotnet_diagnostic.VSTHRD004.severity = none # Error by default; JoinableTaskFactory
dotnet_diagnostic.VSTHRD010.severity = none # main-thread member list; Harbor's thread affinity is Avalonia's dispatcher
dotnet_diagnostic.VSTHRD011.severity = none # Error by default; AsyncLazy<T> is a JoinableTaskFactory type
dotnet_diagnostic.VSTHRD012.severity = none # "provide a JoinableTaskFactory where allowed"; Harbor has none
dotnet_diagnostic.VSTHRD013.severity = none # CompletedTaskAttribute is a JoinableTaskFactory type
dotnet_diagnostic.VSTHRD100.severity = none # async void; the four Avalonia event handlers are blessed by docs/ANTIPATTERNS.md §13
dotnet_diagnostic.VSTHRD101.severity = none # "unsupported async delegates" is the JoinableTaskFactory event list
dotnet_diagnostic.VSTHRD102.severity = none # "implement internal logic asynchronously"; a design guideline against a deliberate sync effect-host contract
dotnet_diagnostic.VSTHRD103.severity = none # duplicates CS4014, which the compiler already reports as an error here
dotnet_diagnostic.VSTHRD104.severity = none # "offer an async option"; a design guideline over public surfaces
dotnet_diagnostic.VSTHRD105.severity = none # TaskScheduler.Current overloads are the JoinableTaskFactory ones
dotnet_diagnostic.VSTHRD106.severity = none # InvokeAsync for async events; Harbor's events go through IEventBus
dotnet_diagnostic.VSTHRD107.severity = none # Error by default; its advice is about `using`, not `await using`
dotnet_diagnostic.VSTHRD108.severity = none # thread-affinity assertion; JoinableTaskFactory
dotnet_diagnostic.VSTHRD109.severity = none # Error by default; JoinableTaskFactory
dotnet_diagnostic.VSTHRD110.severity = suggestion # observe the result of async calls — the one rule this repository asks for
dotnet_diagnostic.VSTHRD111.severity = none # ConfigureAwait(bool); the house rule is to always ConfigureAwait(false) in library code, which is not per-call-site checkable
dotnet_diagnostic.VSTHRD112.severity = none # "implement IAsyncDisposable"; a design guideline
dotnet_diagnostic.VSTHRD113.severity = none # "check for IAsyncDisposable"; a design guideline
dotnet_diagnostic.VSTHRD114.severity = none # "do not return null from a Task-returning method"; Result<T> is this repository's answer to that question
dotnet_diagnostic.VSTHRD115.severity = none # JoinableTaskContext with a null SynchronizationContext; JoinableTaskFactory
dotnet_diagnostic.VSTHRD116.severity = none # ThreadStatic only on static fields; the tree has eight [ThreadStatic] sites and the rule's own guidance is not this repository's
dotnet_diagnostic.VSTHRD117.severity = none # ThreadStatic initialization in a type initializer; same eight sites
dotnet_diagnostic.VSTHRD200.severity = none # Async naming convention; the rule's list of async operations is the JoinableTaskFactory one
dotnet_diagnostic.VSTHRD201.severity = none # cancel after switching to the main thread; JoinableTaskFactory, and undocumented upstream
dotnet_diagnostic.VSTHRD202.severity = none # "remove the unnecessary async state machine"; it would fire on every async member without an await, and its fix changes the signature

# --- Public API (Microsoft.CodeAnalysis.PublicApiAnalyzers 5.6.0) ---
# The public-API freeze of #428, expressed as a COMPILE-time gate (#1845).
# The package is referenced by exactly two projects — Harbor.Abstractions and
# Harbor.Abstractions.Contracts, the two assemblies #428 freezes — with
# PrivateAssets=all, so these diagnostics exist in no other project in the
# tree. "Errors on the frozen surface and nowhere else" is therefore a fact
# about the package graph, not a promise made by this file.
#
# WHY THE SEVERITIES ARE SET EXPLICITLY RATHER THAN LEFT TO
# TreatWarningsAsErrors: the analyzer package's own buildTransitive props
# appends every RS id to `WarningsNotAsErrors` when
# `CodeAnalysisTreatWarningsAsErrors` is false, so the promotion to error
# would depend on a property inside a package rather than on a decision
# recorded here. `severity = error` does not go through that promotion, so
# the gate stays an error even if the repo's warnings-as-errors policy is
# ever relaxed.
#
# AND WHY ONLY SOME OF THE RULES ARE HERE. Roslyn applies a per-rule
# `.editorconfig` severity to a diagnostic ONLY when the diagnostic's
# location has a syntax tree (AnalyzerDriver.GetFilteredDiagnostic tests
# `diagnostic.Location.SourceTree`). Five of the analyzer's rules are NOT
# reported at a symbol: RS0017 (a declared API symbol that is not in the
# code), RS0024 and RS0025 (an invalid or duplicated baseline) and RS0050 (a
# removal marker that disagrees with the code) are reported INSIDE
# PublicAPI.*.txt, and RS0048 (a missing API file) is reported at no
# location at all. A `.editorconfig` severity cannot reach any of them, so
# they are configured where it can: `<WarningsAsErrors>` in the two frozen
# projects' .csproj files, which the compiler applies to a diagnostic by its
# id wherever it is reported. Writing them here as well would be the kind of
# configuration that reads like policy and reaches nothing — the same defect
# ANALYZERS.md records for REL0001/REL0002.
#
# RS0016 — a public symbol is not in the declared API. The gate's core.
dotnet_diagnostic.RS0016.severity = error
# RS0022 — a constructor makes a non-inheritable base class inheritable and
# so exposes the base's protected members. Fires only on unshipped API, so
# it is a rule about what may be ADDED to the frozen surface.
dotnet_diagnostic.RS0022.severity = error
# RS0026 — do not add several public overloads with optional parameters.
# Breaks compatibility when the API is EXTENDED, which is the case the
# freeze exists for.
dotnet_diagnostic.RS0026.severity = error
# RS0027 — a public API with optional parameters must have the most
# parameters among its public overloads. Same back-compat family as RS0026.
dotnet_diagnostic.RS0027.severity = error
# RS0036 — a declared API symbol is missing its nullability annotations.
# Nullability is part of the signature a NuGet consumer compiles against,
# so `string` -> `string?` is a breaking change and the old text scan could
# not see it at all.
dotnet_diagnostic.RS0036.severity = error
# RS0037 — the public API files must carry `#nullable enable`, or the
# analyzer cannot track nullability at all. The baseline files do.
dotnet_diagnostic.RS0037.severity = error
# RS0041 — a public member uses an oblivious reference type. Off while the
# tree is not at 100% annotation: the analyzer's own documentation
# recommends disabling this rule until an existing project is fully
# annotated, and a rule that fires on every pre-existing member trains
# people to ignore it. RS0036 (annotate the DECLARED API) is the rule that
# is enforced, and it is the one that protects consumers.
dotnet_diagnostic.RS0041.severity = none
#
# NOT HERE, and where they are instead:
#   RS0017  a declared API symbol is not in the code   -> <WarningsAsErrors>
#   RS0024  the public API files are invalid            -> <WarningsAsErrors>
#   RS0025  a symbol appears twice in the API files     -> <WarningsAsErrors>
#   RS0048  a public API file is missing                -> <WarningsAsErrors>
#   RS0050  a symbol is marked removed but still exists -> <WarningsAsErrors>
# in src/Harbor.Abstractions/Harbor.Abstractions.csproj and
# src/Harbor.Abstractions.Contracts/Harbor.Abstractions.Contracts.csproj.

# ============================================================================
# DEPENDENCY INJECTION ANALYZERS (Task A3)
# ============================================================================
# Two DI analyzer packages are wired in:
#
# 1. DependencyInjection.Lifetime.Analyzers (rules DI001–DI037)
#    Solution-wide via /Directory.Build.props. Catches captive deps,
#    lifetime mismatches, circular DI, scope leaks, BuildServiceProvider
#    misuse, etc. Default severities are mostly Warning; we promote the
#    high-signal rules to Error and demote the noisy design-smell rules
#    to Suggestion.
#
#    The rule count is 37 because the package moved 2.18.24 → 3.7.8 in
#    #1897: 2.18.24 shipped 26 ids (DI001–DI022, DI024–DI027; DI023 was
#    unused) and 3.7.8 ships 37 (DI001–DI037, no gap), so ELEVEN ids were
#    added and NONE removed. Every one of the eleven has a row below, at
#    the severity the package ships it with, and the reason is in
#    docs/ANALYZERS.md §DI lifetime rules.
#
# 2. Excubo.Analyzers.DependencyInjectionValidation (rules EDI01–EDI04)
#    Apps-only via apps/Directory.Build.props. Validates [Exposes(typeof(T))]
#    attribute declarations on composition root methods. Default severity
#    is Warning; we keep them at Suggestion because the analyzer may emit
#    false positives when registration is split across private helpers
#    (which is our case). Real coverage is the DI tests in
#    tests/Harbor.App.*.Tests/.
#
# Rule index for DependencyInjection.Lifetime.Analyzers:
#   DI001 Service scope not disposed                      → warning
#   DI002 Scoped service escapes scope                    → warning
#   DI003 Captive dependency                               → error   (high-signal)
#   DI004 Service used after scope disposed                → warning
#   DI005 Use CreateAsyncScope in async methods            → warning
#   DI006 Static IServiceProvider cache                    → warning
#   DI007 Service locator anti-pattern                     → suggestion
#   DI008 Disposable transient service                     → warning
#   DI009 Open generic captive dependency                  → warning
#   DI010 Constructor over-injection                       → suggestion
#   DI011 IServiceProvider injection                       → suggestion
#   DI012 Conditional registration misuse                  → suggestion
#   DI013 Implementation type mismatch                     → error   (default)
#   DI014 Root provider not disposed                       → warning
#   DI015 Unresolvable dependency                          → error   (high-signal)
#   DI016 BuildServiceProvider misuse                      → suggestion (existing pattern)
#   DI017 Circular dependency                              → error   (high-signal)
#   DI018 Non-instantiable implementation type             → warning
#   DI019 Scoped service resolved from root provider       → error
#   DI020 Middleware captures scoped service               → warning
#   DI021 Non-thread-safe service shared across handlers   → warning
#   DI022 Service instance reused across handlers          → suggestion
#   DI023 Fire-and-forget background work captures a scope → warning
#   DI024 Hosted service scope outside execution loop      → warning
#   DI025 Event subscription without unsubscribe           → warning
#   DI026 Event subscription on scoped publisher           → suggestion
#   DI027 Rx subscription without dispose                  → warning
#   DI028 Discarded callback registration on a long-lived source → warning
#   DI029 HttpClient lifetime misuse                       → warning
#   DI030 Unbounded singleton or static cache              → suggestion
#   DI031 Shared implementation registered under several service types → suggestion
#   DI032 Service implements only IAsyncDisposable          → warning
#   DI033 Container will not dispose a pre-built instance  → suggestion
#   DI034 HttpContext used in fire-and-forget background work → warning
#   DI035 Non-thread-safe service shared across a fan-out  → warning
#   DI036 Registration added after the provider was built   → warning
#   DI037 Un-awaited task escapes the scope that created it → warning
#
# Excubo DI validation rules:
#   EDI01 Too many service extensions                      → suggestion
#   EDI02 Missing service extension                        → suggestion
#   EDI03 Incomplete service extension                     → suggestion
#   EDI04 Missing dependency                                → suggestion
#   ADP0001 Analyzer exception                             → suggestion
# ============================================================================

# --- DI lifetime (high-signal: error) ---
dotnet_diagnostic.DI003.severity = error # Captive dependency
dotnet_diagnostic.DI015.severity = error # Unresolvable dependency
dotnet_diagnostic.DI017.severity = error # Circular dependency
dotnet_diagnostic.DI019.severity = error # Scoped service resolved from root provider
# DI013 is already Error by default; restate for visibility.
dotnet_diagnostic.DI013.severity = error # Implementation type mismatch

# --- DI lifetime (warning — keep default) ---
dotnet_diagnostic.DI001.severity = warning
dotnet_diagnostic.DI002.severity = warning
dotnet_diagnostic.DI004.severity = warning
dotnet_diagnostic.DI005.severity = warning
dotnet_diagnostic.DI006.severity = warning
dotnet_diagnostic.DI008.severity = warning
dotnet_diagnostic.DI009.severity = warning
dotnet_diagnostic.DI014.severity = warning
dotnet_diagnostic.DI018.severity = warning
dotnet_diagnostic.DI020.severity = warning
dotnet_diagnostic.DI021.severity = warning
# DI023-DI037 are the eleven ids 2.18.24 did not have; each one is baselined
# to the severity the analyzer ships it with, so the version move cannot turn
# the zero-warning build red on the day it lands. The long reason for each is
# in docs/ANALYZERS.md (DI lifetime rules); the short form is here.
dotnet_diagnostic.DI023.severity = warning # Fire-and-forget background work captures a scope; the tree creates no service scope at all
dotnet_diagnostic.DI024.severity = warning
dotnet_diagnostic.DI025.severity = warning
dotnet_diagnostic.DI027.severity = warning
dotnet_diagnostic.DI028.severity = warning # Discarded callback registration on a longer-lived source; every linked token source in the tree is disposed
dotnet_diagnostic.DI029.severity = warning # HttpClient lifetime misuse; the two long-lived clients set PooledConnectionLifetime, which the rule exempts
dotnet_diagnostic.DI032.severity = warning # Service implements only IAsyncDisposable; no such type is registered as a plain type registration
dotnet_diagnostic.DI034.severity = warning # HttpContext in fire-and-forget work; the tree has no ASP.NET and no HttpContext
dotnet_diagnostic.DI035.severity = warning # Non-thread-safe service shared across a fan-out; no DbContext and no shared ADO.NET connection
dotnet_diagnostic.DI036.severity = warning # Registration added after the provider was built; the one build-then-register site hands the collection on
dotnet_diagnostic.DI037.severity = warning # Un-awaited task escapes the scope that created it; the tree creates no service scope at all

# --- DI lifetime (suggestion — design smells, existing patterns) ---
# DI007 service-locator and DI010 over-injection are anti-patterns, not bugs.
# DI011 IServiceProvider injection is intentional in HostBuilder.cs.
# DI016 BuildServiceProvider misuse — existing pattern in HostBuilder.cs
#        (calls BuildServiceProvider().GetRequiredService<ILoggerFactory>() during
#        registration to bootstrap logging). Refactoring would require a bigger
#        rewrite; demote to suggestion so it's visible but non-blocking.
dotnet_diagnostic.DI007.severity = suggestion
dotnet_diagnostic.DI010.severity = suggestion
dotnet_diagnostic.DI011.severity = suggestion
dotnet_diagnostic.DI012.severity = suggestion
dotnet_diagnostic.DI016.severity = suggestion
dotnet_diagnostic.DI022.severity = suggestion
dotnet_diagnostic.DI026.severity = suggestion
dotnet_diagnostic.DI030.severity = suggestion # Unbounded singleton or static cache; ships Info, and every collection field here is bounded or owned by a type the container never creates
dotnet_diagnostic.DI031.severity = suggestion # Shared implementation under several service types; ships Info, and no implementation is registered under two service types
dotnet_diagnostic.DI033.severity = suggestion # Container will not dispose a pre-built instance; ships Info, and the three pre-built registrations are written off (docs/ANALYZERS.md)

# --- Excubo DI validation (suggestion — primary coverage is DI tests) ---
dotnet_diagnostic.EDI01.severity = suggestion
dotnet_diagnostic.EDI02.severity = suggestion
dotnet_diagnostic.EDI03.severity = suggestion
dotnet_diagnostic.EDI04.severity = suggestion
dotnet_diagnostic.ADP0001.severity = suggestion

# ============================================================================
# ARCHITECTURE LAYERING (§ARCH-001..§ARCH-NNN)
# ============================================================================
# Harbor follows Clean / Hexagonal / Onion Architecture. The dependency
# direction is INWARD ONLY:
#
#   Presentation  →  Application  →  Domain
#                       ↑                  ↑
#   Infrastructure ─────┘──────────────────┘
#
# There is no built-in Roslyn analyzer for "assembly A must not reference
# assembly B" (the closest is a custom BanAssemblies analyzer, which we do not
# use). Instead, layering is enforced mechanically by:
#
#   1. tests/Harbor.Architecture.Tests/LayerDependencyTests.cs — 21 tests that
#      load every Harbor assembly via reflection and assert on
#      Assembly.GetReferencedAssemblies(). Run with:
#        dotnet test tests/Harbor.Architecture.Tests/
#
#   2. Code-review checklist in CLAUDE.md §Layering rules — for soft rules
#      that cannot be mechanically checked (e.g. "concrete impl types are
#      new'd only in HostBuilder.cs").
#
# Canonical reference: docs/ARCHITECTURE_LAYERS.md
# Audit history:       docs/CODE_PRINCIPLES_AUDIT.md §15
#
# Before adding a <ProjectReference> to any .csproj, check the allowed /
# forbidden matrix in docs/ARCHITECTURE_LAYERS.md §2. If you violate a rule,
# the corresponding architecture test will fail with a clear list of the
# forbidden references.
# ============================================================================
# HARBOR'S OWN ARCHITECTURE RULES (build-time analyzers, #1842)
# ============================================================================
# Two of the rules this repository grades on itself are written as compiler
# extensions and live in src/Harbor.Arch.Analyzers. The compiler runs them
# over every product project, so a violation fails the build where it is
# written rather than in a test run afterwards.
#
# HARCH001 — the dynamic-code ban (#626), decided by resolving the TYPE: a
# type derived from a banned one is a hit, and a comment or a string literal
# that names one is not. The plugin family is exempt by id in
# src/Directory.Build.props, because loading code at run time IS the plugin
# product.
#
# HARCH002 — a namespace root belongs to the project that declares it. A
# file walk cannot answer that question, because the shared source folders
# are compiled into several assemblies at once.
#
# Both are `warning`, and the build promotes warnings to errors, so a
# violation in a product tree is a build error. One id per rule, so that one
# rule can be switched off without switching off its neighbour.
dotnet_diagnostic.HARCH001.severity = warning # the tree is clean against this rule: the text rule that stays as the oracle reads the whole source text, and the analyzer's differential over the live tree agrees with it
dotnet_diagnostic.HARCH002.severity = warning # the tree is clean against this rule: the ownership table is the only input, and no project outside the owners declares an owned root
#
# HARCH005 — an HTTP client is created at this site, and HARCH006 — it is
# created inside a delegate, so it is minted per call (#1854). Both are
# decided by resolving the TYPE: the target-typed `HttpClient client = new();`
# and the fully qualified `new System.Net.Http.HttpClient()` are one fact, and
# a name inside a comment or a string literal is not a creation at all.
#
# Both are `suggestion`, which is the FIRST step of the ladder in
# docs/ANALYZERS_AUTHORING.md §Severity. The gate for these two rules is the
# architecture suite, which drives the analyzer in-process over the live tree
# and compares the allowance table with what it finds; the build only
# COLLECTS the findings. They are not at `warning` yet because the table that
# says which of the seven sites may create a client lives with the gate, not
# with the compiler, and a build-time rule that cannot see the table would
# report all seven.
dotnet_diagnostic.HARCH005.severity = suggestion # the rule's gate is the architecture suite (tests/Harbor.Architecture.Tests/HttpClientReuseRules.cs), which drives this analyzer in-process; the build collects the findings, and the ladder's first step is `suggestion` (docs/ANALYZERS_AUTHORING.md §Severity)
dotnet_diagnostic.HARCH006.severity = suggestion # the rule's gate is the architecture suite (tests/Harbor.Architecture.Tests/HttpClientReuseRules.cs), which drives this analyzer in-process; the build collects the findings, and the ladder's first step is `suggestion` (docs/ANALYZERS_AUTHORING.md §Severity)
# ============================================================================
# PATH-SCOPED SEVERITY OVERRIDES (#838, narrowed at #865; #1905 adds tests/)
# ============================================================================
# Everything above this line is tree-wide. This block is the ONE place where a
# diagnostic's severity is a function of (rule x path) rather than of the rule
# alone, and it is the reason docs/ANALYZERS.md read as though it were lying
# about the build: the doc summarised the rule half of the severity model and
# omitted this half, so `apps/Harbor.App.Avalonia/App.axaml.cs` —
# `public static IServiceProvider Services { get; set; }`, the exact shape
# DI006's own README puts in its "Problem" block — compiled clean while the
# same document said a static container is a build error. It was never an
# enforcement gap and never a hole in the rule. Read the two together.
#
# WHY THE DESKTOP ROOT IS RELAXED: an Avalonia composition root has to hand its
# container to the XAML object graph, which cannot take constructor parameters,
# so the static root provider IS the idiom there. The CLI root resolves through
# DI and keeps DI006 at `warning`, and apps/Harbor.App.Cli is deliberately
# absent from this list. That asymmetry is observed, not assumed: #837 planted a
# static container in the CLI root and the build failed with `error DI006`
# before a test ran, in the same session that found the Avalonia root's
# equivalent compiling clean.
#
# THE THREE SIBLING BLOCKS ARE GONE (#838). `apps/Harbor.App.{Wpf,Maui,Blazor}`
# carried identical four-rule relaxations, and none of those directories exists:
# those composition roots live under contrib/, which is not in Harbor.slnx and
# is not built by CI. They were inert configuration that read like live policy —
# a re-added `Harbor.App.Blazor` would have inherited a four-rule DI relaxation
# nobody chose for it, with no diagnostic anywhere to say so.
# `AnalyzerSeverityScopeRules.PathScopedSections_ResolveToRealPaths` in
# tests/Harbor.Architecture.Tests/ now fails if such a block reappears, and
# `DiSeverityOverrides_AreScopedToExactlyTheDeclaredRoot` pins this one path as
# the whole surface.
#
# ONE REASON PER ROW, AND THE REASON IS THE ROW'S OWN NAME (#865). The block
# used to be four rules deep under a single sentence that named three of them,
# and the fourth was covered by neither the sentence nor the parenthetical that
# tried to enumerate the rest. A reason that covers N rows is only auditable if
# it names them, so each row below carries its own. `DiSeverityDemotionRules.
# PathScopedSection_NamesEveryRuleItSets` fails the build when one does not —
# the reason is a comment, and a comment is invisible to the compiler, to the
# analyzer it silences, and to every other gate here.
[apps/Harbor.App.Avalonia/**.cs]
# DI006 — the XAML object graph has to be handed a container, and
# App.Services is where it is parked (App.axaml.cs).
dotnet_diagnostic.DI006.severity = suggestion
# DI008 — the app's only transient is a disposable view model
# (OnboardingViewModel, ViewModelRegistration.cs) that lives for the process.
dotnet_diagnostic.DI008.severity = suggestion
# DI014 — a process-lifetime root provider is disposed at exit, by design
# (App.axaml.cs disposes Host on shutdown). Kept visible, non-blocking.
dotnet_diagnostic.DI014.severity = suggestion
# DI003 is NOT demoted here and is not to be added. It is a lifetime-GRAPH rule
# (a singleton or long-lived factory retaining a scoped/transient service), not
# a process-lifetime rule, so "process-lifetime singletons" never covered it.
# Nothing about this root needs it relaxed: the app registers no scoped service
# at all (0 AddScoped, and 0 repo-wide under src/ + apps/), and its single
# transient (OnboardingViewModel) is resolved from the root inside
# App.ShowOnboardingThenMain rather than captured by a constructor, so there is
# no DI003 site to hide. It stays at the repo-wide `error` its sibling
# composition root apps/Harbor.App.Cli is held to.
#
# The TUnit0055 demotion that used to sit here (the NickConsoleEx golden-frame
# capture test, which drove SharpConsoleUI window-system internals) is GONE:
# the vendored renderer moved to contrib/tui/Harbor.Tui.NickConsoleEx and its
# capture test with it, so the path no longer exists. A demotion for a file
# that is not in the tree is the #865 shape in the other direction — a
# permission for nothing. The contributed renderer keeps its own .editorconfig
# beside it, where the tree that owns the file can see it.

# --- Sonar in the test tree ---
# The six rules below are off under tests/ only. The split is measured, not
# assumed: on dev@086ef777 (CI run 39472959027, the Release build of
# Harbor.slnx) SonarAnalyzer.CSharp reported 476 sites in 40 rules, and every
# one of them is under tests/. There are 0 under src/ and 0 under apps/, so
# each Sonar rule below is worth something in a product tree and is noise in a
# test tree. Off here, on everywhere else.
[tests/**.cs]
# S5443: a hardcoded "/tmp/..." literal is the fixture a hermetic test pins.
dotnet_diagnostic.S5443.severity = none # hardcoded temp path is the test's own fixture data
# S1215: GC.Collect is the setup of the allocation and finalization tests.
dotnet_diagnostic.S1215.severity = none # GC.Collect is the setup of the allocation and finalization tests
# S1313: the addresses (8.8.8.8, 169.254.169.254, 192.168.88.42) are the test data.
dotnet_diagnostic.S1313.severity = none # hardcoded IP addresses are the test's own data
# S5332: the http URLs are fixtures, an .invalid host or a local server the test starts.
dotnet_diagnostic.S5332.severity = none # http is the fixture: an .invalid host or a local test server
# S3878: an explicit array for a params overload is the calling convention in the helpers.
dotnet_diagnostic.S3878.severity = none # explicit array for a params overload, by convention
# S3220: the overload shape is a call-style question, not a defect.
dotnet_diagnostic.S3220.severity = none # overload shape, not a defect


#
# THE tests/ BLOCK (#1905). Reflection is allowed in tests by convention
# (docs/ARCHITECTURE_LAYERS.md §5.8), and the ReflectionAnalyzers findings
# are all under tests/: measured on a green CI build of dev (86b52adc), 41
# findings, 41 of them under tests/, none under src/ or apps/. The four rules
# below are the correctness rules among them, and every one of the 8 findings
# they account for is deliberate or unresolvable, not a defect:
#
#   * a test that asserts a member is ABSENT (a property without a setter, a
#     method that must not be public, a type that must not exist) is asking
#     the analyzer to report exactly what it reports;
#   * a test that reads a member off an `object`-typed value, or off a plugin
#     type that is compiled at run time, asks about a member the analyzer
#     cannot resolve.
#
# They are demoted to `suggestion` HERE ONLY. Outside tests/ the same four
# rules stay `warning`, and `warning` is promoted to an error in src/ and
# apps/, which is where a reflective call that cannot work is a real defect.
# The rows are demoted, not deleted: the rules still run, they are still
# visible in the IDE, and the finding count is recorded in
# docs/ANALYZERS.md so the debt is a number rather than a memory.
#
# REFL003 — 4 findings, all deliberate: two tests assert that a property has
# NO setter (OwnerReportTests), and two read a field of a plugin type that is
# compiled at run time and cannot be resolved by the analyzer
# (RealWorldPluginsTests, DllRealWorldPluginsTests).
dotnet_diagnostic.REFL003.severity = suggestion
# REFL005 — 1 finding, deliberate: the test asserts that the lookup finds
# nothing (FrameDiffVisibilityTests asserts the method is not public).
dotnet_diagnostic.REFL005.severity = suggestion
# REFL009 — 2 findings, both unresolvable: the member is read off an
# `object`-typed value through instance.GetType(), so the analyzer resolves it
# against `object` (StreamingCoalescerNoStoreTests, McpHttpClientFactoryTests).
dotnet_diagnostic.REFL009.severity = suggestion
# REFL037 — 1 finding, deliberate: the test asks an assembly for a type by
# name precisely to prove that the type is NOT there
# (NoMainViewModelRefsTests).
dotnet_diagnostic.REFL037.severity = suggestion
