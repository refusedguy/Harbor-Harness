# --- Meziantou 3.0.315 (new rules, MA0213-MA0243) ---
# The 3.0.123 -> 3.0.315 gap adds these 31 rules and changes no severity on the
# 209 that already existed (both read out of the `configuration/default.editorconfig`
# the package ships). Each new rule is baselined to the severity the analyzer
# ships it with, so the version move cannot turn the zero-warning build red on
# the day it lands. The three that ship as `warning` (MA0220, MA0240, MA0241)
# read the BannedSyntaxes.txt file, which this repository does not have, so
# they have no input -- they are advisory here so that adding that file later
# cannot break the build either.
dotnet_diagnostic.MA0213.severity = none # Simplify negated boolean expression (ships none by default; not adopted yet)
dotnet_diagnostic.MA0214.severity = none # Use 'await' instead of returning the task (ships none by default; not adopted yet)
dotnet_diagnostic.MA0215.severity = none # Return the task instead of awaiting it (ships none by default; not adopted yet)
dotnet_diagnostic.MA0216.severity = suggestion # Remove unnecessary closed modifier (ships suggestion by default; not adopted yet)
dotnet_diagnostic.MA0217.severity = none # Use a static lambda (ships none by default; not adopted yet)
dotnet_diagnostic.MA0218.severity = suggestion # The language attribute is empty (ships suggestion by default; not adopted yet)
dotnet_diagnostic.MA0219.severity = silent # Set the language attribute in XML comment (ships silent by default; not adopted yet)
dotnet_diagnostic.MA0220.severity = suggestion # The configured regular expression is not valid (ships warning; reads BannedSyntaxes.txt, which this repo does not have)
dotnet_diagnostic.MA0221.severity = none # TryGetValue method should use [MaybeNullWhen(false)] on the value parameter (ships none by default; not adopted yet)
dotnet_diagnostic.MA0222.severity = none # JsonSourceGenerationOptions should set RespectNullableAnnotations (ships none by default; not adopted yet)
dotnet_diagnostic.MA0223.severity = none # JsonSourceGenerationOptions should set RespectRequiredConstructorParameters (ships none by default; not adopted yet)
dotnet_diagnostic.MA0224.severity = none # JsonSerializerOptions should set RespectNullableAnnotations (ships none by default; not adopted yet)
dotnet_diagnostic.MA0225.severity = none # JsonSerializerOptions should set RespectRequiredConstructorParameters (ships none by default; not adopted yet)
dotnet_diagnostic.MA0226.severity = none # EventSource class should be sealed (ships none by default; not adopted yet)
dotnet_diagnostic.MA0227.severity = none # Avoid using 'Enumerable.Contains' on a set (ships none by default; not adopted yet)
dotnet_diagnostic.MA0228.severity = none # The event id of an EventSource must be greater than zero (ships none by default; not adopted yet)
dotnet_diagnostic.MA0229.severity = none # The event id of an EventSource is already used by another event (ships none by default; not adopted yet)
