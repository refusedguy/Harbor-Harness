<?xml version="1.0" encoding="utf-8"?>
<!--
  Directory.Packages.props — Central Package Management (CPM) for the Harbor solution.

  Every NuGet package consumed by any project in the repo has its version pinned
  here, with ONE exception: the NUKE build project under build/ turns CPM off
  for itself and pins its own dependency chain inline, in build/_build.csproj.
  Individual .csproj files declare only `<PackageReference Include="..." />`
  (no Version attribute) and inherit the version from this file.

  See docs/CENTRAL_PACKAGE_MANAGEMENT.md for the full guide.

  CPM is enabled by `<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>`
  in /Directory.Build.props.

  Grouping convention (top→bottom):
    1. Microsoft.Extensions.*  (logging, DI, hosting, options, http, configuration)
    2. Microsoft.CodeAnalysis.* (Roslyn, analyzers, banned-api)
    3. Microsoft.Data.*        (storage drivers)
    4. Microsoft.NET.* / test SDK
    5. TUnit + NetArchTest     (test framework + architecture rules, IL reader)
    6. CommunityToolkit.*      (MVVM)
    7. Spectre.*               (console + TUI libraries)
    8. Terminal.Gui / Termina / RazorConsole / Avalonia (alt UI stacks)
    9. Jint                     (scripting engine)
   10. Roslyn analyzers         (Roslynator, Sonar, Meziantou, AsyncFixer, Reflection)
   11. Performance              (ZLinq, NonBlocking, MemoryPack, CSharpFunctionalExtensions)
   12. SQLite drivers
   13. Source generators        (ZLinq.DropInGenerator, Termina.Generators)
   14. Reference hygiene        (ReferenceTrimmer — build-time only, #1853)
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      NuGet 6.0+ supports central package management. When a project declares a
      <PackageReference Include="X" /> (no Version), NuGet resolves the version
      from this file. <CentralPackageTransitivePinningEnabled> additionally
      pins transitive dependencies to the versions declared here, so a vulnerable
      transitive cannot sneak in via a deep dependency.
    -->
  </PropertyGroup>
  <ItemGroup>
    <!-- ── Microsoft.Extensions.* ────────────────────────────────────────── -->
    <!--
      All Microsoft.Extensions.* packages are pinned to the 10.0.13 servicing
      release (published 2026-10-13) — the same band that carries the three
      high-severity advisory fixes tracked in #1892. Transitive dependencies
      (e.g. Terminal.Gui → Configuration.Binder 10.0.7, Termina →
      Hosting.Abstractions 10.0.8) require >= 10.0.7 / 10.0.8 / 10.0.9
      depending on the chain; pinning to 10.0.13 satisfies all transitive
      minimums and CentralPackageTransitivePinningEnabled keeps them locked
      to this version.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.13" />
    <!-- ── Microsoft.CodeAnalysis.* (Roslyn + analyzers) ─────────────────── -->
    <!--
      Microsoft.CodeAnalysis.CSharp 5.6.0 → 5.9.0 (#1897).

      This is the COMPILER, not an analyzer: the plugin host compiles CS
      plugins in memory with it (src/Harbor.Plugins.Compilation) and the
      source generators (src/Harbor.CodeGen) are built against it, so three
      minor versions of drift were drift in a product dependency.

      The pin now MATCHES the compiler the build runs on. global.json asks for
      SDK 10.0.402, and the 10.0.4xx SDK branch pins
      MicrosoftCodeAnalysisCSharpPackageVersion = 5.9.0-1.26480.109
      (dotnet/sdk eng/Version.Details.props) — so the generator compiled against
      5.9.0 loads into a 5.9.0 compiler instead of asking for an API the host
      does not have.

      DELTA, read out of the shipped assemblies:
        * Compiler diagnostics: 1987 distinct CS ids in 5.6.0, 2002 in 5.9.0.
          17 ADDED (CS9378-CS9394), 2 REMOVED (CS9367, CS9368). Every added id
          is an ERROR for a language feature the tree does not use (shebang,
          `requires unsafe`, closed type declarations, unions, the `safe`
          modifier, labelled break/continue) — no new warning can fire.
        * Transitive analyzer Microsoft.CodeAnalysis.Analyzers 5.3.0 →
          5.9.0-1.26328.17: 52 RS ids in both, ZERO added, ZERO removed.
        * Public API: 6 members removed (compiler-generated backing fields and
          three TextLine members), and one signature family changed
          (SyntaxFactory.BreakStatement/ContinueStatement gained a label
          parameter). The tree uses none of them. No member became obsolete
          between the two versions.

      Microsoft.CodeAnalysis.NetAnalyzers 10.0.302 → 10.0.402 (#1897) — the
      servicing patch of the same minor, and the version the 10.0.402 SDK
      itself bundles. DELTA: 329 CA ids in BOTH analyzer assemblies, ZERO
      added, ZERO removed; the C#-specific satellite adds 5 ids in both.
      The main assembly is the same LENGTH (2 561 320 bytes) but NOT
      byte-identical — 2 099 499 bytes differ (metadata offsets shift), so
      the "byte-identical" claim in the original audit does not hold for the
      version actually taken. Same rule set, different build.

      Microsoft.CodeAnalysis.BannedApiAnalyzers stays at 5.6.0: it is not one
      of the four packages in #1897, and an analyzer built against an older
      Roslyn runs unchanged inside a newer compiler.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.402" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!--
      PublicApiAnalyzers (RS0016/RS0017/RS0022/RS0024/RS0025/RS0026/RS0027/
      RS0036/RS0037/RS0041/RS0048/RS0050) is the public-API freeze of #428,
      expressed as a COMPILE-time gate instead of a text scan (#1845). The
      version is pinned to the same 5.6.0 as the two sibling
      Microsoft.CodeAnalysis.* analyzer packages above, so one Roslyn analyzer
      wave is in the tree rather than two. MIT, Microsoft, dotnet/roslyn.

      Referenced ONLY by the two frozen assemblies (Harbor.Abstractions and
      Harbor.Abstractions.Contracts) — the freeze covers those two and not the
      other 90-odd projects, and the package is not transitively visible
      (PrivateAssets=all), so the RS00xx diagnostics cannot appear anywhere
      else in the tree.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- ── Microsoft.Data.* (storage drivers) ────────────────────────────── -->
    <!--
      Microsoft.Data.Sqlite 10.0.13 is the same servicing release as the
      Microsoft.Extensions.* band above; it raises its SQLitePCLRaw transitives
      to 2.1.13. The native library itself stays on our own pin
      (SQLitePCLRaw.lib.e_sqlite3 3.53.3, the last stable upstream release),
      so the native side is unchanged by this bump.
    -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- ── TUnit + NetArchTest (test framework + arch rules + IL reader) ─── -->
    <PackageVersion Include="TUnit" Version="1.75.0" />
    <PackageVersion Include="TUnit.Assertions" Version="1.75.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!--
      Mono.Cecil — the IL reader behind the CAPABILITY half of the
      architecture rules (#455), and the reason this entry exists (#1865).

      Two files of tests/Harbor.Architecture.Tests walk the IL of every method
      body of every Presentation assembly: PresentationCapabilityRules.cs
      (1422 lines) and RendererEventSeamRule.cs (913 lines). Their input is
      Cecil's object model — MethodBody.Instructions, Instruction.Operand,
      MemberReference.DeclaringType — and 2336 lines of rules are written
      against it. Replacing Cecil with System.Reflection.Metadata would mean
      hand-decoding IL and resolving metadata tokens, which the probe's own
      header puts at "~200 lines of token and arithmetic edge cases"; the
      package stays.

      What changes is WHO OWNS IT. Until #1865 the dependency was BORROWED:
      NetArchTest.Rules 1.3.2 happens to depend on Mono.Cecil 0.11.3
      (exclude="Build,Analyzers" in its nuspec), and the two rule files
      compiled against that transitively-restored copy. Consequences that
      were measured, not assumed:
        * touching NetArchTest.Rules broke the compiler of 2336 lines of
          IL rules that have nothing to do with its DSL;
        * the IL-parsing version was a property of a DSL library, and
          CentralPackageTransitivePinningEnabled could not pin it (there
          was nothing to pin — the package was not declared here);
        * migrating to TngTech.ArchUnitNET 0.13.4 (proposed in #1841, and
          it declares Mono.Cecil 0.11.6) would have moved the parser under
          the rules silently.
      Declared here, the ownership is the rules', and the pin is visible.

      0.11.6 is the floor that satisfies BOTH consumers: NetArchTest.Rules
      1.3.2 requires >= 0.11.3, and TngTech.ArchUnitNET 0.13.4 requires
      exactly 0.11.6. Pinning the higher of the two means the future
      migration does not move the IL parser under the rules — which is the
      drift this pin exists to prevent. Upstream shipped bug-fix releases
      only between 0.11.3 (2020-09-15) and 0.11.6 (2024-10-02): no API
      break is documented, the member names the two rule files use are
      present in both assemblies, and the rules' own non-vacuity probes
      (which read real IL and must still CATCH a forbidden capability) run
      on every CI build — so a parser change that altered a verdict would
      be red, not silent.

      Test-only: no project under src/ or apps/ references it, so it never
      reaches a published binary or an aot-publish.

      Advisory status: no GitHub Advisory and no OSV record exists for
      Mono.Cecil at any version (checked 2026-10-20 against the GitHub
      Advisory DB API and the OSV query API). The non-blocking vulnerability
      scan in ci.yml reports the solution's advisories on every
      dependency-changing PR.
    -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <!-- ── BenchmarkDotNet ───────────────────────────────────────────────── -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- ── CommunityToolkit.* (MVVM) ─────────────────────────────────────── -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- ── Spectre.* (console + TUI) ─────────────────────────────────────── -->
    <!--
      Spectre.Console stays at 0.54.0 — the last version with Color/Decoration
      types in the main Spectre.Console assembly. From 0.55 onward these
      types moved to Spectre.Console.Ansi without type forwarders, which
      breaks RazorConsole.Core 0.6.0-alpha (which has a hard dependency on
      Spectre.Console 0.54.0 and whose source generator emits
      `Spectre.Console.Color` references). Upgrading RazorConsole to a
      newer release is blocked until RazorConsole publishes a build that
      targets Spectre.Console 0.55+.
    -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="Spectre.Console" Version="0.54.0" />
    <PackageVersion Include="Spectre.Tui" Version="0.14.0" />
    <PackageVersion Include="Spectre.Tui.App" Version="0.14.0" />
    <!-- ── Vendored submodule transitives ────────────────────────────────── -->
    <!--
      SixLabors.ImageSharp is a transitive-only pin, and it is load-bearing.
      The source of the transitive is the vendored external/ConsoleEx
      submodule: SharpConsoleUI.csproj declares SixLabors.ImageSharp 3.1.12
      directly. Harbor.Tui.NickConsoleEx references that project, so
      ImageSharp reaches Harbor's own graphs (Harbor.Hosting,
      Harbor.App.Cli, Harbor.App.Avalonia, the test projects) as a
      transitive of SharpConsoleUI.

      Every version below 4.1.2 is inside the advisory range:
      GHSA-j3p4-wp97-rph4, GHSA-j9gm-c75j-xc9q and GHSA-jjfr-hcj7-qf5w
      (high) plus GHSA-wmxv-xphr-5c9g and GHSA-gwg2-r3hj-4w44 (moderate) all
      cover ">= 1.0.0-beta0001, <= 4.1.1", and 4.1.2 is the first patched
      release. There is no patched 3.x to fall back to: 3.2.0 is the last
      3.x release and it is inside the range too. NU1902/NU1903 are errors
      here (TreatWarningsAsErrors), so without this pin the restore of
      Harbor.slnx dies. Measured on the branch that removed it: ImageSharp
      3.1.12 came back into the graph and the restore failed with
      NU1902/NU1903 in Harbor.Hosting, Harbor.App.Cli,
      Harbor.Tui.NickConsoleEx and Harbor.App.Avalonia.

      CentralPackageTransitivePinningEnabled (header) is the mechanism: it
      lifts the transitive from 3.1.12 to this version in Harbor's graphs.
      The vendored project keeps its own 3.1.12 (external/ turns CPM off),
      which is why the advisory stays a warning there.

      LICENCE: the Six Labors Split License treats a TRANSITIVE consumer as
      Apache-2.0, and SharpConsoleUI is the only direct consumer. Do not add
      a direct PackageReference for ImageSharp anywhere in this repo: that
      would move us into the commercial branch of the split licence.
    -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
    <!-- ── Alternative UI stacks ─────────────────────────────────────────── -->
    <PackageVersion Include="Terminal.Gui" Version="2.4.17" />
    <PackageVersion Include="Termina" Version="0.15.0" />
    <PackageVersion Include="RazorConsole.Core" Version="0.6.0-alpha.20260506-3ec7409" />
    <!-- Avalonia 12.1.x — latest stable line (12.1.4, released 2026-10-09).
         Brings the new Win32 chrome renderer (ExtendClientAreaChromeHints),
         fixed Dispatcher.MainLoop PlatformNotSupportedException on Windows
         without a RID, and Skia 3.x. Avalonia.AvaloniaEdit 12.0.0 is the
         matched code-editor build. Avalonia.Diagnostics stays on 11.3.x
         (11.3.22) because the diagnostics inspector was not published for the
         12.x line yet. -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- Avalonia.Headless — in-process off-screen renderer for E2E tests with screenshot capture. -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <!-- Avalonia.Skia — software renderer used by Avalonia.Headless when
         UseHeadlessDrawing=false. Required for CaptureRenderedFrame() to
         produce a real Bitmap we can save as PNG. -->
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.22" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- Markdig 1.4.2 — the markdown renderer for the desktop app. 1.4.2 adds
         the IsAotCompatible/IsTrimmable assembly metadata, so the package can
         enter a trimmed publish with the right metadata instead of a guess.
         The new strict GFM pipe-table mode (PipeTableOptions.UseGfmRules)
         is opt-in and defaults to false, so the parsed output of the two
         consumers (Harbor.Desktop.Shared, Harbor.App.Avalonia) is unchanged
         unless they ask for it. -->
    <PackageVersion Include="Markdig" Version="1.4.2" />
    <PackageVersion Include="AvalonEdit" Version="6.3.1.120" />
    <PackageVersion Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.1.0-dev-798" />
    <!-- ── .NET MAUI (workload-supplied; version matches the maui-windows
         workload pack installed on the build machine) ──────────────────── -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageVersion Include="Microsoft.Maui.Controls.Xaml" Version="10.0.20" />
    <PackageVersion Include="Microsoft.Maui.Essentials" Version="10.0.20" />
    <PackageVersion Include="Microsoft.Maui.Core" Version="10.0.20" />
    <PackageVersion Include="Microsoft.Maui.Resizetizer" Version="10.0.20" />
    <PackageVersion Include="Microsoft.Maui.Controls.Build.Tasks" Version="10.0.20" />
    <!-- ── Scripting engines ─────────────────────────────────────────────── -->
    <PackageVersion Include="Jint" Version="4.13.0" />
    <!-- ── Roslyn analyzers (consumed via Directory.Build.props) ─────────── -->
    <!--
      Roslynator 4.15.0 → 5.0.1 (#1851).

      The version gap introduces ZERO new diagnostic ids: both packages ship
      exactly 284 `RCS####` ids (verified by extracting them from the analyzer
      assemblies of 4.15.0 and 5.0.1). Roslynator 5.0.0 REMOVES the
      implementations of twenty obsolete rules (RCS0014, RCS0022, RCS0038,
      RCS0043, RCS0047, RCS1008-RCS1010, RCS1012, RCS1035, RCS1036,
      RCS1038/RCS1040/RCS1041/RCS1066/RCS1072/RCS1091/RCS1106,
      RCS1176/RCS1177, RCS1237) and points at successor rules that ALREADY
      ship in 4.15.0, so the removal can only shrink the finding surface.

      5.0.0 also adds the `roslyn5.0` analyzer flavour, which is the one the
      .NET 10 SDK (Roslyn 5.x) loads; 4.15.0 only shipped roslyn3.8/roslyn4.7.
      That is the anti-framework-risk half of #1851: the analyzer is now built
      against the same Roslyn major the compiler is.

      No severity rows are added for this family: with no new id there is no
      baseline to write, and the family keeps the severities it ships with.
    -->
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.29.0.143774" />
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
    <PackageVersion Include="ReflectionAnalyzers" Version="0.3.1" />
    <!--
      Meziantou 3.0.123 → 3.0.315 (#1851).

      The gap adds 31 new rules (MA0213–MA0243) and changes NO severity on the
      209 rules that already existed — both facts read out of the
      `configuration/default.editorconfig` the package ships, which lists every
      rule with its default severity.

      The new rules are baselined in .editorconfig: MA0213–MA0243 keep the
      severity the analyzer ships them with, so none of them can turn the
      zero-warning build red on the day the version moves. The three that ship
      as `warning` (MA0220, MA0240, MA0241) are demoted to `suggestion`: they
      read the BannedSyntaxes.txt file, which this repository does not have, so
      they have no input — but a future BannedSyntaxes.txt must not be able to
      break the build by accident.

      NOTE: MA0184–MA0212 exist in 3.0.123 as well and are still NOT in
      .editorconfig. They ship `none`/`suggestion` except for nine EventSource
      and JsonSerializer rules that ship `warning` and do not fire here. That
      hole predates this PR and is not widened by it.
    -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.315" />
    <!--
      DotNetProjectFile.Analyzers 1.19.1 (#1857).

      190+ rules over MSBuild project files rather than over C#. Three of them
      are adopted (Proj0037, Proj0040, Proj0041) and are errors; the rest are
      off with a written reason, family by family, in
      /Directory.Build.globalconfig — NOT in .editorconfig, because a
      diagnostic reported on a project file reaches the compiler as an
      additional file and Roslyn does not apply syntax-tree level editor config
      to those. Directory.Build.globalconfig carries the reason.

      The package's own `build/DotNetProjectFile.Analyzers.props` points
      `GlobalAnalyzerConfigFiles` at a file name the package does not ship
      (`DotNetProjectFile.globalconfig` vs the shipped
      `DotNetProjectFile.Analyzers.globalconfig`). The SDK filters
      non-existent entries out (`@(GlobalAnalyzerConfigFiles->Exists())`), so
      the dangling reference is inert.
    -->
    <PackageVersion Include="DotNetProjectFile.Analyzers" Version="1.19.1" />
    <!--
      CSharpFunctionalExtensions.Analyzers ships CFE0001 ("check IsSuccess or
      IsFailure before accessing Value from result object"), a mechanical guard
      for the §ROP-001 crash class that Harbor otherwise holds by review
      convention only (docs/ROP-API-INVENTORY.md §5).

      VERSION NOTE — this is NOT versioned in lockstep with the library. The
      analyzer lives in a separate repository
      (github.com/AlmarAubel/CSharpFunctionalExtensions.Analyzers) with its
      own GitVersion scheme, so `3.7.0` does not exist for it. Latest stable is
      1.4.1; do not "match" it to the CSharpFunctionalExtensions pin. The
      library it analyses is resolved from the consuming project's own
      reference, not from this package, so the two versions are independent.

      CFE0002 (prefer implicit type args) is Info and stays off — see §5.

      VERSION — 1.4.1 EXISTS, AND IS NOT TAKEN (#1897). The gap adds ZERO
      diagnostic ids: 1.3.0 and 1.4.1 ship the same two (CFE0001, CFE0002)
      and the same three public types, read out of the shipped analyzer
      assemblies. What 1.4.x changes is the rule BODY: CFE0001's title reads
      "IsSuccess or IsFailure" where 1.3.0 reads "IsError", the message
      appends the file/line/char of the offending access, and the walker was
      rewritten into a `ResultValueWalker`.

      THE REWRITE CRASHES THE COMPILER, and the repository has measured it:
      1.4.1 reports `AD0001 … System.InvalidOperationException: Operation is
      not valid due to the current state of the object` on five production
      projects (Harbor.Application, Harbor.Tools.Builtin, Harbor.Lsp,
      Harbor.Ui.Framework.Sessions, Harbor.Storage.Jsonl). Under this
      repository's `TreatWarningsAsErrors=true` those projects then FAIL TO
      COMPILE — which means they emit no CFE0001 diagnostics at all, so the
      §ROP-001 guard would go blind exactly where the crash class lives.
      See docs/ROP-API-INVENTORY.md §5.1 for the measurement.

      There is no intermediate version that dodges the rewrite: the
      `ResultValueWalker` is already in 1.4.0 (read out of that package's
      analyzer assembly too), so 1.4.0 carries the same rework the crash
      came with. The pin therefore stays at 1.3.0, and the §ROP-001 guard
      keeps working.
    -->
    <PackageVersion Include="CSharpFunctionalExtensions.Analyzers" Version="1.3.0" />
    <!--
      Microsoft.VisualStudio.Threading.Analyzers ("vs-threading") — 29 rules
      (VSTHRD001-004, VSTHRD010-013, VSTHRD100-117, VSTHRD200-202; the
      upstream index documents 28 of them). MIT licensed, `developmentDependency`
      only, and it ships NO lib/ folder and declares NO package dependencies:
      it contributes analyzer assemblies and nothing else, so nothing from it
      reaches a product binary or a consumer's dependency graph.

      Wired to src/ + apps/ only (src/Directory.Build.props and
      apps/Directory.Build.props), not solution-wide: tests/ has its own async
      culture and already lifts TreatWarningsAsErrors.

      EXACTLY ONE RULE IS ON — VSTHRD110, at `suggestion`. Every other rule is
      `none` with a written reason in .editorconfig: four of them are Error by
      default and would red the build on the day the package is added, and a
      large part of the family is written against JoinableTaskFactory, which
      Harbor does not reference.

      Issue #1852. Version pinned 2026-10-12 release of the 18.x line.
    -->
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <!-- ── Performance / collections / serialization ─────────────────────── -->
    <PackageVersion Include="ZLinq" Version="1.5.6" />
    <PackageVersion Include="ZLinq.DropInGenerator" Version="1.5.6" />
    <PackageVersion Include="NonBlocking" Version="2.1.2" />
    <PackageVersion Include="MemoryPack" Version="1.21.4" />
    <PackageVersion Include="MemoryPack.Core" Version="1.21.4" />
    <PackageVersion Include="CSharpFunctionalExtensions" Version="3.7.0" />
    <!-- ── MessagePack (cross-platform binary serialization for IPC) ───────── -->
    <!--
      MessagePack 3.1.12 is the last release of the 3.1.x line and carries 0
      advisories in the GitHub Advisory DB. The pin sat at 3.1.8, which is
      inside the affected range >= 3.0.0, < 3.1.9 of GHSA-qhrr-8q5h-9q3h
      (medium, NU1902/NU1903: nested arrays can blow past the buffer length
      limits). The advisory was invisible because NU1902/NU1903 were suppressed
      in the three Harbor.Ipc.* projects; that suppression is gone now, so the
      NuGet audit gate is live again in the IPC graph.
    -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <!-- ── SQLite native driver ──────────────────────────────────────────── -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- ── CLI parsing (sourcegen, AOT-first) ─────────────────────────────── -->
    <!--
      ConsoleAppFramework v5 (LB2 pilot, #1235): zero-dependency,
      zero-reflection CLI parser driven by an incremental source generator —
      the Run/Add methods (including help text) are emitted as static code,
      so the result is NativeAOT/trimming-safe. Spectre.Console.Cli and
      System.CommandLine are NOT used (AOT/trim issues — see issue body).
      Analyzer-only package: no runtime dll ships (PrivateAssets=all at the
      consumption site in apps/Harbor.App.Cli).
    -->
    <PackageVersion Include="ConsoleAppFramework" Version="5.7.13" />
    <!-- ── Source generators (PrivateAssets="all" at consumption site) ───── -->
    <PackageVersion Include="Termina.Generators" Version="0.15.0" />
    <!-- SG3 spike (issue 1244): ctor(ILogger) generation for the 8
         [AutoConstruct] tools in Harbor.Tools.Builtin. Pinned 4.0.2: the 4.x
         line adds a source-generated IoC container ([ServiceProvider]) that
         this repo does not use, and leaves the generated constructor shape
         alone — a public constructor over the readonly fields, in declaration
         order, which is what the tool registrations in ToolsCatalog assume.
         Every 4.x-only diagnostic (ACTR010-ACTR030) belongs to that IoC
         container and cannot fire without a [ServiceProvider] type. -->
    <PackageVersion Include="AutoCtor" Version="4.0.2" />
    <!-- ── NUKE build system ──────────────────────────────────────────── -->
    <!--
      NO Nuke.Common ENTRY HERE, ON PURPOSE.

      The NUKE version lives in build/_build.csproj, and only there. That
      project turns Central Package Management OFF for itself — the
      PropertyGroup in build/_build.csproj sets
      ManagePackageVersionsCentrally=false, and it is THAT copy that
      decides, not the one in build/Directory.Build.props: the SDK imports
      Directory.Build.props first and this file second, so a
      <PackageVersion> written here would never take part in the build
      project's restore. It would be dead text, and the comment beside it a
      second answer to "which NUKE do we build with?" that the build does
      not agree with. #1896 removed the dead entry and the contradiction
      that came with it.

      To change the NUKE version, change it in build/_build.csproj — and
      read the comment there first: the NUKE version decides the
      Microsoft.Build* floor beside it, and a stale floor is NU1605.
    -->
    <!-- ── DI analyzers ──────────────────────────────────────────────────── -->
    <!--
      DependencyInjection.Lifetime.Analyzers (DI001–DI037; 37 diagnostics)
      detects captive dependencies, lifetime mismatches, and circular DI
      graphs at compile time. Consumed solution-wide via Directory.Build.props
      so every project that references
      Microsoft.Extensions.DependencyInjection gets checked.

      VERSION 2.18.24 → 3.7.8 (#1897). This is the one package of the four
      whose move ADDS rules. DELTA, read out of the shipped analyzer
      assemblies (the ids are in the DLL's string heap; the titles and the
      shipped default severities are in the README the package ships):

        2.18.24 — 26 ids: DI001–DI022, DI024–DI027 (DI023 was unused)
        3.0.0   — 29 ids: + DI028, DI029, DI030
        3.5.20  — 35 ids: + DI023, DI031, DI032, DI033, DI034, DI035
        3.6.0   — 36 ids: + DI036
        3.7.0   — 37 ids: + DI037
        3.7.8   — 37 ids (same set; 3.7.8 is the DI013 behaviour fix)

      So the whole 2.18.24 → 3.7.8 gap is ELEVEN new ids (DI023, DI028–DI037)
      and ZERO removed. Each new id gets its own row in .editorconfig at the
      severity the package ships it with — see docs/ANALYZERS.md for the
      per-id decision and the reason. DI033's one finding (three
      registrations hand the container an instance it did not create, and the
      container does not dispose such an instance) is written off with a
      reason rather than silenced: the instances are pre-built on purpose,
      and the gap closes properly only with a shutdown seam the composition
      root does not have yet.

      Excubo.Analyzers.DependencyInjectionValidation (DIV0xx) provides
      `[Exposes(typeof(T))]` attribute validation: declares which services a
      composition root should register and fails build if any are missing.
      The matching Excubo.Analyzers.Annotations package contains the attribute.
    -->
    <PackageVersion Include="DependencyInjection.Lifetime.Analyzers" Version="3.7.8" />
    <PackageVersion Include="Excubo.Analyzers.DependencyInjectionValidation" Version="1.0.33" />
    <PackageVersion Include="Excubo.Analyzers.Annotations" Version="1.0.1" />
    <!-- Serilog — structured logging with file, console, and rolling sinks.
         Serilog.Extensions.Hosting 10.0.0 raises its Microsoft.Extensions.*
         floors to 10.0.0, which the Microsoft.Extensions.* band above
         (10.0.13) satisfies; its `UseSerilog`/`AddSerilog` surface is
         unchanged from 9.0.0 (the 10.0.0 release is the .NET 10 SDK and
         dependency refresh, not an API break). Serilog.Sinks.Console 6.1.1
         adds {UtcTimestamp} support and keeps the existing output template
         behaviour. -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <!-- ── Diff ──────────────────────────────────────────────────────────── -->
    <!--
      DiffPlex — line + word diff engine, pilot for #1236 (strictly outside
      the CellForge engine: consumed only by Harbor.Ui.Framework.State's
      DiffPlexPilot and the desktop/patch preview call sites it serves).
      1.9.0 per docs/FEATURE_RESEARCH.md + docs/DESKTOP_APP_PLAN.md. The
      1.7.2 -> 1.9.0 step is additive (three-way diff/merge plus a unidiff
      renderer); nothing the pilot calls was removed.
    -->
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <!-- ── Reference hygiene (#1853) ─────────────────────────────────────── -->
    <!--
      ReferenceTrimmer 3.5.13 (MIT) — a build-time analyzer that asks Roslyn
      which assemblies the compiled code actually uses, and reports the
      declared references that none of them reach:

        RT0001  a bare <Reference> the compiler never uses
        RT0002  a <ProjectReference> the compiler never uses
        RT0003  a <PackageReference> the compiler never uses

      It is NOT referenced by any project by default. The <PackageReference>
      that turns it on lives in /Directory.Build.props behind the
      `HarborReferenceTrimmer` property, and the CI job that sets the
      property is the `reference-trimmer` job in .github/workflows/ci.yml.
      The pin here exists so that Central Package Management has a version
      to resolve against when that job restores.

      The pin is a version catalogue entry, not a declared dependency: no
      project references the package outside that one job, so nothing in the
      dependency graph reaches it. tools/check-reference-trimmer.py is the
      gate; docs/REFERENCE-TRIMMER.md is the report.
    -->
    <PackageVersion Include="ReferenceTrimmer" Version="3.5.13" />
  </ItemGroup>
</Project>