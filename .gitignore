config.local.json

## Harbor runtime
.harbor/
~/.harbor/
*.session.jsonl
*.harbor-cache
runtime/

## Serena tooling
.serena/

## Build scripts / temp
*.tmp
*.bak
*.old
*.orig

## IDE-specific
*.iml
*.ipr
*.iws
.idea/
*.swp
*.swo

## Docs build
_site/
# api/ holds docfx BUILD OUTPUT (generated *.yml + toc.yml from the metadata
# lane in docfx.json) — except api/index.md, which is a hand-written landing
# page and the one tracked file in this directory (#431 D2).
api/*
!api/index.md

## E2E screenshots / test artifacts
docs/screenshots/
tests/**/docs/
e2e/

## Build artifacts
*.binlog
*.tsbuildinfo
*.received.*
.avalonia-build-tasks/
*.wpftmp.csproj
build/_build/Configuration/
BenchmarkDotNet.Artifacts/
.opencode/
.agent/
.agents/
.kilocode/
.ai-factory.json
opencode.json
/skills-lock.json
temp/
tmp/
assets/demo/frames/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# AI agents scratchpads & local session storage
.claude/
.devin/
.ai-factory/

# git worktrees (local clones, e.g. .worktrees/tunit-audit)
.worktrees/

# Python bytecode from the markdown gates in tools/ (issue #509) — md-lint.py
# and check-md-links.py import md_gate, so every run drops a __pycache__ here.
__pycache__/
*.pyc

# The golden lane writes the frame it just captured next to the baseline when
# the two differ, so a reviewer can diff the two files (issue #1795). It is a
# diagnostic, never a baseline — the goldens workflow does not commit it.
*.golden.txt.actual.txt

# The jscpd duplication scan writes its report next to the checkout, and the
# report is a measurement, never a baseline (issue #1847). The committed
# baseline is tools/jscpd-baseline.json.
jscpd-report.json

# The duplicate-test-body gate writes its groups next to the checkout when
# CI asks for the report (`--json-out test-dup-groups.json`), and the local
# runner asks for the same report so that the two commands agree. It is a
# diagnostic, never a baseline: the committed one is tools/test-dup-baseline.json.
test-dup-groups.json
