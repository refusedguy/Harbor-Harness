<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Plugins.Storage — concrete IPluginSource implementations.

    Backends:
      - FileSystemPluginSource        (reads .cs files from local directories)
      - InMemoryPluginSource          (tests + ephemeral plugins)
      - CompositePluginSource         (fan-in over multiple sources)
      - EmbeddedResourcePluginSource  (reads .cs from assembly resources)

    Depends only on Harbor.Plugins.Abstractions. Knows nothing about
    compilation, instantiation, registration, or hosting.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Plugins.Storage</PackageId>
    <Description>Harbor plugin storage backends — filesystem, in-memory, composite, embedded-resource IPluginSource implementations.</Description>
    <PackageTags>harbor;ai;agent;plugins;storage;filesystem</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Plugins.Abstractions\Harbor.Plugins.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
