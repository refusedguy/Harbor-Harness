<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Desktop.Abstractions — the config schema, models and enums shared by
    every Harbor desktop app (Avalonia, WPF, MAUI, Blazor).

    #1899: this assembly USED to hold the whole desktop UI layer — 46 public
    types, 9 project references, an 18-assembly dependency closure — under a
    name that promised a contract layer. It was a hub wearing a leaf's name.
    The split put the concrete view-models in `Harbor.Desktop.ViewModels`,
    and what is left here is the part the name always described: the config
    SCHEMA and its PORTS, the cross-view-model messages, and the shared
    models/enums. See docs/adr/ADR-021-desktop-abstractions-split.md.

    Dependency rule (enforced by Harbor.Architecture.Tests):
      ✅ Harbor.Abstractions.Contracts — ONE reference, and it is the innermost
         assembly in the repository: CommonConfig reads AgentName.Fallback
         (#716) and SessionDotState reads SessionStatus, both of which live
         there. The leaf's dependency closure is therefore TWO assemblies: this
         one and the contract leaf.
      ❌ NO Harbor.Abstractions / Harbor.Application / Harbor.Registries /
         Harbor.PolicyConfig — the #188 Presentation → Application edge (the
         ProviderPresets catalog, which #1625 moved out of Harbor.Application
         into Harbor.PolicyConfig) moved to Harbor.Desktop.ViewModels with the
         view-models that read it.
      ❌ NO Harbor.Ui.Framework.* / Harbor.Terminal.Abstractions — the
         view-model bases moved out with the view-models.
      ❌ NO Avalonia / WPF / MAUI / Blazor / WindowsBase / System.Drawing
      ❌ NO Harbor.Providers.* / Harbor.Storage.* / Harbor.Tools.* (Infrastructure)

    The config STORES are persistence and live in `Harbor.Hosting`
    (Harbor.Desktop.AbstractionsLeafTakesNoIoRules.cs guards that): the PORTS
    (IAppConfigStore<T>, ICommonConfigStore) and the DTOs (AppConfigBase,
    CommonConfig, CompositeConfig<T>) are here.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Desktop.Abstractions</PackageId>
    <Description>Harbor desktop abstractions — the shared configuration schema, config-store ports, cross-view-model messages and models/enums for Avalonia/WPF/MAUI/Blazor apps.</Description>
    <PackageTags>harbor;desktop;abstractions;mvvm;cross-platform</PackageTags>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- Meziantou MA0046 insists on EventArgs-derived payload types; we use
         EventHandler<T> with plain record payloads (ToastNotification, ThemeKind)
         which is intentional for the simple event contracts in this library. -->
    <NoWarn>$(NoWarn);MA0046</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- #1899: the ONE Harbor reference this leaf has. SessionStatus and
         AgentName both live in Harbor.Abstractions.Contracts, so the leaf
         points at the contract assembly directly rather than through the
         Harbor.Abstractions facade — which it does not use a single type of.
         The result is a two-assembly dependency closure. -->
    <ProjectReference Include="..\Harbor.Abstractions.Contracts\Harbor.Abstractions.Contracts.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- CommonConfig's XML doc names Microsoft.Extensions.Logging.LogLevel, so
         the reference has to stay or the cref does not resolve. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <!--
      CSharpFunctionalExtensions provides Result<T> used directly in the public
      IAppConfigStore<T> / ICommonConfigStore API surface (Configuration/).
      Pulled in transitively via Harbor.Abstractions too, but declaring it
      explicitly here keeps the contract stable if Harbor.Abstractions ever
      drops the dependency. #534: the JsonAppConfigStore<T> / JsonCommonConfigStore
      IMPLEMENTATIONS left this package, but both ports still return Result<T>, so
      the reference stays.
    -->
    <PackageReference Include="CSharpFunctionalExtensions"/>
  </ItemGroup>

</Project>
