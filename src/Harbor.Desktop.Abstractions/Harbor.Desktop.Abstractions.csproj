<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Desktop.Abstractions — UI-framework-agnostic contracts shared by
    every Harbor desktop app (Avalonia, WPF, MAUI, Blazor).

    Dependency rule (enforced by Harbor.Architecture.Tests):
      ✅ Harbor.Abstractions, Harbor.Core, Harbor.Tui.Abstractions
      ✅ CommunityToolkit.Mvvm (source-gen MVVM)
      ✅ Microsoft.Extensions.Logging.Abstractions
      ❌ NO Avalonia / WPF / MAUI / Blazor / WindowsBase / System.Drawing
      ❌ NO Harbor.Providers.* / Harbor.Storage.* / Harbor.Tools.* (Infrastructure)

    Platform VMs in apps/Harbor.App.* derive from the abstract VMs here and add
    platform-specific bindings (AvaloniaDispatcher, WPF Dispatcher, Blazor JSInterop).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Desktop.Abstractions</PackageId>
    <Description>Harbor desktop abstractions — shared interfaces, base view-models, design-system primitives for Avalonia/WPF/MAUI/Blazor apps.</Description>
    <PackageTags>harbor;desktop;abstractions;mvvm;cross-platform</PackageTags>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- Meziantou MA0046 insists on EventArgs-derived payload types; we use
         EventHandler<T> with plain record payloads (ToastNotification, ThemeKind)
         which is intentional for the simple event contracts in this library. -->
    <NoWarn>$(NoWarn);MA0046</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Core\Harbor.Core.csproj"/>
    <ProjectReference Include="..\Harbor.Tui.Abstractions\Harbor.Tui.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
