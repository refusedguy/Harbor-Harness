<Window x:Class="Harbor.Tui.Wpf.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Harbor.Tui.Wpf"
        Title="Harbor — AI Coding Agent"
        Height="720" Width="1100"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen"
        FontFamily="Cascadia Code, Consolas, Courier New"
        FontSize="13">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- Header -->
            <RowDefinition Height="*"/>        <!-- Chat history -->
            <RowDefinition Height="Auto"/>     <!-- Streaming indicator -->
            <RowDefinition Height="Auto"/>     <!-- Input box -->
            <RowDefinition Height="Auto"/>     <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Header: agent / model / provider -->
        <Border Grid.Row="0" Background="#181825" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🤖" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="AgentLabel" Text="agent" Foreground="#89B4FA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text=" · " Foreground="#6C7086" VerticalAlignment="Center"/>
                <TextBlock x:Name="ModelLabel" Text="model" Foreground="#A6E3A1" VerticalAlignment="Center"/>
                <TextBlock Text=" · " Foreground="#6C7086" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProviderLabel" Text="provider" Foreground="#F9E2AF" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Chat history -->
        <ListBox Grid.Row="1"
                 x:Name="HistoryList"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#CDD6F4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemsSource="{Binding Lines}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ChatLineViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Role}"
                                   Foreground="#6C7086"
                                   FontWeight="Bold"
                                   VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding Foreground}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Streaming indicator -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="4" Padding="8,3" Margin="0,6,0,0"
                x:Name="StreamingBar" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StreamingLabel" Text="● streaming" Foreground="#FAB387"/>
                <TextBlock x:Name="StreamingBuffer" Text="" Foreground="#6C7086" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="900"/>
            </StackPanel>
        </Border>

        <!-- Input box -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     x:Name="InputBox"
                     Background="#181825"
                     Foreground="#CDD6F4"
                     BorderBrush="#313244"
                     BorderThickness="1"
                     Padding="8,6"
                     KeyDown="InputBox_KeyDown"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="32"
                     MaxHeight="120"
                     VerticalScrollBarVisibility="Auto"/>
            <Button Grid.Column="1"
                    Content="Send (Ctrl+Enter)"
                    Background="#89B4FA"
                    Foreground="Black"
                    BorderThickness="0"
                    Padding="14,6"
                    Margin="6,0,0,0"
                    Click="SendButton_Click"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="#181825" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusLabel" Text="idle" Foreground="#A6ADC8"/>
                <TextBlock Grid.Column="1" x:Name="CostLabel" Text="0 in / 0 out / $0.0000" Foreground="#6C7086"/>
            </Grid>
        </Border>
    </Grid>
</Window>
