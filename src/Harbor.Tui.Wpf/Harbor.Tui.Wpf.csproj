<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Tui.Wpf</PackageId>
    <Description>Harbor TUI renderer — native Windows WPF chat window (XAML designer, hot reload, full GUI).</Description>
    <PackageTags>harbor;tui;wpf;windows;gui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Tui.Abstractions\Harbor.Tui.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0"/>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
  </ItemGroup>

</Project>
