<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Storage.Jsonl</PackageId>
    <Description>Harbor JSONL session storage backend.</Description>
    <PackageTags>harbor;storage;jsonl</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- §ARCH-003: Infrastructure references Domain (Harbor.Abstractions) ONLY. -->
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- #184: shared session-store source, linked like Harbor.Providers.Shared (no ProjectReference). -->
    <Compile Include="..\Harbor.Storage.Shared\SessionLockStrip.cs" LinkBase="Shared" />
    <Compile Include="..\Harbor.Storage.Shared\SessionStatsAggregator.cs" LinkBase="Shared" />
    <Compile Include="..\Harbor.Storage.Shared\SessionStoreErrors.cs" LinkBase="Shared" />
    <!-- #1591: the shared domain ↔ persist-form projection for message parts. -->
    <Compile Include="..\Harbor.Storage.Shared\MessagePartAdapter.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harbor.Storage.Jsonl.Tests"/>
    <InternalsVisibleTo Include="Harbor.Benchmarks"/>
    <!-- #1591: parity tests live next to the cross-store suites (they compare
         both backends' projections, so they need both). -->
    <InternalsVisibleTo Include="Harbor.Storage.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
