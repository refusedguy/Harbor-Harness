<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Tools.Builtin</PackageId>
    <!-- #1243 (SG2): [LibraryImport] source generator emits unsafe code for
         string marshalling — the flag covers generated code only; no `unsafe`
         keyword in hand-written sources (MA0046 still holds). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Harbor builtin tools — 14 tools (Read, Write, Edit, Bash, Grep, Glob, Ls, Task, WebFetch, Patch, Notebook, RipGrep, Tree, MCP) consolidated from the former 14 leaf projects into a single assembly.</Description>
    <PackageTags>harbor;tools;builtin;ai-agent</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Extensions\Harbor.Extensions.csproj"/>
    <!-- SG3 spike (issue 1244): ToolGlueGenerator consumed as an analyzer; no runtime edge. -->
    <ProjectReference Include="..\Harbor.CodeGen\Harbor.CodeGen.csproj">
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harbor.Tools.Builtin.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing"/>
    <!-- SG3 spike (issue 1244): generator packages are PrivateAssets=all only. -->
    <!--
      Proj0037 (#1857) wants ExcludeAssets=runtime on every PrivateAssets=all
      reference. A source generator that shipped a runtime assembly could not
      have its generated code depend on it — PrivateAssets=all means the
      assembly does not flow to the consumers of this library — so the runtime
      asset of AutoCtor is dead weight here and is excluded.
    -->
    <PackageReference Include="AutoCtor" PrivateAssets="all">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
