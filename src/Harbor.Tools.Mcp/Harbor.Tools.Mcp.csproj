<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    §ARCH-003: Infrastructure references Domain (Harbor.Abstractions) ONLY.
    McpToolTool resolves IMcpRegistry from ToolContext.Services at runtime;
    only the DI abstraction interface is needed (the InMemoryMcpRegistry
    implementation lives in Harbor.Core and is injected by the host).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
