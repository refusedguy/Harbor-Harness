@inject RazorConsoleTeaBridge Harbor
@inject IHostApplicationLifetime Lifetime
@using global::RazorConsole.Components
@using Microsoft.Extensions.Hosting
@using Harbor.Tui.RazorConsole.Views
@using Harbor.Ui.Framework.Projection
@using Harbor.Ui.Framework.State
@using System.Collections.Immutable
@using Spectre.Console
@using Markup = Spectre.Console.Markup
@using Panel = Spectre.Console.Panel
@using Rows = Spectre.Console.Rows
@implements IDisposable

<Rows>
    <Panel Title="@PanelTitle"
           TitleColor="@Color.Cyan1"
           BorderColor="@StatusColor"
           Expand="true">
        <ViewHeightScrollable LinesToRender="20">
            <Rows>
                @if (_lines.Count == 0 && !State.IsStreaming)
                {
                    <Markup Content="No messages yet - type below to start chatting."
                            Foreground="@Color.Grey"
                            Decoration="Decoration.Italic"/>
                }

                @foreach (var line in _lines)
                {
                    <Markup Content="@line" Foreground="@Color.Grey85"/>
                }

                @if (State.IsStreaming)
                {
                    @if (!string.IsNullOrWhiteSpace(State.Active.ThinkBuffer))
                    {
                        <Markup Content="@State.Active.ThinkBuffer.Trim()"
                                Foreground="@Color.Grey54"
                                Decoration="Decoration.Italic"/>
                    }

                    @if (!string.IsNullOrWhiteSpace(State.Active.TextBuffer))
                    {
                        <Markup Content="@State.Active.TextBuffer.Trim()"
                                Foreground="@Color.Grey85"/>
                    }
                    else if (string.IsNullOrWhiteSpace(State.Active.ThinkBuffer))
                    {
                        <Newline/>
                        <Markup Content="Harbor is thinking..."
                                Foreground="@Color.Grey"
                                Decoration="Decoration.Italic"/>
                    }
                }
            </Rows>
        </ViewHeightScrollable>
    </Panel>

    <TextInput @bind-Value="_input"
               Label=">"
               LabelColor="@Color.Green"
               Placeholder="Message Harbor..."
               PlaceholderColor="@Color.Grey"
               BorderColor="@Color.Grey"
               FocusedBorderColor="@Color.Cyan1"
               OnSubmit="Submit"
               Expand="true"/>

    <Markup Content="@_statusBar" Foreground="@Color.Grey"/>
</Rows>

@code {
private string _input = string.Empty;
private string _statusBar = string.Empty;
private IReadOnlyList<string> _lines = [];
    private readonly DefaultUiProjector _projector = new();

private UiState State => Harbor.Store.State;

private string PanelTitle =>
    $"Harbor · {State.AgentName} · {State.Provider}/{State.Model} · {State.Status}";

private Color StatusColor => State.Status switch
{
    "running" => Color.Cyan1,
    "compacting" => Color.Yellow,
    "error" => Color.Red,
    _ => Color.Grey
};

protected override void OnInitialized()
{
    Harbor.Store.Changed += OnStateChanged;
    ProjectState();
}

private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(() =>
{
    ProjectState();
    StateHasChanged();
});

private void ProjectState()
    {
        var screen = _projector.Project(Harbor.Store.State);
        var builder = ImmutableArray.CreateBuilder<string>();
        foreach (var line in screen.Transcript.RenderedLines)
        {
            var text = string.Join(string.Empty, line.Spans.Select(s => s.Text));
            builder.Add(text);
        }
        _lines = builder.ToImmutable();
        _statusBar = screen.Header.FooterText;

        if (State.ShouldQuit)
            Lifetime.StopApplication();
    }

private void Submit()
{
    var value = _input.Trim();
    _input = string.Empty;

    if (string.IsNullOrWhiteSpace(value))
        return;

    if (value is "exit" or "quit" or "q" or ":q")
    {
        Lifetime.StopApplication();
        return;
    }

    if (string.Equals(value, "/logs", StringComparison.OrdinalIgnoreCase))
    {
        Harbor.DumpDiagnostics();
        StateHasChanged();
        return;
    }

    Harbor.Submit(value);
    StateHasChanged();
}

public void Dispose()
{
    Harbor.Store.Changed -= OnStateChanged;
}
}
