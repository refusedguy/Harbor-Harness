<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Plugins.Compilation — concrete IPluginCompiler implementations.

    Implementations:
      - RoslynPluginCompiler    (compiles CS source in-memory via Roslyn)
      - CachingCompiler         (disk-cache decorator over any IPluginCompiler)
      - PluginAssemblyReferences (collects MetadataReference snapshot for Roslyn)

    Depends on Harbor.Plugins.Abstractions (for IPluginCompiler,
    PluginScript, CompiledPluginAssembly).
    Pulls in Microsoft.CodeAnalysis.CSharp for the Roslyn implementation.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Plugins.Compilation</PackageId>
    <Description>Harbor plugin compilation — Roslyn-based IPluginCompiler and disk-caching decorator.</Description>
    <PackageTags>harbor;ai;agent;plugins;roslyn;compilation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Plugins.Abstractions\Harbor.Plugins.Abstractions.csproj"/>
    <!--
      Harbor.Abstractions.Contracts is needed explicitly so PluginAssemblyReferences can
      call typeof(Harbor.Abstractions.Models.Session).Assembly at construction
      time. Without this ProjectReference, the call would still work at runtime
      (Harbor.Abstractions.Contracts is loaded transitively via Harbor.Abstractions), but the
      compiler needs a direct reference to allow the static type lookup in
      RoslynPluginCompiler's host code.
    -->
    <ProjectReference Include="..\Harbor.Abstractions.Contracts\Harbor.Abstractions.Contracts.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <!-- #1004: PluginReferenceContractTests reads PluginContractAssemblies to assert the
         declared plugin contract surface is resolved BY NAME rather than inherited from
         ambient load state. Internal, so the published API of this package is unchanged. -->
    <InternalsVisibleTo Include="Harbor.Plugins.Runtime.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
