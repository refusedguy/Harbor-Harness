<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Plugins.Compilation — concrete IPluginCompiler implementations.

    Implementations:
      - RoslynPluginCompiler    (compiles CS source in-memory via Roslyn)
      - CachingCompiler         (disk-cache decorator over any IPluginCompiler)
      - PluginAssemblyReferences (collects MetadataReference snapshot for Roslyn)

    Depends on Harbor.Plugins.Abstractions (for IPluginCompiler,
    PluginScript, CompiledPluginAssembly, CompilationResult).
    Pulls in Microsoft.CodeAnalysis.CSharp for the Roslyn implementation.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Plugins.Compilation</PackageId>
    <Description>Harbor plugin compilation — Roslyn-based IPluginCompiler and disk-caching decorator.</Description>
    <PackageTags>harbor;ai;agent;plugins;roslyn;compilation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Plugins.Abstractions\Harbor.Plugins.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
