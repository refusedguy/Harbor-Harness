<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Desktop.ViewModels — the concrete desktop UI layer.

    It was `Harbor.Desktop.Abstractions/ViewModels/` until #1899, in an
    assembly whose name promised a contract layer and which held 9 project
    references and a 18-assembly closure. #1899 split that assembly at the
    measured dependency seam: the contracts, models and enums stayed in
    `Harbor.Desktop.Abstractions` (now a real leaf — one Harbor reference),
    and the concrete view-models moved here, under a name that says what they
    are. See docs/adr/ADR-020-desktop-abstractions-split.md.

    Dependency rule (enforced by Harbor.Architecture.Tests):
      ✅ Harbor.Abstractions
      ✅ Harbor.Desktop.Abstractions — the config schema, models and enums
         this layer's view-models bind (CommonConfig, ICommonConfigStore,
         SessionDotState, …)
      ✅ Harbor.Ui.Framework.{ViewModels,State,Services,Sessions,Rendering}
      ✅ Harbor.Application — documented exception (#188, part of #96):
         ProviderPresets catalog used by ProviderModelPickerViewModel /
         OnboardingViewModel (Presentation → Application tech debt;
         future fix: move preset catalog to Domain Harbor.Abstractions)
      ❌ NO Avalonia / WPF / MAUI / Blazor / WindowsBase / System.Drawing
      ❌ NO Harbor.Providers.* / Harbor.Storage.* / Harbor.Tools.* (Infrastructure)

    Platform VMs in apps/Harbor.App.* derive from the abstract VMs here and add
    platform-specific bindings (AvaloniaDispatcher, WPF Dispatcher, Blazor JSInterop).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Desktop.ViewModels</PackageId>
    <Description>Harbor desktop view-models — the concrete desktop UI layer (chat, onboarding, provider pickers, diff, command palette) shared by the Avalonia desktop app.</Description>
    <PackageTags>harbor;desktop;viewmodels;mvvm;cross-platform</PackageTags>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- Meziantou MA0046 insists on EventArgs-derived payload types; we use
         EventHandler<T> with plain record payloads (ToastNotification, ThemeKind)
         which is intentional for the simple event contracts in this library. -->
    <NoWarn>$(NoWarn);MA0046</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <!-- #1899: the config schema, models and enums this layer binds live in
         the sibling leaf, which is why the leaf stays a leaf (one Harbor
         reference) and this layer is the one that carries the Presentation
         dependency surface. -->
    <ProjectReference Include="..\Harbor.Desktop.Abstractions\Harbor.Desktop.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Application\Harbor.Application.csproj"/>
    <ProjectReference Include="..\Harbor.Ui.Framework.ViewModels\Harbor.Ui.Framework.ViewModels.csproj"/>
    <ProjectReference Include="..\Harbor.Ui.Framework.State\Harbor.Ui.Framework.State.csproj"/>
    <ProjectReference Include="..\Harbor.Ui.Framework.Services\Harbor.Ui.Framework.Services.csproj"/>
    <ProjectReference Include="..\Harbor.Ui.Framework.Sessions\Harbor.Ui.Framework.Sessions.csproj"/>
    <!-- #679: the desktop DiffViewModel and DiffViewModelBase read the diff
         algorithm and the diff-format parsers from the core
         (Harbor.Ui.Framework.Rendering.Widgets) instead of each re-deriving a
         diff by index and re-sniffing the format by string literal.
         Presentation to Presentation, which conforms. -->
    <ProjectReference Include="..\Harbor.Ui.Framework.Rendering\Harbor.Ui.Framework.Rendering.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <!--
      CSharpFunctionalExtensions provides Result<T> used directly in the public
      IAppConfigStore<T> / ICommonConfigStore API surface (Configuration/).
      Pulled in transitively via Harbor.Abstractions too, but declaring it
      explicitly here keeps the contract stable if Harbor.Abstractions ever
      drops the dependency. #534: the JsonAppConfigStore<T> / JsonCommonConfigStore
      IMPLEMENTATIONS left the Harbor.Desktop.Abstractions package, but both
      ports still return Result<T>, so the reference stays.
    -->
    <PackageReference Include="CSharpFunctionalExtensions"/>
  </ItemGroup>

</Project>
