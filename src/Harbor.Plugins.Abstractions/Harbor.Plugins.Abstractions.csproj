<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Plugins.Abstractions — contracts shared across the plugin pipeline.

    Contains the leaf-level interfaces and data types referenced by every
    Harbor.Plugins.* layer:
      - IPluginSource            (storage contract)
      - IPluginCompiler          (compilation contract)
      - IPluginInstantiator      (instantiation contract)
      - IPluginRegistrar         (registration contract)
      - IPluginLoadHost          (host-side sink called by the registrar)
      - PluginScript             (immutable wrapper around a single .cs source file)
      - CompiledPluginAssembly   (loaded assembly + source hash)
      - LoadedPlugin             (live IPlugin instance + metadata)

    Dependency policy (Clean Architecture):
      - References Harbor.Abstractions (Domain) only — never Harbor.Application / Harbor.Registries.
      - References Harbor.Terminal.Abstractions for the panel/TUI-plugin contracts
        surfaced on IPluginLoadHost (registration sink).
      - Microsoft.CodeAnalysis.CSharp is still referenced but no longer used: the only
        Diagnostic in this project's API was the `IReadOnlyList<Diagnostic>` member of the
        hand-rolled CompilationResult, which #561 deleted — the compiler contract now returns
        Result<CompiledPluginAssembly> and renders diagnostics into the error string. The
        PackageReference is left in place deliberately (this project is packable, so dropping a
        transitive dependency is a packaging change that wants its own PR) but the reference is
        dead weight and is a known follow-up.

    See docs/PLUGIN_SYSTEM.md and docs/ARCHITECTURE_LAYERS.md for the full
    layer diagram.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Plugins.Abstractions</PackageId>
    <Description>Harbor plugin pipeline contracts — interfaces and data types shared across all plugin layers.</Description>
    <PackageTags>harbor;ai;agent;plugins;abstractions;contracts</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Terminal.Abstractions\Harbor.Terminal.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
  </ItemGroup>

</Project>
