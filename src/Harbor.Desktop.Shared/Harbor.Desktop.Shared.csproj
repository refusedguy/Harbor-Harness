<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Desktop.Shared — cross-platform implementations built on top of
    Harbor.Desktop.Abstractions. No UI-framework references; depends on Markdig
    (already used by every desktop app).

    Dependency rule (enforced by Harbor.Architecture.Tests):
      ✅ Harbor.Desktop.Abstractions
      ✅ Markdig (for MarkdownToPlainTextService)
      ❌ NO Avalonia / WPF / MAUI / Blazor
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Desktop.Shared</PackageId>
    <Description>Harbor desktop shared — cross-platform services and command catalogs for Avalonia/WPF/MAUI/Blazor apps.</Description>
    <PackageTags>harbor;desktop;shared;cross-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Desktop.Abstractions\Harbor.Desktop.Abstractions.csproj"/>
    <!-- Locators/IShowPlaceholderFactory references IOverlayStack (Ui.Framework.Services). -->
    <ProjectReference Include="..\Harbor.Ui.Framework\Harbor.Ui.Framework.csproj"/>
    <!-- #462: Commands/SlashCommands projects the single slash-command registry
         (SlashCommandCatalog) instead of keeping a private copy that drifted from
         the CLI dispatcher. Domain edge, rule-conforming. -->
    <ProjectReference Include="..\Harbor.Ui.Framework.Abstractions\Harbor.Ui.Framework.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <!-- #754: Microsoft.Extensions.Logging.Abstractions was dropped. Its only
         consumer was Services/RecentItemsService, deleted by #535; no file in this
         assembly named a logging type afterwards. Nothing needs it at build time
         (the public surface exposes no logging type and there is no generator here)
         and nothing needed it at run time either — the package was already
         transitive via Harbor.Desktop.Abstractions and Harbor.Ui.Framework.Abstractions,
         both ProjectReferences below. -->
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
