<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <!-- Packable library: remote UI transport (PSK gateway + client over HTTP/SSE). (#429) -->
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Transport.Remote</PackageId>
    <Description>Harbor remote UI transport — PSK-authenticated gateway and client that stream AgentEvents over HTTP/SSE so a desktop GUI can control a headless session.</Description>
    <PackageTags>harbor;transport;remote;http;sse;gateway</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj" />
  </ItemGroup>

</Project>
