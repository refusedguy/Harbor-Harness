<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Lsp</PackageId>
    <Description>Harbor LSP client — auto-spawned out-of-process language servers (TypeScript, Python, Go, Rust, C#) over stdio JSON-RPC, diagnostics/definition/references for the editor and the agent tools. AOT-safe (source-generated JSON).</Description>
    <PackageTags>harbor;lsp;language-server;diagnostics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <!-- §ARCH: Infrastructure references Domain (Harbor.Abstractions) ONLY. -->
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
  </ItemGroup>

</Project>
