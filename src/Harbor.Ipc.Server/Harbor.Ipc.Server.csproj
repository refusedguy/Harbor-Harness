<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Ipc.Server — hosts the AgentLoop + registries and exposes them
    via MessagePack RPC over Named Pipe (Windows) / Unix Domain Socket
    (Linux/Mac). Used when HARBOR_MODE=ipc-server.

    Layer: Infrastructure — IPC endpoint adapter over the agent harness.
    Depends on:
      * Harbor.Ipc.Abstractions — protocol contract.
      * Harbor.Abstractions — Domain service interfaces (IAgent,
        IAgentRegistry, ISessionStore, IEventBus, Compaction*Event).
    The server resolves application-layer services via IServiceProvider at
    request-dispatch time, so it needs no static dependency on
    Harbor.Application / Harbor.Registries or any Infrastructure project.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Ipc.Server</PackageId>
    <Description>Harbor IPC server — hosts AgentLoop + registries and exposes them via MessagePack RPC over Named Pipe / Unix Domain Socket. Used when HARBOR_MODE=ipc-server.</Description>
    <PackageTags>harbor;ipc;server;messagepack;rpc;named-pipe;unix-socket</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);MPK0002;MPK0003;MPK0004;NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Ipc.Abstractions\Harbor.Ipc.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
