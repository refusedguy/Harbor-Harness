<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Tui.AnsiPlain</PackageId>
    <Description>Harbor TUI — unified streaming renderer for ANSI terminals and plain-text pipes/CI. One renderer, two escape-code strategies (ANSI SGR / none). AOT-compatible. Merges the former Harbor.Tui.Ansi and Harbor.Tui.Plain backends (renderer-unification sprint Phase 4).</Description>
    <PackageTags>harbor;tui;ansi;plain</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Terminal.Abstractions\Harbor.Terminal.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time only: the analyzer generates EscapeCodes.g.cs from the
         [TerminalEscape] enums in EscapeCodes/TerminalVocabularies.cs. -->
    <ProjectReference Include="..\Harbor.CodeGen\Harbor.CodeGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Shared-source attribute surface for the Harbor.CodeGen generators
         (matched by fully-qualified metadata name, no assembly reference). -->
    <Compile Include="..\Harbor.CodeGen\Attributes\HarborCodeGenAttributes.cs"
             Link="CodeGen\HarborCodeGenAttributes.cs"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
