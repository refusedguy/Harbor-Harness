<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Scripting</PackageId>
    <Description>
      Harbor scripting — layered plugin host: engines (SharpTS subprocess + Jint in-process),
      storage (filesystem / in-memory), compilation (passthrough / tsc), hosting (orchestrator),
      bridge (Harbor global + ScriptTool adapter). SharpTS is the default engine.
    </Description>
    <PackageTags>harbor;scripting;sharpts;jint;typescript;plugins;interpreter</PackageTags>
  </PropertyGroup>

  <!--
    Layering (see docs/SCRIPTING.md):
      Engines/      — pure: given code + options + globals, evaluate. Knows nothing about filesystem.
      Storage/      — pure: list/read/write script files. Knows nothing about engines.
      Compilation/  — pure: source -> compiled form. Knows nothing about engines or storage.
      Hosting/      — orchestrator: the ONLY layer that depends on all three above.
      Bridge/       — what scripts see (the `Harbor` global); depends only on Harbor.Abstractions.

    Engine choices:
      SharpTS (default) — https://github.com/nickna/SharpTS, MIT, .NET 10, native TS interpreter.
                          Shipped as a `dotnet tool` (NuGet package type DotnetTool), so we run
                          scripts in a `sharpts` subprocess. Install with: `dotnet tool install -g SharpTS`.
                          When `sharpts` is not on PATH, the engine returns a clear failure and the
                          host can fall back to the Jint engine.
      Jint (fallback)   — in-process pure-.NET ECMAScript 2020+ interpreter. AOT-friendly.
                          Supports .ts files only via the TscCompiler (shells out to `tsc`).

    The IScriptEngine abstraction is the seam — call sites never depend on a concrete engine.
  -->
  <ItemGroup>
    <PackageReference Include="Jint" Version="4.4.1"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0"/>
    <!-- CSharpFunctionalExtensions (Result<T>) is transitive via Harbor.Abstractions;
         re-declared here for direct visibility in this project. -->
    <PackageReference Include="CSharpFunctionalExtensions" Version="3.7.0"/>
  </ItemGroup>

  <ItemGroup>
    <!-- §ARCH-004: Scripting is Application layer. It references Domain (Harbor.Abstractions)
         ONLY — never Harbor.Core (Application projects must not reference each other),
         never Infrastructure. The previous Harbor.Core reference was vestigial. -->
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
  </ItemGroup>

</Project>
