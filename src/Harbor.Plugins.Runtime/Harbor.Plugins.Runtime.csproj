<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Plugins.Runtime — THIN FACADE.

    This project is kept for backward compatibility only. It contains:
      - CsPluginLoader          ([Obsolete] wrapper around PluginHostBuilder/PluginHost)
      - CompiledPlugin          (legacy record type returned by CsPluginLoader)
      - PluginCompilationResult (legacy result struct)

    New code should depend on the layered projects directly:
      Harbor.Plugins.Abstractions / Storage / Compilation / Instantiation /
      Registration / Hosting.

    The facade will be removed in v0.5. See docs/PLUGIN_SYSTEM.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Plugins.Runtime</PackageId>
    <Description>Harbor plugin runtime — backward-compat facade over Harbor.Plugins.Hosting.</Description>
    <PackageTags>harbor;ai;agent;plugins;runtime;facade</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Facade depends on Hosting (which transitively pulls in Abstractions,
         Storage, Compilation, Instantiation, Registration). -->
    <ProjectReference Include="..\Harbor.Plugins.Hosting\Harbor.Plugins.Hosting.csproj"/>
    <!--
      #450: the former reference to Harbor.Terminal.Abstractions is GONE. It was
      declared on the assumption that CsPluginLoader.cs names
      Harbor.Terminal.Abstractions.Plugins.ITuiPlugin, but no file in this
      project referenced it — Roslyn therefore emitted no AssemblyRef, so every
      IL-based layering rule was blind to the edge and it silently rotted here.
      EnforcerIntegrityTests.DeclaredProjectReferences_AreJustifiedByTheMatrix
      now checks the csproj itself, so a declared-but-unjustified edge fails
      instead of hiding.
    -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
