<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Scripting.Engines — concrete IScriptEngine implementations.

    Implementations:
      - SharpTsScriptEngine  (default; shells out to `sharpts` subprocess for native TS)
      - JintScriptEngine     (fallback; in-process ECMAScript via Jint, AOT-friendly)
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Scripting.Engines</PackageId>
    <Description>Harbor script engines — SharpTS subprocess (default) and Jint in-process (fallback) IScriptEngine implementations.</Description>
    <PackageTags>harbor;scripting;engines;sharpts;jint</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Scripting.Abstractions\Harbor.Scripting.Abstractions.csproj"/>
    <!-- Bridge is needed for ScriptGlobals reference. -->
    <ProjectReference Include="..\Harbor.Scripting.Bridge\Harbor.Scripting.Bridge.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
