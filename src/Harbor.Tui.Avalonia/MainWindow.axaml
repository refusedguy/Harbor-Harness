<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Harbor.Tui.Avalonia"
        x:Class="Harbor.Tui.Avalonia.MainWindow"
        Title="Harbor — AI Coding Agent"
        Width="1100" Height="720"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen"
        FontFamily="Cascadia Code, JetBrains Mono, IBM Plex Mono, Menlo, Consolas">

    <Grid Margin="8" RowDefinitions="Auto,*,Auto,Auto,Auto">

        <!-- Header: agent / model / provider -->
        <Border Grid.Row="0" Background="#181825" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🤖" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Name="AgentLabel" Text="agent" Foreground="#89B4FA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text=" · " Foreground="#6C7086" VerticalAlignment="Center"/>
                <TextBlock Name="ModelLabel" Text="model" Foreground="#A6E3A1" VerticalAlignment="Center"/>
                <TextBlock Text=" · " Foreground="#6C7086" VerticalAlignment="Center"/>
                <TextBlock Name="ProviderLabel" Text="provider" Foreground="#F9E2AF" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Chat history -->
        <ListBox Grid.Row="1"
                 Name="HistoryList"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#CDD6F4">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ChatLineViewModel">
                    <Grid Margin="0,2" ColumnDefinitions="90,*">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Role}"
                                   Foreground="#6C7086"
                                   FontWeight="Bold"
                                   VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding ForegroundHex}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Streaming indicator -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="4" Padding="8,3" Margin="0,6,0,0"
                Name="StreamingBar" IsVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="StreamingLabel" Text="● streaming" Foreground="#FAB387"/>
                <TextBlock Name="StreamingBuffer" Text="" Foreground="#6C7086" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="900"/>
            </StackPanel>
        </Border>

        <!-- Input -->
        <Grid Grid.Row="3" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Name="InputBox"
                     Background="#181825"
                     Foreground="#CDD6F4"
                     BorderBrush="#313244"
                     BorderThickness="1"
                     Padding="8,6"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="32"
                     MaxHeight="120"
                     KeyDown="InputBox_KeyDown"/>
            <Button Grid.Column="1"
                    Content="Send (Ctrl+Enter)"
                    Background="#89B4FA"
                    Foreground="Black"
                    BorderThickness="0"
                    Padding="14,6"
                    Margin="6,0,0,0"
                    Click="SendButton_Click"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="#181825" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Name="StatusLabel" Text="idle" Foreground="#A6ADC8"/>
                <TextBlock Grid.Column="1" Name="CostLabel" Text="0 in / 0 out / $0.0000" Foreground="#6C7086"/>
            </Grid>
        </Border>
    </Grid>
</Window>
