<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Domain — pure domain layer.

    Contains: Session/Messages/Identifiers value objects, AgentEvent discriminated
    unions, PermissionRuleset domain logic, MemoryPack formatters.

    Zero Harbor project references. Only NuGet dependencies:
      - CSharpFunctionalExtensions  (ValueObject base class for identifiers)
      - MemoryPack                  (binary serialization for [MemoryPackable] types)

    Namespaces preserved as Harbor.Abstractions.{Models,Events,Permissions,Models.Identifiers}
    so consumer code (Harbor.Application, Harbor.Registries, Harbor.Providers.*,
    Harbor.Storage.*, Harbor.Tui.*) requires zero changes — they all keep
    `using Harbor.Abstractions.Models;` etc. and pick up the types transitively
    via the Harbor.Abstractions facade project.

    See README.md for the architectural rationale.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Domain</PackageId>
    <Description>Harbor domain layer — pure models, value objects, events, permission rules. Zero Harbor project dependencies.</Description>
    <PackageTags>harbor;ai;agent;domain;models</PackageTags>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Harbor.Abstractions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSharpFunctionalExtensions"/>
    <PackageReference Include="MemoryPack"/>
  </ItemGroup>

</Project>
