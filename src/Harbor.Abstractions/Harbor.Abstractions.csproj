<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Abstractions — THIN FACADE.

    After the round-6 architecture split, this project contains ONLY:
      - Interface contracts (Tools, Providers, Sessions, Agents, Events, Tui,
        Plugins namespaces)
      - ZLinqDropInAssemblyAttribute (assembly-level source generator config)
      - GlobalUsings.cs

    Domain models, value objects, events, and permission rules live in
    Harbor.Domain. Infrastructure helpers (ArrayPool, StringBuilderPool,
    FrozenSet materializers, MemoryPack round-trip helpers) live in
    Harbor.Extensions — consumers that need the pool helpers reference
    Harbor.Extensions DIRECTLY (the facade does not re-export them).

    The split enforces a cleaner Clean Architecture dependency direction:

        Harbor.Domain       → Harbor.Abstractions.Contracts only
        Harbor.Extensions   → 0                (pure BCL + NuGet helpers)
        Harbor.Abstractions → Harbor.Domain    (interfaces reference domain types)

    All existing namespaces are preserved in the moved files (e.g. files in
    Harbor.Domain/Models still declare `namespace Harbor.Abstractions.Models;`),
    so `using Harbor.Abstractions.Models;` continues to resolve.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Abstractions</PackageId>
    <Description>Harbor abstractions — interface contracts (tools, providers, sessions, agents, events, plugins). References Harbor.Domain (models) transitively.</Description>
    <PackageTags>harbor;ai;agent;abstractions;interfaces</PackageTags>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Facade: pull in the domain models the interfaces reference. Pool helpers
    (Harbor.Extensions) are NOT re-exported — direct consumers add their own
    reference, so `using Harbor.Abstractions.Extensions;` keeps resolving.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harbor.Domain\Harbor.Domain.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CSharpFunctionalExtensions"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
    <PackageReference Include="CommunityToolkit.HighPerformance"/>
    <PackageReference Include="MemoryPack"/>
    <PackageReference Include="ZLinq"/>
    <!--
      ZLinq.DropInGenerator emits source-generated extension methods that take
      priority over System.Linq's. Combined with `<Using Remove="System.Linq" />`
      below, this makes every LINQ call site in Harbor.Abstractions resolve to
      ZLinq's zero-allocation pipeline without rewriting call sites.
    -->
    <PackageReference Include="ZLinq.DropInGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    ZLinq replaces System.Linq throughout Harbor.Abstractions.
    The implicit "System.Linq" using injected by the SDK is removed here so
    that all LINQ operators resolve to ZLinq's zero-allocation equivalents
    without producing ambiguity errors.
  -->
  <ItemGroup>
    <Using Remove="System.Linq"/>
  </ItemGroup>

</Project>
