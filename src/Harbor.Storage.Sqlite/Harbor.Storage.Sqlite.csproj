<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Storage.Sqlite</PackageId>
    <Description>Harbor SQLite session storage backend — efficient queries, indexed.</Description>
    <PackageTags>harbor;storage;sqlite</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- §ARCH-003: Infrastructure references Domain (Harbor.Abstractions) ONLY. -->
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- #184: shared session-store source, linked like Harbor.Providers.Shared (no ProjectReference). -->
    <Compile Include="..\Harbor.Storage.Shared\SessionLockStrip.cs" LinkBase="Shared" />
    <Compile Include="..\Harbor.Storage.Shared\SessionStoreErrors.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harbor.Storage.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite"/>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
