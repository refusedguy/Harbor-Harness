<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Abstractions.Contracts — pure contract layer.

    Contains the domain types that appear in Harbor.Abstractions interface
    signatures: Session/Messages/Identifiers value objects, AgentEvent
    discriminated unions, PermissionRuleset (+ BashArgMatcher), MemoryPack
    formatters. Formerly Harbor.Domain (deleted in the F1 decoupling).

    Zero Harbor project references. Only NuGet dependencies:
      - CSharpFunctionalExtensions  (ValueObject base class for identifiers)
      - MemoryPack                  (binary serialization for [MemoryPackable] types)

    Namespaces preserved as Harbor.Abstractions.{Models,Events,Permissions,
    Models.Identifiers} so consumer code requires zero changes — they all keep
    `using Harbor.Abstractions.Models;` etc. and pick up the types transitively
    via the Harbor.Abstractions facade project.

    Layering (see docs/adr/ADR-007 and AbstractionsSplitLayerRules.cs):
      Harbor.Abstractions.Contracts -> 0        (pure data + rules)
      Harbor.Extensions              -> 0        (pure BCL/NuGet helpers)
      Harbor.Abstractions            -> Contracts only (interface signatures)
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Abstractions.Contracts</PackageId>
    <Description>Harbor contracts layer — pure models, value objects, events, permission rules referenced by abstraction interfaces. Zero Harbor project dependencies.</Description>
    <PackageTags>harbor;ai;agent;contracts;models</PackageTags>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Harbor.Abstractions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSharpFunctionalExtensions"/>
    <PackageReference Include="MemoryPack"/>
  </ItemGroup>

  <!--
    #1845: the public-API freeze of #428 moves from a 607-line python text
    scan (tools/check-public-api.py, deleted by that issue) to the COMPILER's
    symbol table. Microsoft.CodeAnalysis.PublicApiAnalyzers reads the public
    surface off the semantic model, so it sees what a line scan cannot:
    generic arity, protected-internal / private-protected, explicit interface
    implementations, ref/out/in/params, parameter default values,
    readonly/record structs, init accessors, and — the class the old gate had
    none of — NULLABILITY (RS0036/RS0037/RS0041). This assembly is the one
    third parties consume from NuGet, so a signature change here is a
    breaking change for them and the gate has to be exact.

    The baseline is the analyzer's own format:
      src/Harbor.Abstractions.Contracts/PublicAPI.Shipped.txt   (frozen)
      src/Harbor.Abstractions.Contracts/PublicAPI.Unshipped.txt (pending)
    Both are picked up as analyzer additional files by the package's own
    buildTransitive targets, so nothing has to list them here.

    Analyzer-only: PrivateAssets=all keeps it out of the NuGet package, and
    IncludeAssets hands the compiler the analyzer and nothing else — no
    runtime assembly, no AOT surface, no consumer impact.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    #1845: the five public-API rules the analyzer does NOT report at a symbol.
    RS0017 (a declared API symbol that is not in the code), RS0024 and RS0025
    (an invalid or a duplicated baseline) and RS0050 (a removal marker that
    disagrees with the code) are reported INSIDE PublicAPI.*.txt, and RS0048
    (a missing API file) is reported at no location at all. Roslyn applies a
    per-rule `.editorconfig` severity only to a diagnostic whose location has
    a syntax tree, so those five cannot be configured there — a row for them
    in `.editorconfig` would read like policy and reach nothing.

    `WarningsAsErrors` is the mechanism that does reach them: the compiler
    applies it to a diagnostic by its id wherever the diagnostic is reported.
    The list is the two frozen assemblies' own, and the six rules reported at
    a symbol are configured in `.editorconfig` instead, where they can be.
  -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0017;RS0024;RS0025;RS0048;RS0050</WarningsAsErrors>
  </PropertyGroup>

</Project>
