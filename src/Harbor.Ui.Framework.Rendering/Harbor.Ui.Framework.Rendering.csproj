<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Ui.Framework.Rendering</PackageId>
    <Description>Harbor UI framework — renderer-agnostic shared layer: cell/screen primitives (Cell, CellStyle, ScreenBuffer, Rect), input vocabulary (KeyEvent/KeyCode) and reusable chat widgets (StatusViewModel, DiffBlock + UnifiedDiffParser, ApprovalGateView, streaming markdown). BCL-only, AOT-compatible.</Description>
    <PackageTags>harbor;ui;tui;rendering;cell-diff;markdown</PackageTags>
    <!-- Shared primitives must stay trim/AOT-clean: zero IL2xxx warnings at build time. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Ui.Framework.Projection\Harbor.Ui.Framework.Projection.csproj"/>
    <ProjectReference Include="..\Harbor.DesignSystem\Harbor.DesignSystem.csproj"/>
    <ProjectReference Include="..\Harbor.Desktop.Animations\Harbor.Desktop.Animations.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- CellForge-class renderers consume the zero-alloc fast paths
         (ScreenBuffer row-hash internals, BlockMath, StreamingMarkdownRenderer
         .RenderRange) across the assembly boundary by design. -->
    <InternalsVisibleTo Include="Harbor.Tui.CellForge"/>
    <InternalsVisibleTo Include="Harbor.Tui.CellForge.Tests"/>
  </ItemGroup>

</Project>
