<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- S3267 (loop → LINQ) is downgraded because the loop in RipGrepTool
         is intentionally written as a foreach for clarity; converting to
         LINQ would obscure the file-system walk semantics. -->
    <NoWarn>$(NoWarn);S3267</NoWarn>
  </PropertyGroup>

  <!--
    §ARCH-003: Infrastructure references Domain (Harbor.Abstractions) ONLY.
    This is one of 14 leaf tool projects split out of the Harbor.Tools.Builtin
    god-project. The facade (Harbor.Tools.Builtin) still references all 14
    leaves so consumers of the old single-project API keep compiling.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
