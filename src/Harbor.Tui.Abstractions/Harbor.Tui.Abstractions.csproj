<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Tui.Abstractions — THIN BACKWARD-COMPAT FACADE.

    This project is kept ONLY so existing `ProjectReference` entries pointing at
    `Harbor.Tui.Abstractions.csproj` continue to build during the R6 rename
    transition. The actual code lives in two new split projects:

      - Harbor.Ui.Framework            (TEA state machine + dockable panel system
                                        — used by terminal TUIs AND desktop GUIs)
      - Harbor.Terminal.Abstractions   (terminal-specific renderer / view /
                                        view-model / plugin contracts + GFM
                                        table rendering)

    Dependency direction (transitive):
      Harbor.Tui.Abstractions  →  Harbor.Ui.Framework  →  Harbor.Abstractions
                              →  Harbor.Terminal.Abstractions  →  Harbor.Ui.Framework
                                                            →  Harbor.Abstractions

    BREAKING CHANGE: all `using` directives that previously wrote
    `Harbor.Tui.Abstractions.State` now write `Harbor.Ui.Framework.State`;
    `Harbor.Tui.Abstractions.Panels` now writes `Harbor.Ui.Framework.Panels`;
    `Harbor.Tui.Abstractions` (terminal types at the root) and the
    `Renderers` / `Views` / `ViewModels` / `Plugins` / `Rendering` sub-namespaces
    now write `Harbor.Terminal.Abstractions[.<sub>]`. C# does not support
    namespace aliases via `GlobalUsings`, so consumers MUST update their
    `using` directives — the facade only keeps ProjectReferences working.

    New code should depend on the split projects directly. This facade will be
    removed in v0.6. See Task A2 (R6) in /home/z/my-project/worklog.md and
    docs/ARCHITECTURE_LAYERS.md §2.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Tui.Abstractions</PackageId>
    <Description>Harbor TUI abstractions — backward-compat facade over Harbor.Ui.Framework + Harbor.Terminal.Abstractions. Will be removed in v0.6.</Description>
    <PackageTags>harbor;tui;abstractions;facade;deprecated</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Ui.Framework\Harbor.Ui.Framework.csproj"/>
    <ProjectReference Include="..\Harbor.Terminal.Abstractions\Harbor.Terminal.Abstractions.csproj"/>
  </ItemGroup>

</Project>
