<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn components target netstandard2.0 (RS1041): they load into the
         compiler process, which may run on a framework older than the SDK. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsRoslynComponentPackage>true</IsRoslynComponentPackage>
    <RoslynComponent>Harbor.CodeGen</RoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- Attribute surface is linked (shared source) into consuming projects;
         it must not compile into the analyzer assembly itself. -->
    <Compile Remove="Attributes/**"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
  </ItemGroup>

</Project>
