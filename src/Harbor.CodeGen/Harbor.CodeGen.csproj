<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Non-packable: build-time Roslyn component, ships as an analyzer, not a runtime library. (#429) -->
    <IsPackable>false</IsPackable>
    <IsRoslynComponentPackage>true</IsRoslynComponentPackage>
    <RoslynComponent>Harbor.CodeGen</RoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Proj0037 (#1857) wants ExcludeAssets=runtime on every PrivateAssets=all
      reference. It does not hold here, and the finding is scoped at this
      element rather than silenced globally: this generator is compiled
      against Microsoft.CodeAnalysis.CSharp, and the local copy of the Roslyn
      runtime is what lets the generator load against the version it was
      compiled against. Excluding it would change how the generator is
      loaded, which is a separate decision from this one.

      The pin moved 5.6.0 → 5.9.0 in #1897, and it now MATCHES the compiler
      the build runs on: global.json asks for SDK 10.0.402, and the 10.0.4xx
      SDK branch pins MicrosoftCodeAnalysisCSharpPackageVersion =
      5.9.0-1.26480.109. That is the condition the canonical fix
      (ExcludeAssets=runtime) was waiting for; it is not taken here, because
      changing how a source generator is loaded is its own change with its own
      verification.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" NoWarn="Proj0037"/>
  </ItemGroup>

  <!--
    #1853. The ProjectReference to Harbor.Abstractions.Contracts was dropped
    from this file: every generator here binds no type from that assembly.
    The attributes the generators emit (TerminalEscape, MoodFrame,
    TuiRenderer) are named as STRINGS — `private const string AttributeName
    = "TerminalEscapeAttribute";` — and the generator looks them up in the
    CONSUMER's compilation, which is where they have to be resolvable. The
    consumers all carry Harbor.Abstractions, which references
    Harbor.Abstractions.Contracts, so the attribute types stay resolvable in
    every compilation that runs a generator.

    The one thing that changes is this project's own closure: the generator
    no longer compiles against the contracts assembly, so its output no
    longer carries a copy of it. Nothing loads it at run time.
  -->

  <PropertyGroup>
    <NoWarn>$(NoWarn);RS1041;S1944</NoWarn>
  </PropertyGroup>

</Project>
