<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Non-packable: build-time Roslyn component, ships as an analyzer, not a runtime library. (#429) -->
    <IsPackable>false</IsPackable>
    <IsRoslynComponentPackage>true</IsRoslynComponentPackage>
    <RoslynComponent>Harbor.CodeGen</RoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Proj0037 (#1857) wants ExcludeAssets=runtime on every PrivateAssets=all
      reference. It does not hold here, and the finding is scoped at this
      element rather than silenced globally: this generator is compiled against
      Microsoft.CodeAnalysis.CSharp 5.6.0, while the .NET 10 SDK ships an
      older Roslyn, and the local copy of the Roslyn runtime is what lets the
      generator load against the version it was compiled against. Excluding it
      would change how the generator is loaded, which is a separate decision
      from this one.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" NoWarn="Proj0037"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions.Contracts\Harbor.Abstractions.Contracts.csproj"/>
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);RS1041;S1944</NoWarn>
  </PropertyGroup>

</Project>
