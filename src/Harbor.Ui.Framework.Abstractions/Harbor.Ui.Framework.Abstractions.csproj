<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Non-packable: intermediate module, ships to NuGet via the Harbor.Ui.Framework meta-package. (#429) -->
    <IsPackable>false</IsPackable>
    <PackageId>Harbor.Ui.Framework.Abstractions</PackageId>
    <Description>Harbor UI Framework — contracts and abstractions (configuration, navigation, diagnostics).</Description>
    <NoWarn>$(NoWarn);MA0046</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <!-- #1553 batch 3: Ensure.NotNull/NotBlank guard helpers. -->
    <ProjectReference Include="..\Harbor.Extensions\Harbor.Extensions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harbor.App.Avalonia"/>
    <InternalsVisibleTo Include="Harbor.App.Wpf"/>
    <InternalsVisibleTo Include="Harbor.App.Maui"/>
    <InternalsVisibleTo Include="Harbor.App.Blazor"/>
    <InternalsVisibleTo Include="Harbor.App.Cli"/>
    <InternalsVisibleTo Include="Harbor.Tui.Termina"/>
    <InternalsVisibleTo Include="Harbor.Tui.TerminalGui"/>
    <InternalsVisibleTo Include="Harbor.Tui.RazorConsole"/>
    <InternalsVisibleTo Include="Harbor.App.Avalonia.Tests"/>
    <InternalsVisibleTo Include="Harbor.E2E.App.Avalonia"/>
  </ItemGroup>

</Project>
