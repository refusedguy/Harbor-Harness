<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Core</PackageId>
    <Description>Harbor.Core — DEPRECATED thin facade. Use Harbor.Application + Harbor.Registries directly. This assembly exists only for backward compatibility with consumers that still reference Harbor.Core; it contains no code and forwards all types via ProjectReference.</Description>
    <PackageTags>harbor;ai;agent;core;deprecated</PackageTags>
  </PropertyGroup>

  <!--
    Harbor.Core is now a THIN FACADE for backward compatibility.

    Previously this project contained 8 responsibilities (AgentLoop, AgentRegistry,
    CompactionService, SystemPromptBuilder, MessageConverter, PermissionService,
    ToolRegistry, ProviderRegistry, OnboardingWizard, HarborConfig, InMemoryEventBus,
    InMemoryMcpRegistry). These have been split into two focused assemblies:

      * Harbor.Application — use cases (AgentLoop, DefaultAgent, CompactionService,
        SystemPromptBuilder, MessageConverter, PermissionService, OnboardingWizard,
        HarborConfig).
      * Harbor.Registries — registry implementations (AgentRegistry, ToolRegistry,
        InMemoryMcpRegistry, ProviderRegistry, InMemoryEventBus).

    Both new assemblies keep the original `Harbor.Core.*` and `Harbor.Abstractions.*`
    namespaces, so existing `using Harbor.Core.Sessions;` directives resolve
    unchanged. New consumers should reference Harbor.Application and/or
    Harbor.Registries directly.

    See README.md for the migration guide.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harbor.Application\Harbor.Application.csproj"/>
    <ProjectReference Include="..\Harbor.Registries\Harbor.Registries.csproj"/>
  </ItemGroup>

</Project>
