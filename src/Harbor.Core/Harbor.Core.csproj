<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Core</PackageId>
    <Description>Harbor core — AgentLoop, EventBus, registries, compaction, system prompt builder.</Description>
    <PackageTags>harbor;ai;agent;core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <PackageReference Include="Microsoft.Extensions.Configuration"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
    <PackageReference Include="CommunityToolkit.HighPerformance"/>
    <PackageReference Include="NonBlocking"/>
    <PackageReference Include="ZLinq"/>
    <PackageReference Include="DotNext"/>
    <PackageReference Include="DotNext.Threading"/>
    <PackageReference Include="KZDev.PerfUtils"/>
    <!--
      ZLinq.DropInGenerator emits source-generated extension methods that take
      priority over System.Linq's. Combined with `<Using Remove="System.Linq" />`
      below, this makes every LINQ call site in Harbor.Core resolve to ZLinq's
      zero-allocation pipeline without rewriting call sites.
    -->
    <PackageReference Include="ZLinq.DropInGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    ZLinq replaces System.Linq throughout Harbor.Core.
    The implicit "System.Linq" using injected by the SDK is removed here so
    that all LINQ operators resolve to ZLinq's zero-allocation equivalents
    without producing ambiguity errors.
  -->
  <ItemGroup>
    <Using Remove="System.Linq"/>
  </ItemGroup>

</Project>
