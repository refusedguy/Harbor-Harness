<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Terminal.Pty</PackageId>
    <Description>Harbor pseudo-terminal (PTY) host — posix_openpt/posix_spawn based out-of-process terminal sessions for the desktop floating panes. Unix (Linux + macOS); Windows ConPTY is a documented follow-up.</Description>
    <PackageTags>harbor;pty;terminal;console</PackageTags>
    <RootNamespace>Harbor.Terminal.Pty</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- §E2 (#204): ROP start boundary (Result with errno diagnostics). -->
    <PackageReference Include="CSharpFunctionalExtensions"/>
  </ItemGroup>

</Project>
