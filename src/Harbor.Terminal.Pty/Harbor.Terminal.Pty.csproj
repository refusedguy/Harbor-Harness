<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- #1243 (SG2): [LibraryImport] source generator emits unsafe code for
         string marshalling — the flag covers generated code only; no `unsafe`
         keyword in hand-written sources (MA0046 still holds). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Terminal.Pty</PackageId>
    <Description>Harbor pseudo-terminal (PTY) host — posix_openpt/posix_spawn based out-of-process terminal sessions for the desktop floating panes. Unix (Linux + macOS); Windows ConPTY is a documented follow-up.</Description>
    <PackageTags>harbor;pty;terminal;console</PackageTags>
    <RootNamespace>Harbor.Terminal.Pty</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- §E2 (#204): ROP start boundary (Result with errno diagnostics). -->
    <PackageReference Include="CSharpFunctionalExtensions"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      #672: ITerminalPaneLauncher (Domain) + PermissionRuleset. The spawn stays in
      THIS assembly — it is Infrastructure, and Application cannot reference it —
      but the gate and the seam that Presentation talks to are Domain contracts.
      Declared here and in FullLayerMatrixTests together; EnforcerIntegrityTests
      cross-checks the csproj against the matrix, so editing one without the other
      fails the architecture gate.
    -->
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
  </ItemGroup>

</Project>
