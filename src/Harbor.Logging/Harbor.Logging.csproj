<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Non-packable: internal Serilog bootstrap composed by app hosts, not a public contract. (#429) -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);S6668;S108;S2486</NoWarn>
    <RootNamespace>Harbor.Logging</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog"/>
    <PackageReference Include="Serilog.Extensions.Hosting"/>
    <PackageReference Include="Serilog.Sinks.File"/>
    <PackageReference Include="Serilog.Sinks.Console"/>
    <PackageReference Include="Serilog.Sinks.Async"/>
    <!--
      #1853. Microsoft.Extensions.Logging.Abstractions was dropped from this
      file: the only source file here (LoggerSetup.cs) binds Serilog.ILogger
      and nothing else, so the reference carried no compile-time use. The
      assembly stays in the closure through Serilog.Extensions.Hosting 10.0.0,
      which depends on it directly, and CentralPackageTransitivePinningEnabled
      resolves that transitive to the same 10.0.13 the direct reference pinned
      — so the removal changes no resolved version and no output file.
    -->
  </ItemGroup>
</Project>
