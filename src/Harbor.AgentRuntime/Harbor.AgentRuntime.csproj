<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.AgentRuntime</PackageId>
    <Description>Harbor agent runtime — AgentLoop, TurnRunner, ToolDispatcher, SubAgentRunner, pipeline behaviors and retry mechanics (#1623).</Description>
    <PackageTags>harbor;ai;agent;agentloop;runtime</PackageTags>
  </PropertyGroup>

  <!--
    #1623: the agent loop (Agents/* + Agents/Pipeline/* + the Resilience
    implementations) extracted verbatim from Harbor.Application into its own
    assembly, plan A part 1/4 of the Application decomp split. One-way edge:
    AgentRuntime -> Application only. Application holds the shared vocabulary
    both sides read and does NOT bind any moved type:

      - Contracts that the residue still consumes: IRetryPolicy / RetryOptions /
        IToolRetryDecider / IRetryAfterHint (Harbor.Application.Resilience,
        deliberately NOT moved — CompactionService binds them and would flip the
        edge into a cycle; the RetryPolicy / DefaultToolRetryDecider
        implementations moved with the loop that drives them, in the SAME
        Harbor.Application.Resilience namespace per the NetArchLayerRules
        backward-compat convention).
      - Loop vocabulary read via the ProjectReference below: Harbor.Hooks
        (IHookRunner, HookDecision, HookVerdict — now its own assembly, #1596),
        Harbor.SessionContext (.Sessions CompactionPolicy, CompactionView,
        CachingSystemPromptBuilder, MessageConverter, WorkspaceContextSource —
        extracted by #1624), Harbor.Application .Resources (CoreResources) and
        .Telemetry (#1626 will extract).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Diagnostics.Abstractions\Harbor.Diagnostics.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Extensions\Harbor.Extensions.csproj"/>
    <ProjectReference Include="..\Harbor.Hooks\Harbor.Hooks.csproj"/>
    <ProjectReference Include="..\Harbor.Application\Harbor.Application.csproj"/>
    <!-- #1624: the loop reads CompactionView / CachingSystemPromptBuilder / MessageConverter / WorkspaceContextSource from the session-context cohort. -->
    <ProjectReference Include="..\Harbor.SessionContext\Harbor.SessionContext.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="ZLinq"/>
    <!--
      ZLinq.DropInGenerator emits source-generated extension methods that take
      priority over System.Linq's. Combined with `<Using Remove="System.Linq" />`
      below, every LINQ call site in Harbor.AgentRuntime resolves to ZLinq's
      zero-allocation pipeline without rewriting call sites (moved verbatim from
      Harbor.Application, which does exactly this — same setup as Abstractions
      and Registries).
    -->
    <PackageReference Include="ZLinq.DropInGenerator" ExcludeAssets="runtime">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <!-- Proj0037 (#1857): the package ships an analyzer and no runtime
           assembly, so the runtime asset is excluded explicitly. -->
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Linq"/>
  </ItemGroup>
  <!-- #1623: StreamingCoalescer moved here with the agent loop and stays internal;
       the benchmark binds it directly (tests/Harbor.Benchmarks/StreamingCoalescerBenchmark.cs). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Harbor.Benchmarks"/>
    <!-- #1761: the goal round driver is an internal collaborator of the loop
         (the same shape as TurnRunner and ToolDispatcher), so the test that
         pins its decisions has to reach it. The pattern is the repo's: a
         product assembly opens its internals to the project that tests them
         (Harbor.Tools.Builtin -> Harbor.Tools.Builtin.Tests, and so on). -->
    <InternalsVisibleTo Include="Harbor.Application.Tests"/>
  </ItemGroup>

</Project>
