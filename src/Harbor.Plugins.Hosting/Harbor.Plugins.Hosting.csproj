<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Plugins.Hosting — composition root for the layered plugin runtime.

    Public types:
      - PluginHost         (iterates IPluginSource → compiles via IPluginCompiler →
                            instantiates via IPluginInstantiator → registers via
                            IPluginRegistrar)
      - PluginHostBuilder  (fluent builder; the only way to construct PluginHost)
      - PluginHostOptions  (ContinueOnError, PluginRoot, etc.)

    Depends on all four lower plugin layers (Storage, Compilation,
    Instantiation, Registration) + Abstractions.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Plugins.Hosting</PackageId>
    <Description>Harbor plugin host — orchestrates storage → compilation → instantiation → registration pipeline.</Description>
    <PackageTags>harbor;ai;agent;plugins;hosting;orchestrator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Plugins.Abstractions\Harbor.Plugins.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Plugins.Storage\Harbor.Plugins.Storage.csproj"/>
    <ProjectReference Include="..\Harbor.Plugins.Compilation\Harbor.Plugins.Compilation.csproj"/>
    <ProjectReference Include="..\Harbor.Plugins.Instantiation\Harbor.Plugins.Instantiation.csproj"/>
    <ProjectReference Include="..\Harbor.Plugins.Registration\Harbor.Plugins.Registration.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
