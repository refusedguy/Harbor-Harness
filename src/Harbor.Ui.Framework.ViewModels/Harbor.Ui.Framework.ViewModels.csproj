<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Non-packable: intermediate module, ships to NuGet via the Harbor.Ui.Framework meta-package. (#429) -->
    <IsPackable>false</IsPackable>
    <PackageId>Harbor.Ui.Framework.ViewModels</PackageId>
    <Description>Harbor UI Framework — shared ViewModels, converters, and animation helpers.</Description>
    <NoWarn>$(NoWarn);MA0046</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Ui.Framework.State\Harbor.Ui.Framework.State.csproj"/>
    <ProjectReference Include="..\Harbor.Ui.Framework.Services\Harbor.Ui.Framework.Services.csproj"/>
    <ProjectReference Include="..\Harbor.Ui.Framework.Abstractions\Harbor.Ui.Framework.Abstractions.csproj"/>
    <!-- #679: DiffViewModel projects the core LCS (Rendering.Widgets.LineDiff)
         instead of walking left[i]/right[i] itself. Direct reference, not the
         transitive one through State — the same CF-A-001 precedent the
         Rendering project sets. Presentation to Presentation, which conforms. -->
    <ProjectReference Include="..\Harbor.Ui.Framework.Rendering\Harbor.Ui.Framework.Rendering.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harbor.App.Avalonia"/>
    <InternalsVisibleTo Include="Harbor.App.Wpf"/>
    <InternalsVisibleTo Include="Harbor.App.Maui"/>
    <InternalsVisibleTo Include="Harbor.App.Blazor"/>
    <InternalsVisibleTo Include="Harbor.App.Cli"/>
    <InternalsVisibleTo Include="Harbor.Tui.Termina"/>
    <InternalsVisibleTo Include="Harbor.Tui.TerminalGui"/>
    <InternalsVisibleTo Include="Harbor.Tui.RazorConsole"/>
    <InternalsVisibleTo Include="Harbor.App.Avalonia.Tests"/>
    <InternalsVisibleTo Include="Harbor.E2E.App.Avalonia"/>
  </ItemGroup>

</Project>
