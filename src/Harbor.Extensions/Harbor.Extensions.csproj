<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Extensions — infrastructure helper layer.

    Contains: ArrayPool / StringBuilderPool helpers, CollectionExtensions
    (FrozenSet / FrozenDictionary materializers), MemoryPackExtensions
    (ToMemoryPackBytes / FromMemoryPackBytes round-trip helpers).

    Dependencies:
      - MemoryPack. CommunityToolkit.HighPerformance used to be declared here
        and was removed by tools/check-abstractions-contract.py: not one `.cs`
        file in this project had a `using` under any of its namespace prefixes.
        The FrozenSet/FrozenDictionary materializers it looks like it was added
        for are `System.Collections.Frozen` — in-box since .NET 8 — so the real
        dependency is on the framework and no PackageReference declares it. See
        CollectionExtensions.cs.

    Zero Harbor project references — the helpers are pure BCL/NuGet wrappers
    (MemoryPackExtensions is generic over MemoryPack's IMemoryPackable<T>, so
    it never needed a concrete Harbor assembly). Consumers that use these
    helpers reference Harbor.Extensions directly.

    Namespaces preserved as Harbor.Abstractions.Extensions so consumer code
    (Harbor.Application, Harbor.Tools.*, etc.) requires zero `using` changes.

    See README.md for the architectural rationale.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Extensions</PackageId>
    <Description>Harbor infrastructure helpers — ArrayPool, StringBuilder pool, FrozenSet materializers, MemoryPack round-trip helpers.</Description>
    <PackageTags>harbor;ai;agent;extensions;infrastructure;pooling</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Harbor.Abstractions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
