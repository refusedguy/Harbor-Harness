@* Root Razor component — sets up the HTML document head, applies the dark
   theme CSS, and renders the chat page. Single-page skeleton — no router. *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Harbor — AI Coding Agent</title>
    <link rel="stylesheet" href="app.css"/>
    <HeadOutlet/>
</head>
<body>
    <Chat @rendermode="InteractiveServer"/>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
