<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Ipc.InProcess — default IHarborClient implementation.

    Calls IAgent / ISessionStore / IProviderRegistry / IToolRegistry /
    IEventBus directly. Zero serialization. This is the implementation
    used when HARBOR_MODE=inprocess (the default).

    Layer: Application — same layer as Harbor.Application. Depends on
    Harbor.Ipc.Abstractions + Harbor.Abstractions + Harbor.Application
    (for the DefaultAgent's IAgent contract — actually IAgent lives in
    Harbor.Abstractions, so we only need Harbor.Abstractions).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Ipc.InProcess</PackageId>
    <Description>Harbor IPC in-process client — default IHarborClient implementation that calls IAgent/ISessionStore/IProviderRegistry/IToolRegistry directly. Zero serialization overhead.</Description>
    <PackageTags>harbor;ipc;inprocess;client;default</PackageTags>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);MPK0002;MPK0003;MPK0004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.Ipc.Abstractions\Harbor.Ipc.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
