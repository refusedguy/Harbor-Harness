<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Harbor.Application</PackageId>
    <Description>Harbor application layer — use cases (AgentLoop, DefaultAgent, CompactionService, SystemPromptBuilder, MessageConverter). The configuration family (HarborConfig, JsonConfigStore, AuthStore, ProviderPresets) is the sibling Harbor.PolicyConfig assembly (#1625); the Permissions subdomain is Harbor.Permissions (#1615); OnboardingWizard + SetupChecklistDetector moved to Harbor.Onboarding (#1614).</Description>
    <PackageTags>harbor;ai;agent;application;use-cases</PackageTags>
  </PropertyGroup>

  <!--
    #580/#1625: the providers/*.json embed MOVED to Harbor.PolicyConfig with
    ProviderPresetCatalog — the catalog reads the embedded resources off its
    OWN assembly, so the embed has to travel with the code that reads them.
    Nothing in this assembly reads them any more.
  -->

  <!--
    Application layer depends on Harbor.Abstractions only — never on
    Infrastructure (Providers.*, Storage.*, Tools.Builtin), never on
    Presentation (Tui.*), never on sibling Application projects
    (Plugins.Runtime, Scripting).

    #1615: the permissions subdomain was extracted verbatim from
    Permissions/ and the whole-config IConfigStore surface was cut at the
    IPermissionConfigStore seam; the Application side realized that seam
    through PermissionConfigStoreAdapter, which lived in Configuration/.
    #1625 moved Configuration/ — and with it that adapter — into
    Harbor.PolicyConfig, so the Harbor.Permissions edge this project carried
    for the adapter is GONE: nothing here binds a Harbor.Permissions type any
    more, and a declared-but-unbound reference would be a dead edge the
    architecture gate reports. The seam itself is unchanged: the port still
    lives in Harbor.Permissions and the adapter still implements it, one
    assembly over.
    #1623: the extracted agent loop (Harbor.AgentRuntime) took the IHookRunner
    consumers (ToolDispatcher, AgentLoop, CompactionBehavior, UserHookGates) and
    the Diagnostics.Abstractions telemetry bindings with it, so the former
    Harbor.Hooks / Harbor.Diagnostics.Abstractions edges moved to AgentRuntime's
    row and this csproj no longer declares them. The compiled assembly
    must not reference either (liveness rule in the architecture tests).
    See docs/ARCHITECTURE_LAYERS.md §2.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\Harbor.Extensions\Harbor.Extensions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- #957: Microsoft.Extensions.Logging removed — project uses only ILogger<T>/LoggerExtensions (Logging.Abstractions types). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <!--
      CommunityToolkit.HighPerformance used to be declared here and was removed
      by tools/check-abstractions-contract.py: not one `.cs` file in this project
      had a `using` under any of its namespace prefixes. Two things that look
      like reasons to keep it are not, and both were checked rather than assumed:

        - The System.Collections.Frozen usage in DefaultFileTreePolicy,
          PathArgExtractionPolicy and FileClaimRegistry is the BCL type, in-box
          since .NET 8. It needs no PackageReference, which is why no phantom
          finder ever objected to this project using it.
        - The streaming-delta coalescing in StreamingCoalescer rents from
          Harbor.Extensions.StringBuilderPool, a ConcurrentBag pool in this
          solution - not from CommunityToolkit's namesake type. The README
          credited the package for it until this removal.

      Nothing else in the repository used the package either, and in particular
      apps/Harbor.App.Avalonia did NOT depend on this edge to get it: that app
      builds only transitively (via Harbor.App.Avalonia.Tests, #1008) and is not
      in Harbor.slnx, so this was the one place a wrong removal would have broken
      a build outside the local feedback loop. Its `using CommunityToolkit...`
      directives are all CommunityToolkit.Mvvm, which it declares itself, and
      CommunityToolkit.Mvvm 8.4.2's nuspec does not depend on
      CommunityToolkit.HighPerformance. See tools/check-abstractions-contract.py.
    -->
    <PackageReference Include="ZLinq"/>
    <!--
      ZLinq.DropInGenerator emits source-generated extension methods that take
      priority over System.Linq's. Combined with `<Using Remove="System.Linq" />`
      below, every LINQ call site in Harbor.Application resolves to ZLinq's
      zero-allocation pipeline without rewriting call sites.
    -->
    <PackageReference Include="ZLinq.DropInGenerator" ExcludeAssets="runtime">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <!-- Proj0037 (#1857): the package ships an analyzer and no runtime
           assembly, so the runtime asset is excluded explicitly. -->
    </PackageReference>
  </ItemGroup>

  <!--
    ZLinq replaces System.Linq throughout Harbor.Application for zero-allocation
    LINQ. The implicit "System.Linq" using injected by the SDK is removed here so
    that all LINQ operators resolve to ZLinq's zero-allocation equivalents
    without producing ambiguity errors.
  -->
  <ItemGroup>
    <Using Remove="System.Linq"/>
  </ItemGroup>

  <PropertyGroup>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harbor.Benchmarks"/>
    <!-- #1623: the extracted agent loop reads .Resources (CoreResources) over the
         ProjectReference — see Harbor.AgentRuntime.csproj header. CompactionService
         binds nothing back; the edge stays one-way AgentRuntime -> Application. -->
    <InternalsVisibleTo Include="Harbor.AgentRuntime"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\LogMessages.resx">
      <LogicalName>Harbor.Application.LogMessages.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\ErrorMessages.resx">
      <LogicalName>Harbor.Application.ErrorMessages.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
