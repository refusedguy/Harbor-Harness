<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.App.Wpf.Tests — DI registration tests for the WPF composition root.

    Targets net10.0-windows (same as Harbor.App.Wpf) because the WPF project
    requires the Windows Desktop runtime. Use EnableWindowsTargeting=true so
    the project still restores + compiles on non-Windows hosts for design-time
    verification, but the test runner only executes on Windows.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1707;S2931;S3881;CA1416</NoWarn>
    <!-- Skip runtime pack resolution on non-Windows; the project compiles but cannot run tests on Linux. -->
    <RuntimeIdentifier Condition="'$(OS)' != 'Windows_NT' AND '$(BuildingProject)' == 'true'"></RuntimeIdentifier>
    <SkipWindowsRuntimeCheck>true</SkipWindowsRuntimeCheck>
    <!-- On Linux, exclude this project from solution build via IsBuildable=false. -->
    <IsBuildable Condition="'$(OS)' != 'Windows_NT'">false</IsBuildable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\Harbor.App.Wpf\Harbor.App.Wpf.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Hosting"/>
  </ItemGroup>

</Project>
