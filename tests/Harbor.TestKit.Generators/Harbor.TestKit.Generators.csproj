<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Build-time only. This project is a Roslyn component: it is consumed as an
      ANALYZER by Harbor.TestKit (OutputItemType=Analyzer) and never as a runtime
      library. It ships no code to any consumer.
    -->
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsRoslynComponentPackage>true</IsRoslynComponentPackage>
    <RoslynComponent>Harbor.TestKit.Generators</RoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Description>Roslyn source generator that emits concrete test doubles for the interfaces Harbor.TestKit opts into (issue #1769).</Description>
    <!--
      RS1041 (nullability of the generator's own surface) and S1944 (the
      "initialize a field to its default" pattern the emitted code uses) are
      suppressed for the same reason src/Harbor.CodeGen suppresses them.
    -->
    <NoWarn>$(NoWarn);RS1041;S1944</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PrivateAssets=all: the analyzer runs inside the compiler, which already
      hosts Roslyn. Nothing flows to consumers, and the generated code carries
      no Roslyn dependency at run time.

      Proj0037 (#1857) wants ExcludeAssets=runtime here, and the rule's premise
      does not hold for this project — the same reason as
      src/Harbor.CodeGen/Harbor.CodeGen.csproj: the generator is compiled
      against Microsoft.CodeAnalysis.CSharp, and the local copy of the Roslyn
      runtime is what lets it load against the version it was compiled
      against. The finding is scoped at this element rather than silenced
      globally; the canonical fix (ExcludeAssets=runtime) lands when the
      repository's Roslyn pin and the SDK's Roslyn are aligned.

      They ARE aligned as of #1897: the pin moved 5.6.0 → 5.9.0 and global.json
      asks for SDK 10.0.402, whose own Roslyn is 5.9.0
      (MicrosoftCodeAnalysisCSharpPackageVersion = 5.9.0-1.26480.109 on the
      10.0.4xx SDK branch). The fix is still not taken here, because changing
      how a source generator is loaded is its own change with its own
      verification.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" NoWarn="Proj0037"/>
  </ItemGroup>

</Project>
