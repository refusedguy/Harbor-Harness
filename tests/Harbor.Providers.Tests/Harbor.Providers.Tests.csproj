<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      #1889: the shared cost gate (TestScalingGate, #1652) lives in
      Harbor.TestKit, and this project used to keep a DOCUMENTED SAME-API
      INTERNAL COPY of that file because TestKit dragged Harbor.Application
      into the slice this project measures. The composite TestKit no longer
      does — its closure is Harbor.Abstractions + Harbor.Abstractions.Contracts
      + itself. So the copy is gone and the shared file is used.
    -->
    <ProjectReference Include="..\Harbor.TestKit\Harbor.TestKit.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <!--
      The four provider assemblies each carry their own copy of the shared
      wire helpers (OpenAiWire.cs, SsePump.cs, Utf8JsonReaderExtensions.cs
      are LINKED source, not a shared assembly), so their internal types
      collide by name. The aliases below are what let a test name ONE of
      them; `global` keeps every type visible unqualified as before, so the
      aliases add a way to disambiguate without removing one.
    -->
    <ProjectReference Include="..\..\src\Harbor.Providers.Anthropic\Harbor.Providers.Anthropic.csproj">
      <Aliases>AnthropicWire,global</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Harbor.Providers.OpenAI\Harbor.Providers.OpenAI.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Providers.Ollama\Harbor.Providers.Ollama.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Providers.OpenAiCompatible\Harbor.Providers.OpenAiCompatible.csproj">
      <Aliases>CompatWire,global</Aliases>
    </ProjectReference>
    <!-- #1772: the shared test doubles (the capturing logger and the HTTP
         stub among them). The sibling references Harbor.Abstractions only,
         which this project already has, so the reference adds no product
         assembly. -->
    <ProjectReference Include="..\Harbor.TestKit.Support\Harbor.TestKit.Support.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
