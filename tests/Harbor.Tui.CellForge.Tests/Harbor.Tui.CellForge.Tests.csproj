<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbor.Tui.CellForge.Engine\Harbor.Tui.CellForge.Engine.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.CellForge\Harbor.Tui.CellForge.csproj"/>
    <!-- #462: PaletteCatalogTests derives its expectations from SlashCommandCatalog. -->
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Abstractions\Harbor.Ui.Framework.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.CodeGen\Harbor.CodeGen.csproj"/>
    <ProjectReference Include="..\..\tests\Harbor.TestKit\Harbor.TestKit.csproj"/>
    <!--
      #536: `ThemeFileWatcherTests` drives the widget against the REAL
      IThemeStore implementation (4 of its 7 tests) so the file path and mtime
      behaviour it had before the port existed is still exercised. That
      implementation — ThemeStore — moved out of the leaf and into
      Harbor.Hosting.Themes, so the reference follows it. Reached through
      Harbor.Hosting rather than re-homed into this project: a Presentation
      widget's test should not acquire a source-level dependency on a service
      just because the service moved, and the alternative (relocating those four
      tests to Harbor.Hosting.Tests) would have taken the widget's only
      real-store coverage away from the widget.
    -->
    <ProjectReference Include="..\..\src\Harbor.Hosting\Harbor.Hosting.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- TUnit is auto-included via tests/Directory.Build.props (IsTestProject=true);
         Test.Sdk is the dotnet-test host adapter. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
  </ItemGroup>

</Project>
