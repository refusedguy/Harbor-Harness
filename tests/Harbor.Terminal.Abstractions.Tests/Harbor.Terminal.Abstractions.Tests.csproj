<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1861;S5445;S3011</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- #1821: the shared event builders (TestEvents). The edge is
         closure-neutral — that part references only Harbor.Abstractions
         and Harbor.Abstractions.Contracts, and this project already has
         both because it already publishes events. -->
    <ProjectReference Include="../Harbor.TestKit.Support/Harbor.TestKit.Support.csproj"/>
    <ProjectReference Include="../../src/Harbor.Abstractions/Harbor.Abstractions.csproj"/>
    <ProjectReference Include="../../src/Harbor.Terminal.Abstractions/Harbor.Terminal.Abstractions.csproj"/>
    <!--
      Harbor.TestKit used to be referenced here, and was used by NOTHING in
      this project: no `using Harbor.TestKit`, no qualified type name, no
      opted-in interface. The reference only cost closure — Harbor.Application,
      Harbor.Desktop.Abstractions and Harbor.Permissions arrived with it
      (20 -> 15 projects). (Harbor.TestKit declares no test methods of its own,
      so this edge never duplicated a test run; the cost here was the closure
      alone.) tests/Harbor.Architecture.Tests/TestProjectReferenceRules.cs now
      keeps a test project from referencing another test project it does not
      use.
    -->
    <!-- ReactiveHookGenerator must run here too: ReactiveViewModelTests' stub
         declares [Reactive] fields and tests its EMITTED hooks end-to-end
         (issue #1542). Analyzer output does not flow transitively through
         the Terminal.Abstractions ProjectReference — same pattern as that
         project's own Harbor.CodeGen reference. -->
    <ProjectReference Include="../../src/Harbor.CodeGen/Harbor.CodeGen.csproj">
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
