<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      #1772/#1773: the shared test helpers that need NO product assembly beyond
      the contracts live here, so that EVERY test project can reach one
      implementation without widening its product-assembly closure.

      The closure rule (#1549) is the reason this is a sibling and not part of
      `Harbor.TestKit` itself: `Harbor.TestKit` already drags the
      Ui.Framework / Terminal.Abstractions / Application family in, so a
      project that does not have that family (Storage.Tests, Ipc.Tests,
      Providers.Tests, Config.Tests, LoadTests, ...) could not reference it
      without gaining 14+ product assemblies. This project references
      `Harbor.Abstractions` only — an assembly every one of those projects
      already has — so adding it is closure-neutral.

      The NAMESPACE is `Harbor.TestKit`, so `using Harbor.TestKit;` is all a
      consumer needs regardless of which sibling the type lives in.
    -->
    <RootNamespace>Harbor.TestKit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Harbor.Abstractions/Harbor.Abstractions.csproj" />
    <!--
      #1822: the shared source-generated JSON context registers `Usage`, a
      `Harbor.Abstractions.Contracts` type. Contracts is ALREADY in this
      project's transitive closure (Harbor.Abstractions references it), so the
      explicit edge adds no assembly to any consumer — it states the
      dependency instead of leaning on the chain.
    -->
    <ProjectReference Include="../../src/Harbor.Abstractions.Contracts/Harbor.Abstractions.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ILogger/ILoggerFactory/ILogger<T> live here. The package is already in
      the closure of every consumer through Harbor.Abstractions, so declaring
      it directly widens nothing.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      #1569: the shared RESULT ASSERTIONS moved here from `Harbor.TestKit`.

      Two packages, neither of them a product assembly — so the closure rule
      the architecture guard pins (the support part reaches the two contract
      assemblies and nothing else) is untouched: that rule walks
      <ProjectReference> edges, and these are <PackageReference> edges.

        * TUnit.Assertions — the `[GenerateAssertion]` attribute, the
          `AssertionResult` the helpers return, and the SOURCE GENERATOR that
          turns each helper into an `Assert.That(...)` chain link. The
          declaration is load-bearing and cannot be leaned on: every project
          under tests/ already gets the `TUnit` meta-package, and `TUnit`
          depends on `TUnit.Assertions` with `exclude="Build,Analyzers"` —
          so the LIBRARY flows in transitively but the GENERATOR DOES NOT. A
          project that wants the generator has to name the package itself,
          which is why `Harbor.TestKit` names it too.
        * CSharpFunctionalExtensions — `Result` and `Result<T>`, the types the
          helpers assert. The library is already in the closure (both
          contract assemblies declare it); naming it here states the
          dependency instead of leaning on the chain.

      Why the assertions belong to the SUPPORT part and not to the core kit:
      they need no product assembly beyond the contracts, and the core kit is
      where 24 test projects could not reach them from. See
      `tests/Harbor.TestKit.Support/ResultAssertions.cs` for the long form.
    -->
    <PackageReference Include="TUnit.Assertions" />
    <PackageReference Include="CSharpFunctionalExtensions" />
  </ItemGroup>

</Project>
