<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.E2E.Cli - end-to-end tests for the Harbor.App.Cli one-shot commands.
    Drives `dotnet exec Harbor.App.Cli.dll <args>` via CliDriver and asserts on
    captured stdout. The mock LLM server is wired in via GetEnv() for tests
    that exercise the `ask` command.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707;S3267;S2365;S2445;S6618;TUnit0055</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.E2E.Framework\Harbor.E2E.Framework.csproj"/>
    <ProjectReference Include="..\..\apps\Harbor.App.Cli\Harbor.App.Cli.csproj"/>
  </ItemGroup>

  <!-- TUnit is auto-included via tests/Directory.Build.props (IsTestProject=true). -->

</Project>
