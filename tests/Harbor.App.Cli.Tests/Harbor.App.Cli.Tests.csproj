<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.App.Cli.Tests — DI registration tests for the CLI composition root.

    Builds the host via Harbor.Cli.Hosting.HostBuilder.Build() and asserts that
    every service declared with [Exposes(typeof(T))] on that method is actually
    resolvable from the resulting IServiceProvider. This catches:

      * Missing registrations (forgot to services.AddXxx<T>())
      * Lifetime mistakes that break resolution (e.g. captive dependency that
        throws at resolve time)
      * Wrong interface wiring (registered IX but not IY)

    The companion compile-time check is Excubo.Analyzers.DependencyInjectionValidation
    (rules EDI01–EDI04, configured in /etc/Directory.Build.props + .editorconfig).
    The companion runtime check is DependencyInjection.Lifetime.Analyzers
    (DI001–DI027, configured in .editorconfig).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- DI tests intentionally probe runtime wiring; relax TreatWarningsAsErrors
         so the build doesn't fail on incidental analyzer warnings from the app
         project's internal helper types. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1707;S2931;S3881</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\Harbor.App.Cli\Harbor.App.Cli.csproj"/>
    <!-- #1624: binds the moved session-context types directly. -->
    <ProjectReference Include="..\..\src\Harbor.SessionContext\Harbor.SessionContext.csproj"/>
    <ProjectReference Include="..\..\tests\Harbor.TestKit\Harbor.TestKit.csproj"/>
    <!-- #1772: the shared terminal-backend doubles. The sibling references
         Harbor.Tui.CellForge.Engine only, which this project already has,
         so the reference adds no product assembly. -->
    <ProjectReference Include="..\Harbor.TestKit.Tui\Harbor.TestKit.Tui.csproj"/>
    <!-- #1875: the source-generated doubles (Harbor.TestKit.Generated.Fake*)
         live in their OWN assembly since #1875, and this project uses them, so
         it takes that part as well as the core kit. The part adds no product
         assembly to the closure: its own closure is itself plus the two
         contract assemblies. -->
    <ProjectReference Include="..\Harbor.TestKit.Generated\Harbor.TestKit.Generated.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      TUnit is auto-included by the .NET 10 SDK when <IsTestProject>true</IsTestProject>
      is set in tests/Directory.Build.props (so we don't list it explicitly here —
      adding it would cause NU1504 DuplicatePackageReference).
      Microsoft.Extensions.* are duplicated from Harbor.App.Cli's transitive graph
      so the tests don't break if the app project drops a reference later
      (defense-in-depth for the DI surface).
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Hosting"/>
  </ItemGroup>

</Project>
