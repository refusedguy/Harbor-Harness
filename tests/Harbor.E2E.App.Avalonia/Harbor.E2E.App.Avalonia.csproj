<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.E2E.App.Avalonia - end-to-end tests for the standalone Avalonia
    desktop app. Uses HeadlessAvaloniaDriver (Avalonia.Headless on Windows,
    skipped on Linux/macOS without a virtual framebuffer).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707;S3267;S2365;S2445;S6618;TUnit0055</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.E2E.Framework\Harbor.E2E.Framework.csproj"/>
    <ProjectReference Include="..\..\apps\Harbor.App.Avalonia\Harbor.App.Avalonia.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
  </ItemGroup>

</Project>
