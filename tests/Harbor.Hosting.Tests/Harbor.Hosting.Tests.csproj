<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Harbor.Hosting/Harbor.Hosting.csproj"/>
    <!-- #1624: binds the moved session-context types directly. -->
    <ProjectReference Include="..\..\src\Harbor.SessionContext\Harbor.SessionContext.csproj"/>
    <!-- #1623: PipelineBehaviorCompositionTests binds Harbor.Application.Agents (moved types). -->
    <ProjectReference Include="../../src/Harbor.AgentRuntime/Harbor.AgentRuntime.csproj"/>
    <!-- #1741/#1742: TelemetryExportOptionsTests binds the telemetry export
         vocabulary (TelemetryExportTarget / TelemetryExportOptions), which
         Harbor.Hosting references — declared here for the same reason as the
         row above: the test names the type, so the type is a real edge. -->
    <ProjectReference Include="../../src/Harbor.Telemetry.Core/Harbor.Telemetry.Core.csproj"/>
    <!-- #1741/#1742: the same test reads the HARBOR_TELEMETRY_* names from
         HarborEnv, which lives in the contracts assembly. -->
    <ProjectReference Include="..\..\src\Harbor.Abstractions.Contracts\Harbor.Abstractions.Contracts.csproj"/>
    <!-- #1772/#1773: the shared test doubles and the three scopes. This
         project already has every product assembly the library needs, so the
         reference adds none. -->
    <ProjectReference Include="../../src/Harbor.Abstractions.Contracts/Harbor.Abstractions.Contracts.csproj"/>
    <!-- #1854: DesktopProviderHttpClientTests binds the IModelCatalog /
         ProviderConfig vocabulary the desktop provider discovery speaks, which
         Harbor.Hosting references — declared here for the same reason as the
         rows above: the test names the type, so the type is a real edge. -->
    <ProjectReference Include="../../src/Harbor.Providers.OpenAiCompatible/Harbor.Providers.OpenAiCompatible.csproj"/>
    <!--
      #1889: the helpers this project uses (the scopes, the logging doubles)
      live in the `Harbor.TestKit.Support` sibling, and #1834 reached them
      THROUGH the core kit. Now that `NullRenderContext` has moved out of the
      core into the UI-scoped `Harbor.TestKit.Tui` part, this project
      references the two siblings it actually uses instead of the core, whose
      types it names none of.
    -->
    <ProjectReference Include="..\Harbor.TestKit.Support\Harbor.TestKit.Support.csproj"/>
    <ProjectReference Include="..\Harbor.TestKit.Tui\Harbor.TestKit.Tui.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
