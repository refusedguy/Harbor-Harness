<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Architecture tests intentionally probe the layering invariants of every
      Harbor assembly. TreatWarningsAsErrors is OFF here because we load assemblies
      via reflection (which Sonar's S3011 / ReflectionAnalyzers sometimes flags)
      and we want a clean test runner exit even if a single rule's diagnostic
      triggers on a probe helper.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;S3011;S2365;CA1851</NoWarn>
  </PropertyGroup>

  <!--
    NetArchTest.Rules — fluent DSL for asserting assembly-level dependency
    invariants. Used by NetArchLayerRules.cs. The reflection-based
    LayerDependencyTests.cs file remains as the zero-dependency fallback so
    the layering rules still run even if NetArchTest ever fails to restore.
  -->
  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules"/>
    <PackageReference Include="TUnit.Assertions"/>
  </ItemGroup>

  <!--
    Reference every Harbor project so the test runner loads each assembly into
    the default AppDomain. Architecture tests then call Assembly.GetReferencedAssemblies()
    on each to assert that the layering invariants from docs/ARCHITECTURE_LAYERS.md hold.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbor.Abstractions.Contracts\Harbor.Abstractions.Contracts.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Extensions\Harbor.Extensions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Diagnostics.Abstractions\Harbor.Diagnostics.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Terminal.Abstractions\Harbor.Terminal.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Application\Harbor.Application.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Registries\Harbor.Registries.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Core\Harbor.Core.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Runtime\Harbor.Plugins.Runtime.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Providers.OpenAiCompatible\Harbor.Providers.OpenAiCompatible.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Providers.Anthropic\Harbor.Providers.Anthropic.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Providers.OpenAI\Harbor.Providers.OpenAI.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Providers.Ollama\Harbor.Providers.Ollama.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Storage.Jsonl\Harbor.Storage.Jsonl.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Storage.Memory\Harbor.Storage.Memory.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Storage.Sqlite\Harbor.Storage.Sqlite.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tools.Builtin\Harbor.Tools.Builtin.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.Ansi\Harbor.Tui.Ansi.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.Plain\Harbor.Tui.Plain.csproj"/>

    <!-- ROP-D Z2: every remaining main-solution src project joins enforcement
         (previously ~28 projects had zero layer rules). Harbor.CodeGen is a
         build tool outside Harbor.slnx and stays out of scope. App entry
         points (apps/) are composition roots and are unrestricted by design. -->
    <ProjectReference Include="..\..\src\Harbor.Logging\Harbor.Logging.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Transport.Remote\Harbor.Transport.Remote.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Telemetry.Core\Harbor.Telemetry.Core.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Telemetry.Otlp\Harbor.Telemetry.Otlp.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.Abstractions\Harbor.Tui.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.Notifications\Harbor.Tui.Notifications.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.Abstractions\Harbor.Ipc.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.Client\Harbor.Ipc.Client.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.InProcess\Harbor.Ipc.InProcess.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.Server\Harbor.Ipc.Server.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Abstractions\Harbor.Plugins.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Storage\Harbor.Plugins.Storage.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Compilation\Harbor.Plugins.Compilation.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Instantiation\Harbor.Plugins.Instantiation.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Registration\Harbor.Plugins.Registration.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Hosting\Harbor.Plugins.Hosting.csproj"/>
    <!-- Harbor.Plugins.Host is intentionally NOT referenced/enforced: it is an
         OutputType=Exe out-of-process MCP stdio server (assembly
         harbor-plugins-host), i.e. an app/composition-root like apps/*. -->
    <ProjectReference Include="..\..\src\Harbor.Hosting\Harbor.Hosting.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework\Harbor.Ui.Framework.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Abstractions\Harbor.Ui.Framework.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.State\Harbor.Ui.Framework.State.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Reducers\Harbor.Ui.Framework.Reducers.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Services\Harbor.Ui.Framework.Services.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.ViewModels\Harbor.Ui.Framework.ViewModels.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Projection\Harbor.Ui.Framework.Projection.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Sessions\Harbor.Ui.Framework.Sessions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Desktop.Abstractions\Harbor.Desktop.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Desktop.Shared\Harbor.Desktop.Shared.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Desktop.Animations\Harbor.Desktop.Animations.csproj"/>
  </ItemGroup>

</Project>
