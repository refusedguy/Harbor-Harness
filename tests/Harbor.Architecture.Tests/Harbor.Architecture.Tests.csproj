<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Architecture tests intentionally probe the layering invariants of every
      Harbor assembly. TreatWarningsAsErrors is OFF here because we load assemblies
      via reflection (which Sonar's S3011 / ReflectionAnalyzers sometimes flags)
      and we want a clean test runner exit even if a single rule's diagnostic
      triggers on a probe helper.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;S3011;S2365;CA1851;RS2008;RS1035;RS1036;RS1041</NoWarn>
  </PropertyGroup>

  <!--
    NetArchTest.Rules — fluent DSL for asserting assembly-level dependency
    invariants. Used by NetArchLayerRules.cs. The reflection-based
    LayerDependencyTests.cs file remains as the zero-dependency fallback so
    the layering rules still run even if NetArchTest ever fails to restore.
  -->
  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules"/>
    <PackageReference Include="TUnit.Assertions"/>
    <!--
      Microsoft.CodeAnalysis.CSharp — the PILOT for issue #1729, which asks
      whether the rules that check the TEXT of the product source should move
      to the compiler's own view of it. The pilot writes two of those rules as
      real DiagnosticAnalyzers and runs them IN-PROCESS against a compilation
      the test builds, so the analyzer reaches the compiler's symbol table
      without becoming a build-time analyzer over ~140 projects. With
      TreatWarningsAsErrors on, a build-time analyzer that fires on existing
      code turns the build red before anybody has read the rule, and that is
      the wrong order for a pilot.

      The version is already pinned in Directory.Packages.props for
      src/Harbor.CodeGen, so the repository tracks no new version for it. The
      package is build-time only: no product project references it and nothing
      in src/ or apps/ depends on it, so the NativeAOT rule (#626) is not
      engaged. That rule governs shipped code, and this is a test-only
      dependency.

      RS1041 ("this compiler extension should not be implemented in an assembly
      with target framework .NET 10.0") is suppressed here on purpose: the
      analyzers under Roslyn/ are NOT shipped as compiler extensions. They are
      ordinary classes that this test project runs IN-PROCESS against a
      compilation it builds (Compilation.WithAnalyzers). RS1041 is about
      assemblies the COMPILER loads, and this assembly is loaded by the test
      host, so the hazard it describes does not apply.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <!--
      #1844: the dynamic-code ban is enforced by the COMPILER now (RS0030 over
      BannedSymbols.DynamicCode.txt), and the architecture test proves the rule
      is live by running the build's own analyzer in-process over planted
      source. To do that it needs the analyzer ASSEMBLY at run time, and the
      analyzer package does not copy itself to the output directory.

      `GeneratePathProperty` makes NuGet publish the package's install path as
      `$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)`; the csproj passes it
      into the test assembly as metadata so the test can load the exact
      analyzer the build uses. `Update` (not `Include`) because the package
      reference itself lives in the solution-wide Directory.Build.props — adding
      it a second time here would be a duplicate PackageReference.

      The analyzer itself is NOT copied to the output: `Update` only adds the
      path property, so the analyzer still runs as an analyzer and nothing new
      ships.
    -->
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" GeneratePathProperty="true"/>
    <!--
      Two guards name Maybe<T> in a rule: TuiReadLineContractRules asserts that
      ITuiRenderer.ReadLineAsync returns Task<Maybe<string>> (#589), and
      CellForgeWidgetStateRules documents the CellForge widget-state rule (#592).
      The types are reachable transitively through Harbor.Terminal.Abstractions,
      but a guard that breaks when an unrelated package reference is retargeted
      is not a guard.
    -->
    <PackageReference Include="CSharpFunctionalExtensions"/>
  </ItemGroup>

  <!--
    #1844: where the banned-API analyzer package lives on disk, for the test
    that runs the analyzer in-process. `$(Pkg...)` is written by NuGet into the
    generated `obj/*.nuget.g.props`, which the SDK imports before this file is
    evaluated.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="BannedApiAnalyzersPackagePath"
                      Value="$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)"/>
  </ItemGroup>

  <!--
    Reference every Harbor project so the test runner loads each assembly into
    the default AppDomain. Architecture tests then call Assembly.GetReferencedAssemblies()
    on each to assert that the layering invariants from docs/ARCHITECTURE_LAYERS.md hold.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbor.Abstractions.Contracts\Harbor.Abstractions.Contracts.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Extensions\Harbor.Extensions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Diagnostics.Abstractions\Harbor.Diagnostics.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Terminal.Abstractions\Harbor.Terminal.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Application\Harbor.Application.csproj"/>
    <!-- #1614: onboarding one-way leaf — SlashCommandContextScopeTests /
         ReplConstructorCompositionTests / BuiltinAgentPickerProjectionRules /
         CfeValueBaselineTests bind OnboardingWizard. -->
    <ProjectReference Include="..\..\src\Harbor.Onboarding\Harbor.Onboarding.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Hooks\Harbor.Hooks.csproj"/>
    <!-- #1616: the extracted verified-change pipeline joins layer enforcement. -->
    <ProjectReference Include="..\..\src\Harbor.ChangeTracking\Harbor.ChangeTracking.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Permissions\Harbor.Permissions.csproj"/>
    <!-- #1623: NetArchLayerRules binds AgentLoop directly; the type now lives in Harbor.AgentRuntime. -->
    <ProjectReference Include="..\..\src\Harbor.AgentRuntime\Harbor.AgentRuntime.csproj"/>
    <!-- #1624: binds the moved session-context types directly. -->
    <ProjectReference Include="..\..\src\Harbor.SessionContext\Harbor.SessionContext.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Registries\Harbor.Registries.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Runtime\Harbor.Plugins.Runtime.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Providers.OpenAiCompatible\Harbor.Providers.OpenAiCompatible.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Providers.Anthropic\Harbor.Providers.Anthropic.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Providers.OpenAI\Harbor.Providers.OpenAI.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Providers.Ollama\Harbor.Providers.Ollama.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Storage.Jsonl\Harbor.Storage.Jsonl.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Storage.Memory\Harbor.Storage.Memory.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Storage.Sqlite\Harbor.Storage.Sqlite.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tools.Builtin\Harbor.Tools.Builtin.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Lsp\Harbor.Lsp.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Terminal.Pty\Harbor.Terminal.Pty.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.AnsiPlain\Harbor.Tui.AnsiPlain.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.CellForge.Engine\Harbor.Tui.CellForge.Engine.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.CellForge\Harbor.Tui.CellForge.csproj"/>
    <!-- #1617: the matrix-coverage rule loads every Presentation row's assembly;
         the Syntax sibling is one. -->
    <ProjectReference Include="..\..\src\Harbor.Tui.CellForge.Syntax\Harbor.Tui.CellForge.Syntax.csproj"/>
    <!-- #1618: same rule — the Prompts sibling (ListPromptEngine /
         FormPromptEngine extraction) is a Presentation row too. -->
    <ProjectReference Include="..\..\src\Harbor.Tui.CellForge.Prompts\Harbor.Tui.CellForge.Prompts.csproj"/>

    <!-- ROP-D Z2: every remaining main-solution src project joins enforcement
         (previously ~28 projects had zero layer rules). Harbor.CodeGen is a
         build tool outside Harbor.slnx and stays out of scope. App entry
         points (apps/) are composition roots and are unrestricted by design. -->
    <ProjectReference Include="..\..\src\Harbor.Logging\Harbor.Logging.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Transport.Remote\Harbor.Transport.Remote.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Telemetry.Core\Harbor.Telemetry.Core.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Telemetry.Otlp\Harbor.Telemetry.Otlp.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.Notifications\Harbor.Tui.Notifications.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.Abstractions\Harbor.Ipc.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.Client\Harbor.Ipc.Client.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.InProcess\Harbor.Ipc.InProcess.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.Server\Harbor.Ipc.Server.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Abstractions\Harbor.Plugins.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Storage\Harbor.Plugins.Storage.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Compilation\Harbor.Plugins.Compilation.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Instantiation\Harbor.Plugins.Instantiation.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Registration\Harbor.Plugins.Registration.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Hosting\Harbor.Plugins.Hosting.csproj"/>
    <!-- Harbor.Plugins.Host is intentionally NOT referenced/enforced: it is an
         OutputType=Exe out-of-process MCP stdio server (assembly
         harbor-plugins-host), i.e. an app/composition-root like apps/*. -->
    <ProjectReference Include="..\..\src\Harbor.Hosting\Harbor.Hosting.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework\Harbor.Ui.Framework.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Abstractions\Harbor.Ui.Framework.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.State\Harbor.Ui.Framework.State.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Services\Harbor.Ui.Framework.Services.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.ViewModels\Harbor.Ui.Framework.ViewModels.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Projection\Harbor.Ui.Framework.Projection.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Rendering\Harbor.Ui.Framework.Rendering.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Sessions\Harbor.Ui.Framework.Sessions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Desktop.Abstractions\Harbor.Desktop.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Desktop.Shared\Harbor.Desktop.Shared.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Desktop.Animations\Harbor.Desktop.Animations.csproj"/>
    <!--
      #450: two inventory entries previously relied on a TRANSITIVE copy landing
      in the test bin directory rather than an explicit reference — which is what
      let Harbor.Tui.NickConsoleEx sit on the matrix without a test reference.
      Both are now referenced explicitly so AllExpectedHarborAssembliesAreLoaded
      does not depend on another project's reference graph.
    -->
    <ProjectReference Include="..\..\src\Harbor.DesignSystem\Harbor.DesignSystem.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.NickConsoleEx\Harbor.Tui.NickConsoleEx.csproj"/>
  </ItemGroup>

</Project>
