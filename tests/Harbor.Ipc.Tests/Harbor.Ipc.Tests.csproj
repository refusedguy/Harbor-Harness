<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Ipc.Tests — tests for the IPC layer:
      * InProcessClientTests       — basic smoke tests via InProcessHarborClient
      * IpcRoundTripTests          — start server, connect client, call methods, assert response
      * EventStreamingTests        — subscribe to events, verify delivery
      * ProtocolSerializationTests — MessagePack serialize/deserialize all request/response types

    It used to reference tests/Harbor.E2E.Framework, and used NONE of its
    types. The reference was not free in either direction:

      * it dragged Harbor.Application and the whole Harbor.Ui.Framework family
        into this project's closure (24 -> 10 projects) for nothing, and
      * because a referenced TEST PROJECT's test classes are discovered inside
        every project that references it, it made the E2E framework's 26
        StateTestRunnerTests run here as well — a sixth copy, in a project
        that has nothing to do with them.

    tests/Harbor.Architecture.Tests/TestProjectReferenceRules.cs now keeps a
    test project from referencing another test project it does not use.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1861;S2931;S3881;MPK0002;MPK0003;MPK0004;NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbor.Ipc.Abstractions\Harbor.Ipc.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.InProcess\Harbor.Ipc.InProcess.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.Server\Harbor.Ipc.Server.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ipc.Client\Harbor.Ipc.Client.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Registries\Harbor.Registries.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Storage.Memory\Harbor.Storage.Memory.csproj"/>
    <!-- #1772: the shared test doubles (the capturing logger among them).
         The sibling references Harbor.Abstractions only, which this project
         already has, so the reference adds no product assembly. -->
    <ProjectReference Include="..\Harbor.TestKit.Support\Harbor.TestKit.Support.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
  </ItemGroup>

</Project>
