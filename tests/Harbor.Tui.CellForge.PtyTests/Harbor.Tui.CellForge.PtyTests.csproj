<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.Tui.CellForge.PtyTests (CE-5): L2 end-to-end scenarios for the
    ConsoleEx REPL running as a real process inside a real pseudo-terminal.

    Layer under test: the FULL wire path — termios raw mode, raw stdin bytes,
    ANSI stdout bytes, alt-screen diffing, resize — the layer that unit tests
    and TestBackend-based suites structurally cannot see (the CE-4 live-ghostty
    AccessViolation was exactly such a blind spot).

    Discipline:
      * No scenario class carries a [NotInParallel] key (#1789). The project
        used to share one "pty" key across 40 classes, which serialized the
        whole project (parallelism factor 1.00). Nothing here is shared: every
        scenario spawns its own PTY, its own child process, its own mock server
        and its own temp $HOME, and no scenario writes process-wide state:
        the fixture hands the child its HOME explicitly instead of swapping
        the process environment.
      * Concurrency is bounded by [ParallelLimiter<PtyScenarioLimit>] on
        CellForgePtyScenarioBase. One semaphore per LIMIT TYPE, so two
        permits for the whole assembly: a scenario is a spawned child
        process, and two at a time is what a four-core runner carries.
      * One key survives: "quit-gesture", held by CtrlCScenarioTests and
        CtrlCGestureScenarioTests, because the product's 2 000 ms quit window
        is measured on the app's own clock.
      * Every wait is bounded; per-test budget ~30 s.
      * Linux-only by design (CI platform); off-Linux runs are Skipped, the
        Windows ConPTY port is an explicit follow-up.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      TUnit0055: assertion overload guidance conflicts with TUnit's own idioms here.
      TUnit0015: scenarios thread cancellation implicitly — threading a CT
      parameter through the whole PtySession wait-API for analyzer parity is
      churn without behavioural gain (all waits are already deadline-bounded).
      TUnit0023: Server/Session disposal happens via the shared [After(Test)]
      teardown in ConsoleExPtyScenarioBase — the analyzer cannot see the flow.
    -->
    <NoWarn>$(NoWarn);TUnit0055;TUnit0015;TUnit0023</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbor.E2E.Framework\Harbor.E2E.Framework.csproj"/>
    <!--
      #1776: the one golden helper (Harbor.TestKit.Golden) — where the
      baseline lives, how it is compared, how it is regenerated. The part
      references Harbor.Abstractions and Harbor.Abstractions.Contracts only,
      both of which this project already has through Harbor.E2E.Framework, so
      the edge adds no product assembly to the closure.
    -->
    <ProjectReference Include="..\Harbor.TestKit.Support\Harbor.TestKit.Support.csproj"/>
  </ItemGroup>

</Project>
