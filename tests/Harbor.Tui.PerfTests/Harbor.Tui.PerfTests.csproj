<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      Renderer perf gate (renderer-unification sprint Phase 6.1). The name
      intentionally does not end in ".Tests" so the Directory.Build.targets
      name convention does not fire; IsTestProject is set explicitly to opt
      into the TUnit + MTP test-host wiring. Runnable as a reproducible local
      benchmark: dotnet run -c Release -p tests/Harbor.Tui.PerfTests
    -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      #1889: the shared cost gate (TestScalingGate, #1652) lives in
      Harbor.TestKit, and this project used to keep a DOCUMENTED SAME-API
      INTERNAL COPY of that file because TestKit dragged Harbor.Application
      into the slice this project measures. The composite TestKit no longer
      does — its closure is Harbor.Abstractions + Harbor.Abstractions.Contracts
      + itself. So the copy is gone and the shared file is used.
    -->
    <ProjectReference Include="..\Harbor.TestKit\Harbor.TestKit.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.AnsiPlain\Harbor.Tui.AnsiPlain.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.CellForge.Engine\Harbor.Tui.CellForge.Engine.csproj"/>
    <!-- #1772: the shared terminal-backend doubles. The sibling references
         Harbor.Tui.CellForge.Engine only, which this project already has,
         so the reference adds no product assembly. -->
    <ProjectReference Include="..\Harbor.TestKit.Tui\Harbor.TestKit.Tui.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.CellForge\Harbor.Tui.CellForge.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Ui.Framework.Rendering\Harbor.Ui.Framework.Rendering.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
