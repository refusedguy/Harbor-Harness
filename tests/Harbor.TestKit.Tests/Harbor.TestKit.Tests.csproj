<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The same suppression the sibling Harbor.TestKit carries: the pinned
         TUnit.Assertions analyzer is not this PR's rollout (#1836 is). -->
    <NoWarn>$(NoWarn);TUnitAssertions0005</NoWarn>
    <!--
      #1772/#1773: the tests for the shared test helpers.

      `Harbor.TestKit` is a library, not a test host, so the helpers it
      carries had nowhere to be tested until this project existed. It is a
      row in `Harbor.slnx` and a member of the `core` shard in ci.yml, so
      these tests run on every PR — a helper nobody exercises is a helper
      nobody knows still works.
    -->
    <RootNamespace>Harbor.TestKit.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Harbor.TestKit/Harbor.TestKit.csproj"/>
    <ProjectReference Include="../Harbor.TestKit.Support/Harbor.TestKit.Support.csproj"/>
    <ProjectReference Include="../Harbor.TestKit.Tui/Harbor.TestKit.Tui.csproj"/>
  </ItemGroup>

</Project>
