<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Harbor.Abstractions/Harbor.Abstractions.csproj"/>
    <ProjectReference Include="../../src/Harbor.Storage.Jsonl/Harbor.Storage.Jsonl.csproj"/>
    <ProjectReference Include="../../src/Harbor.Storage.Memory/Harbor.Storage.Memory.csproj"/>
    <!-- #741: AllocationProbe, the one sanctioned reader of a GC allocation
         counter. The allocation gates below measure through it. -->
    <ProjectReference Include="../Harbor.TestKit/Harbor.TestKit.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      #1749: the session-format CORPUS — one committed fixture per
      generation of the session format. The files are copied next to the test
      binary so the corpus is read as the on-disk artifact it is: a session
      file, not a string in a test.

      `Update`, not `Include`: the SDK already globs these files in as `None`
      items, and an `Include` of the same files is a duplicate-item error.
    -->
    <None Update="fixtures/**/*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
