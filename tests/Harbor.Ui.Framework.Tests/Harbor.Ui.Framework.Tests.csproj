<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- #1899: DiffViewModel moved to Harbor.Desktop.ViewModels. -->
    <ProjectReference Include="../../src/Harbor.Desktop.ViewModels/Harbor.Desktop.ViewModels.csproj"/>
    <ProjectReference Include="../../src/Harbor.Ui.Framework/Harbor.Ui.Framework.csproj"/>
    <ProjectReference Include="../../src/Harbor.Ui.Framework.Rendering/Harbor.Ui.Framework.Rendering.csproj"/>
    <!-- #462: SlashCommandCatalogTests pins the shared slash-command registry. -->
    <ProjectReference Include="../../src/Harbor.Ui.Framework.Abstractions/Harbor.Ui.Framework.Abstractions.csproj"/>
    <!--
      #1549: the shared UI test doubles (TestDispatcherAdapter and the counting
      view-model stubs) moved here from this assembly's own copies. TestKit's
      closure is a SUBSET of this project's existing closure — Harbor.Application
      arrives here through Harbor.Desktop.ViewModels (which carries the #188
      ProviderPresets edge), and the Ui.Framework
      family is referenced directly — so the reference adds no new product
      assembly to the slice the perf gates below measure.

      #1889: the core TestKit still ships the shared cost gates (TestScalingGate)
      this assembly's perf gates ride, so that reference stays.
    -->
    <ProjectReference Include="../Harbor.TestKit/Harbor.TestKit.csproj"/>
    <!--
      #1889: the shared UI DOUBLES moved out of the core TestKit into the
      UI-scoped `Harbor.TestKit.Tui` part, so that the eleven test projects
      that use TestKit for an unrelated reason stop compiling the UI stack.
      This project is one of the three that actually uses a double, so it
      takes the reference the core no longer implies.
    -->
    <ProjectReference Include="../Harbor.TestKit.Tui/Harbor.TestKit.Tui.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
