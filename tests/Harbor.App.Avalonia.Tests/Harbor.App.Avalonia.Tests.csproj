<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1707;S2931;S3881</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\Harbor.App.Avalonia\Harbor.App.Avalonia.csproj"/>
    <!-- #1624: binds the moved session-context types directly. -->
    <ProjectReference Include="..\..\src\Harbor.SessionContext\Harbor.SessionContext.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Plugins.Abstractions\Harbor.Plugins.Abstractions.csproj"/>
    <ProjectReference Include="..\..\tests\Harbor.TestKit\Harbor.TestKit.csproj"/>
    <!--
      #1889: the shared UI DOUBLES (TestDispatcherAdapter) live in the
      UI-scoped TestKit part now, so a consumer that uses one says so
      explicitly. The core TestKit above is UI-free.
    -->
    <ProjectReference Include="..\..\tests\Harbor.TestKit.Tui\Harbor.TestKit.Tui.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Hosting"/>
  </ItemGroup>

</Project>
