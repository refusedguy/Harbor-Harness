<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      The AnsiTuiRenderer e2e test deliberately redirects Console.Out to a
      StringWriter to capture ANSI output (TUnit0055). The original writer
      is restored in a finally block so TUnit logging is unaffected on the
      happy path and on failure.
    -->
    <NoWarn>$(NoWarn);TUnit0055</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- #1821: the shared event builders (TestEvents). The edge is
         closure-neutral — that part references only Harbor.Abstractions
         and Harbor.Abstractions.Contracts, and this project already has
         both because it already publishes events. -->
    <ProjectReference Include="..\Harbor.TestKit.Support\Harbor.TestKit.Support.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Terminal.Abstractions\Harbor.Terminal.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Tui.AnsiPlain\Harbor.Tui.AnsiPlain.csproj"/>
    <!-- TuiDemoRecorder: PTY-driven GIF recorder over the E2E driver stack. -->
    <ProjectReference Include="..\Harbor.E2E.Framework\Harbor.E2E.Framework.csproj"/>
  </ItemGroup>

</Project>
