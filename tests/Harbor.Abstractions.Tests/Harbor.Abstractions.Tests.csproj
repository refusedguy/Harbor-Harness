<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Extensions\Harbor.Extensions.csproj"/>
    <!-- #1773: the shared test helpers (the environment scope among them).
         The sibling references Harbor.Abstractions only, which this project
         already has, so the reference adds no product assembly. -->
    <ProjectReference Include="..\Harbor.TestKit.Support\Harbor.TestKit.Support.csproj"/>
    <!--
      #1889: the shared cost gate (TestScalingGate, #1652) lives in
      Harbor.TestKit, and this project used to keep a DOCUMENTED SAME-API
      INTERNAL COPY of that file because TestKit dragged Harbor.Application
      into the slice this project measures. The composite TestKit no longer
      does: its closure is Harbor.Abstractions + Harbor.Abstractions.Contracts
      + its own support part + itself, and the first two are already in this
      project's closure. So the copy is gone and the shared file is used.
    -->
    <ProjectReference Include="../Harbor.TestKit/Harbor.TestKit.csproj"/>
  </ItemGroup>

</Project>
