{
  "$schema": "https://raw.githubusercontent.com/Aviral-Bhargava/dotnet-arch/master/schema.json",
  "assemblies": {
    "Harbor.Domain": { "layer": "Domain" },
    "Harbor.Abstractions": { "layer": "Domain" },
    "Harbor.Application": { "layer": "Application" },
    "Harbor.Core": { "layer": "Application" },
    "Harbor.Registries": { "layer": "Application" },
    "Harbor.Plugins.Abstractions": { "layer": "Application" },
    "Harbor.Plugins.Storage": { "layer": "Infrastructure" },
    "Harbor.Plugins.Compilation": { "layer": "Infrastructure" },
    "Harbor.Plugins.Instantiation": { "layer": "Infrastructure" },
    "Harbor.Plugins.Registration": { "layer": "Infrastructure" },
    "Harbor.Plugins.Hosting": { "layer": "Infrastructure" },
    "Harbor.Plugins.Runtime": { "layer": "Infrastructure" },
    "Harbor.Providers.Anthropic": { "layer": "Infrastructure" },
    "Harbor.Providers.Ollama": { "layer": "Infrastructure" },
    "Harbor.Providers.OpenAI": { "layer": "Infrastructure" },
    "Harbor.Providers.OpenAiCompatible": { "layer": "Infrastructure" },
    "Harbor.Storage.Jsonl": { "layer": "Infrastructure" },
    "Harbor.Storage.Memory": { "layer": "Infrastructure" },
    "Harbor.Storage.Sqlite": { "layer": "Infrastructure" },
    "Harbor.Tools.Builtin": { "layer": "Infrastructure" },
    "Harbor.Tools.Bash": { "layer": "Infrastructure" },
    "Harbor.Tools.Edit": { "layer": "Infrastructure" },
    "Harbor.Tools.Glob": { "layer": "Infrastructure" },
    "Harbor.Tools.Grep": { "layer": "Infrastructure" },
    "Harbor.Tools.Ls": { "layer": "Infrastructure" },
    "Harbor.Tools.Mcp": { "layer": "Infrastructure" },
    "Harbor.Tools.Notebook": { "layer": "Infrastructure" },
    "Harbor.Tools.Patch": { "layer": "Infrastructure" },
    "Harbor.Tools.Read": { "layer": "Infrastructure" },
    "Harbor.Tools.RipGrep": { "layer": "Infrastructure" },
    "Harbor.Tools.Task": { "layer": "Infrastructure" },
    "Harbor.Tools.Tree": { "layer": "Infrastructure" },
    "Harbor.Tools.WebFetch": { "layer": "Infrastructure" },
    "Harbor.Tools.Write": { "layer": "Infrastructure" },
    "Harbor.Scripting.Abstractions": { "layer": "Application" },
    "Harbor.Scripting.Storage": { "layer": "Infrastructure" },
    "Harbor.Scripting.Compilation": { "layer": "Infrastructure" },
    "Harbor.Scripting.Engines": { "layer": "Infrastructure" },
    "Harbor.Scripting.Bridge": { "layer": "Infrastructure" },
    "Harbor.Scripting.Hosting": { "layer": "Infrastructure" },
    "Harbor.Tui.Abstractions": { "layer": "Presentation" },
    "Harbor.Tui.Ansi": { "layer": "Presentation" },
    "Harbor.Tui.Plain": { "layer": "Presentation" },
    "Harbor.Tui.RazorConsole": { "layer": "Presentation" },
    "Harbor.Tui.Spectre": { "layer": "Presentation" },
    "Harbor.Tui.Spectre.Fullscreen": { "layer": "Presentation" },
    "Harbor.Tui.SpectreTui": { "layer": "Presentation" },
    "Harbor.Tui.Termina": { "layer": "Presentation" },
    "Harbor.Tui.TerminalGui": { "layer": "Presentation" },
    "Harbor.Tui.Notifications": { "layer": "Presentation" },
    "Harbor.Tui.Sixel": { "layer": "Presentation" },
    "Harbor.Desktop.Abstractions": { "layer": "Presentation" },
    "Harbor.Desktop.Shared": { "layer": "Presentation" },
    "Harbor.Desktop.DesignSystem": { "layer": "Presentation" },
    "Harbor.Desktop.Animations": { "layer": "Presentation" },
    "Harbor.Ui.Framework": { "layer": "Presentation" },
    "Harbor.App.Cli": { "layer": "CompositionRoot" },
    "Harbor.App.Avalonia": { "layer": "CompositionRoot" },
    "Harbor.App.Wpf": { "layer": "CompositionRoot" },
    "Harbor.App.Blazor": { "layer": "CompositionRoot" },
    "Harbor.App.Maui": { "layer": "CompositionRoot" }
  },
  "rules": {
    "arch/circular-dependency": "error",
    "arch/layer-violation": "error"
  },
  "layers": {
    "Domain": {
      "description": "Pure domain model + abstractions (interfaces, value types, events).",
      "dependsOn": []
    },
    "Application": {
      "description": "Use-case orchestration (AgentLoop, CompactionService, MessageConverter, Plugin/Scripting abstractions).",
      "dependsOn": ["Domain"]
    },
    "Infrastructure": {
      "description": "Implementations of abstractions — providers, storage backends, tools, plugin/scripting runtimes.",
      "dependsOn": ["Domain", "Application"]
    },
    "Presentation": {
      "description": "UI renderers (TUI, desktop, web) + design system + UI framework.",
      "dependsOn": ["Domain", "Application"]
    },
    "CompositionRoot": {
      "description": "App entry points (apps/) — wire DI, build host, run UI.",
      "dependsOn": ["Domain", "Application", "Infrastructure", "Presentation"]
    }
  }
}
