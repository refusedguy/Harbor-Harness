<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    apps/Directory.Build.props — composition-root-specific analyzers.

    Every project under apps/ is a Harbor composition root (Cli, Avalonia, Wpf,
    Blazor, Maui). These are the only projects that wire up the DI container,
    so they are the only projects that need Excubo's [Exposes] validation.

    The DI lifetime analyzer (DependencyInjection.Lifetime.Analyzers) is added
    solution-wide in /Directory.Build.props because captive dependency and
    lifetime mismatch detection is valuable everywhere (libraries can declare
    Singleton types too).

    Excubo.Analyzers.Annotations provides the [Exposes(typeof(T))] attribute.
    Excubo.Analyzers.DependencyInjectionValidation is the analyzer that enforces it.
  -->

  <!--
    Imported by RELATIVE path, not by the GetPathOfFileAbove function: MSBuild
    evaluates both to the same file (this directory's parent), but the
    project-file analyzer (#1857) can only follow an import it can resolve on
    disk, and a property function is not resolvable to it. With the function
    form the analyzer never sees the solution-wide props.
  -->
  <Import Project="../Directory.Build.props"/>

  <ItemGroup>
    <!-- Annotation attribute (compile-time only) — needed so composition roots
         can put [Exposes(typeof(IAgent))] on their BuildHost methods. -->
    <PackageReference Include="Excubo.Analyzers.Annotations" ExcludeAssets="runtime">
      <IncludeAssets>compile; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <!-- Proj0037 (#1857): PrivateAssets=all means the package is not a runtime
           dependency of the app, so the runtime asset is excluded explicitly.
           The package does have a runtime assembly, but it was already outside
           IncludeAssets — this states the intent rather than changing it. -->
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Analyzer that validates [Exposes] declarations against actual
         services.AddXxx<T>() registrations in the method body. -->
    <PackageReference Include="Excubo.Analyzers.DependencyInjectionValidation" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <!-- Proj0037 (#1857): an analyzer package has no runtime assembly. -->
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Microsoft.VisualStudio.Threading.Analyzers ("vs-threading", 18.12.1) —
      the threading/async analyzer family from the Visual Studio SDK.

      It is wired to src/ and apps/ and NOT to tests/: the test tree has its
      own async culture (fixtures that block on purpose, 174 catch-all
      handlers) and already lifts TreatWarningsAsErrors, so the package would
      be noise there rather than signal.

      EXACTLY ONE of its 29 rules is on — VSTHRD110, "observe the result of
      async calls", at `suggestion`. The rest are `none` with a written reason
      in .editorconfig: four of them are Error by default (VSTHRD004,
      VSTHRD011, VSTHRD107, VSTHRD109) and a large part of the family is
      written against JoinableTaskFactory, which this repository does not
      reference.

      The gate that actually decides "is this an unobserved Task?" is
      HARCH003 in tests/Harbor.Architecture.Tests/Roslyn/ — a type-resolving
      analyzer rather than a spelling match (#1852).
    -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" ExcludeAssets="runtime">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
