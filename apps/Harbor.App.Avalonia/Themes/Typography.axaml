<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ORCA-level Typography + control styles.

        Font resources (UiFont + CodeFont) live in Dark.axaml. These are the
        Style rules that apply them globally + define the button/input/card
        visual language:

          • All UI text uses Inter (UiFont) — no monospace pollution in chat.
          • Code blocks, tool names, status pills, durations use JetBrains Mono.
          • Buttons have three variants: Primary / Secondary / Subtle.
          • Inputs (TextBox) get accent border on focus + 8px corner radius.
          • ListBoxItems get rounded hover + selected states.
    -->

    <!-- ════════════ Global TextBlock (Inter, default text color) ════════════ -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- ════════════ TextBox (ORCA-style: surface fill + accent focus) ════════════ -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource MochaSurface0}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{StaticResource InputCornerRadius}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- Watermark (placeholder) text uses subtle color -->
    <Style Selector="TextBox /template/ TextBlock[Name=PART_Watermark]">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- ════════════ Button base (transitions for smooth hover/press) ════════════ -->
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Primary: solid accent fill, dark text, hover = sapphire, pressed = lavender -->
    <Style Selector="Button.Primary">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="Opacity" Value="0.95" />
    </Style>
    <Style Selector="Button.Primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.Primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource MochaSurface0}" />
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Secondary: transparent + border, hover = subtle surface -->
    <Style Selector="Button.Secondary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MochaSurface2}" />
    </Style>
    <Style Selector="Button.Secondary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
    </Style>

    <!-- Subtle: transparent, no border, hover = subtle surface (used in toolbars) -->
    <Style Selector="Button.Subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button.Subtle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>
    <Style Selector="Button.Subtle:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
    </Style>

    <!-- Ghost: text-only with accent color, hover = subtle accent surface -->
    <Style Selector="Button.Ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>

    <!-- ════════════ ListBox / ListBoxItem (rounded hover + selected) ════════════ -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:focus">
        <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
    </Style>

    <!-- ════════════ RadioButton (ORCA-style) ════════════ -->
    <Style Selector="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="0,6" />
    </Style>

    <!-- ════════════ CheckBox ════════════ -->
    <Style Selector="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- ════════════ Menu (top menu bar) ════════════ -->
    <Style Selector="Menu">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource MochaMantle}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>

    <!-- ════════════ ScrollViewer (thin ORCA-style scrollbars) ════════════ -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="10" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{StaticResource MochaSurface1}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{StaticResource MochaSurface2}" />
    </Style>

</Styles>
