<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App-wide style overrides (above Fluent) -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style Selector="Border.CodeEditorHost">
        <Setter Property="Background" Value="{StaticResource MochaMantle}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.Sidebar">
        <Setter Property="Background" Value="{StaticResource SidebarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <Style Selector="Border.StatusBar">
        <Setter Property="Background" Value="{StaticResource StatusBarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="12,4"/>
    </Style>

    <Style Selector="Ellipse.StreamingDot">
        <Setter Property="Fill" Value="{StaticResource MochaPeach}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.CodeBlock">
        <Setter Property="Background" Value="{StaticResource MochaCrust}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ════════════ Killer-feature styles (Task R1) ════════════ -->

    <!-- Blinking cursor for TypewriterStreamingText — opacity transition
         gives a soft fade-blink rather than a hard toggle. -->
    <Style Selector="TextBlock.BlinkingCursor">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
            </Transitions>
        </Setter>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Tool-call card slide-in. Uses Style.Animations rather than
         Transitions because Transitions require an explicit property
         change to fire — without an initial RenderTransform setter,
         the previous declaration animated nothing. Style.Animations
         run once when the element enters the visual tree, which is
         exactly the "card slides in when tool call starts" effect
         Orca and Opencode ship. -->
    <Style Selector="Border.ToolCallCard">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="0"/>
            </Setter.Value>
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:0.25" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="-16"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ════════════ Task R1 enhancement: toast slide-in ════════════ -->

    <!-- Toast cards slide in from the right edge (where the toast
         container is anchored) and fade in. This is the Orca "sonner"
         pattern — without it, toasts pop in jarringly. Animation runs
         once on visual-tree entry (per-toast). -->
    <Style Selector="Border.ToastCard">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="0"/>
            </Setter.Value>
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:0.3" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="40"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
