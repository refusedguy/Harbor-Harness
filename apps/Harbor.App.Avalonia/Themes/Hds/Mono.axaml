<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        HDS Mono — dark monochrome theme (grayscale).
        Same key set as CatppuccinMocha.axaml (enforced by ThemeParityTests).
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Harbor.App.Avalonia/Themes/Hds/BaseTokens.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ════════════ Monochrome palette ════════════ -->
    <Color x:Key="MochaBase">#0A0A0A</Color>
    <Color x:Key="MochaMantle">#111111</Color>
    <Color x:Key="MochaCrust">#050505</Color>
    <Color x:Key="MochaSurface0">#1A1A1A</Color>
    <Color x:Key="MochaSurface1">#222222</Color>
    <Color x:Key="MochaSurface2">#2A2A2A</Color>

    <Color x:Key="MochaText">#E5E5E5</Color>
    <Color x:Key="MochaSubtext1">#D0D0D0</Color>
    <Color x:Key="MochaSubtext0">#B0B0B0</Color>
    <Color x:Key="MochaOverlay2">#909090</Color>
    <Color x:Key="MochaOverlay1">#707070</Color>
    <Color x:Key="MochaOverlay0">#505050</Color>

    <Color x:Key="MochaBlue">#888888</Color>
    <Color x:Key="MochaLavender">#A0A0A0</Color>
    <Color x:Key="MochaSapphire">#C0C0C0</Color>
    <Color x:Key="MochaSky">#AAAAAA</Color>
    <Color x:Key="MochaTeal">#909090</Color>
    <Color x:Key="MochaGreen">#5A5A5A</Color>
    <Color x:Key="MochaYellow">#8A8A8A</Color>
    <Color x:Key="MochaPeach">#AAAAAA</Color>
    <Color x:Key="MochaMaroon">#4A4A4A</Color>
    <Color x:Key="MochaRed">#4A4A4A</Color>
    <Color x:Key="MochaMauve">#A0A0A0</Color>
    <Color x:Key="MochaPink">#B0B0B0</Color>
    <Color x:Key="MochaFlamingo">#B0B0B0</Color>
    <Color x:Key="MochaRosewater">#C0C0C0</Color>

    <!-- ════════════ Semantic colors ════════════ -->
    <Color x:Key="AccentColor">#888888</Color>
    <Color x:Key="AccentHoverColor">#A0A0A0</Color>
    <Color x:Key="AccentPressedColor">#C0C0C0</Color>
    <Color x:Key="SuccessColor">#5A5A5A</Color>
    <Color x:Key="WarningColor">#8A8A8A</Color>
    <Color x:Key="ErrorColor">#4A4A4A</Color>
    <Color x:Key="InfoColor">#AAAAAA</Color>

    <!-- ════════════ Chat role brushes ════════════ -->
    <SolidColorBrush x:Key="ChatUserBrush" Color="{StaticResource MochaSky}" />
    <SolidColorBrush x:Key="ChatAssistantBrush" Color="{StaticResource MochaText}" />
    <SolidColorBrush x:Key="ChatThinkingBrush" Color="{StaticResource MochaOverlay2}" />
    <SolidColorBrush x:Key="ChatToolBrush" Color="{StaticResource MochaBlue}" />
    <SolidColorBrush x:Key="ChatToolResultBrush" Color="{StaticResource MochaGreen}" />
    <SolidColorBrush x:Key="ChatSystemBrush" Color="{StaticResource MochaYellow}" />
    <SolidColorBrush x:Key="ChatErrorBrush" Color="{StaticResource MochaRed}" />

    <!-- ════════════ Background brushes ════════════ -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource MochaBase}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource MochaMantle}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource MochaCrust}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource MochaMantle}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource MochaSurface0}" />
    <SolidColorBrush x:Key="CardElevatedBackgroundBrush" Color="{StaticResource MochaSurface1}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource MochaSurface0}" />
    <SolidColorBrush x:Key="HoverStrongBackgroundBrush" Color="{StaticResource MochaSurface1}" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{StaticResource MochaSurface1}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource MochaSurface0}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource MochaSurface0}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource MochaSurface1}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource MochaSurface0}" />

    <!-- ════════════ Accent + state brushes ════════════ -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource MochaBlue}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource MochaSapphire}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource MochaLavender}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0A0A0A" />
    <FontFamily x:Key="FontUi">avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI, system-ui, sans-serif</FontFamily>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource MochaGreen}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource MochaYellow}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource MochaRed}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource MochaSky}" />

    <!-- ════════════ Text brushes ════════════ -->
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource MochaText}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource MochaText}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource MochaSubtext0}" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource MochaSubtext0}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource MochaOverlay2}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource MochaOverlay1}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource MochaOverlay1}" />

    <!-- ════════════ Status brushes ════════════ -->
    <SolidColorBrush x:Key="StatusIdleBrush" Color="{StaticResource MochaSubtext0}" />
    <SolidColorBrush x:Key="StatusRunningBrush" Color="{StaticResource MochaBlue}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource MochaRed}" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource MochaGreen}" />

    <!-- ════════════ State brushes (HDS token names) ════════════ -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource MochaBlue}" />
    <SolidColorBrush x:Key="AccentHoverBrush_HDS" Color="{StaticResource MochaSapphire}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource MochaBlue}" Opacity="0.1" />
    <SolidColorBrush x:Key="StateErrorBrush" Color="{StaticResource MochaRed}" />
    <SolidColorBrush x:Key="StateWarningBrush" Color="{StaticResource MochaYellow}" />
    <SolidColorBrush x:Key="StateSuccessBrush" Color="{StaticResource MochaGreen}" />
    <SolidColorBrush x:Key="StateRunningBrush" Color="{StaticResource MochaBlue}" />
    <SolidColorBrush x:Key="StateIdleBrush" Color="{StaticResource MochaOverlay2}" />
    <SolidColorBrush x:Key="StateInfoBrush" Color="{StaticResource MochaSky}" />
    <SolidColorBrush x:Key="StatePendingBrush" Color="{StaticResource MochaSubtext0}" />

    <!-- ════════════ Surface semantic brushes ════════════ -->
    <SolidColorBrush x:Key="BgAppBrush" Color="{StaticResource MochaBase}" />
    <SolidColorBrush x:Key="BgSubtleBrush" Color="{StaticResource MochaSurface0}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource MochaSurface0}" />
    <SolidColorBrush x:Key="BgPanelElevatedBrush" Color="{StaticResource MochaSurface1}" />
    <SolidColorBrush x:Key="BgOverlayBrush" Color="#80000000" />
    <SolidColorBrush x:Key="BgGlassBrush" Color="#111111" />

    <!-- ════════════ Legacy aliases (for Dark.axaml / HarborDark.axaml compat) ════════════ -->
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource MochaMantle}" />
    <SolidColorBrush x:Key="BgRailBrush" Color="{StaticResource MochaMantle}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource MochaSurface0}" />
    <SolidColorBrush x:Key="BgSelectedBrush" Color="{StaticResource MochaSurface1}" />

    <!-- ════════════ Stepper brushes ════════════ -->
    <SolidColorBrush x:Key="StepperActiveBrush" Color="{StaticResource MochaBlue}" />
    <SolidColorBrush x:Key="StepperDoneBrush" Color="{StaticResource MochaBlue}" />
    <SolidColorBrush x:Key="StepperPendingBrush" Color="{StaticResource MochaSurface1}" />
    <SolidColorBrush x:Key="StepperConnectorBrush" Color="{StaticResource MochaSurface1}" />

    <!-- ════════════ Cost brushes ════════════ -->
    <SolidColorBrush x:Key="CostLowBrush" Color="{StaticResource MochaGreen}" />
    <SolidColorBrush x:Key="CostMidBrush" Color="{StaticResource MochaYellow}" />
    <SolidColorBrush x:Key="CostHighBrush" Color="{StaticResource MochaRed}" />

    <!-- ════════════ Cost text colors ════════════ -->
    <Color x:Key="CostLowColor">#5A5A5A</Color>
    <Color x:Key="CostMidColor">#8A8A8A</Color>
    <Color x:Key="CostHighColor">#4A4A4A</Color>

    <!-- ════════════ Window caption colors ════════════ -->
    <Color x:Key="WindowCaptionHoverColor">#222222</Color>
    <Color x:Key="WindowCaptionActiveColor">#2A2A2A</Color>

</ResourceDictionary>
