<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light theme — Catppuccin-Latte.
        Use by calling ThemeService.ApplyLight() (Ctrl+Shift+T).
    -->

    <Color x:Key="LatteBase">#EFF1F5</Color>
    <Color x:Key="LatteMantle">#E6E9EF</Color>
    <Color x:Key="LatteCrust">#DCE0E8</Color>
    <Color x:Key="LatteSurface0">#CCD0DA</Color>
    <Color x:Key="LatteSurface1">#BCC0CC</Color>
    <Color x:Key="LatteText">#4C4F69</Color>
    <Color x:Key="LatteSubtext0">#6C6F85</Color>
    <Color x:Key="LatteBlue">#1E66F5</Color>
    <Color x:Key="LattePink">#EA76CB</Color>
    <Color x:Key="LatteRed">#D20F39</Color>
    <Color x:Key="LatteGreen">#40A02B</Color>
    <Color x:Key="LatteYellow">#DF8E1D</Color>
    <Color x:Key="LattePeach">#FE640B</Color>
    <Color x:Key="LatteTeal">#179299</Color>
    <Color x:Key="LatteSky">#04A5E5</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush"        Color="{StaticResource LatteBase}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush"      Color="{StaticResource LatteMantle}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush"    Color="{StaticResource LatteCrust}"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush"  Color="{StaticResource LatteMantle}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"       Color="{StaticResource LatteSurface0}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush"      Color="{StaticResource LatteSurface0}"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush"   Color="{StaticResource LatteSurface1}"/>
    <SolidColorBrush x:Key="BorderBrush"               Color="{StaticResource LatteSurface0}"/>
    <SolidColorBrush x:Key="AccentBrush"               Color="{StaticResource LatteBlue}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush"              Color="{StaticResource LatteGreen}"/>
    <SolidColorBrush x:Key="WarningBrush"              Color="{StaticResource LattePeach}"/>
    <SolidColorBrush x:Key="ErrorBrush"                Color="{StaticResource LatteRed}"/>
    <SolidColorBrush x:Key="TextBrush"                 Color="{StaticResource LatteText}"/>
    <SolidColorBrush x:Key="TextSubtleBrush"           Color="{StaticResource LatteSubtext0}"/>

</ResourceDictionary>
