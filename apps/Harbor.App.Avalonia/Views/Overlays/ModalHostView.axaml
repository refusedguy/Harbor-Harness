<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Harbor.App.Avalonia.Views"
             x:Class="Harbor.App.Avalonia.Views.Overlays.ModalHostView">

    <Border Name="PART_Scrim"
            Background="{DynamicResource BgOverlayBrush}"
            Opacity="0"
            IsVisible="{Binding HasOverlay}"
            ZIndex="700"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            PointerPressed="OnScrim_Click">

        <Border Name="PART_Card"
                Background="{DynamicResource BgPanelElevatedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusLg}"
                BoxShadow="0 24 48 0 #40000000"
                Opacity="{Binding CardOpacity}"
                RenderTransformOrigin="0.5,0.5"
                Width="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.RenderTransform>
                <ScaleTransform ScaleX="{Binding CardScale}" ScaleY="{Binding CardScale}" />
            </Border.RenderTransform>

            <ContentControl Name="PART_Content"
                            Content="{Binding OverlayContent}"
                            Margin="20" />
        </Border>
    </Border>
</UserControl>
