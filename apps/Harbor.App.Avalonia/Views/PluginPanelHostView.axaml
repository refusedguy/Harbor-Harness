<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Harbor.App.Avalonia.Views.PluginPanelHostView">

    <!--
        Plugin panel host — right-dock placeholder for IPanelProvider contributions.
        Production v0.5 will resolve registered panels from the IPanelRegistry and
        render them as tabbed content here. For v0.4 we keep this as a hidden dock.
    -->
    <Border Background="{StaticResource MochaCrust}" Padding="8">
        <TextBlock Text="Plugin panels (v0.5)" Foreground="{StaticResource MochaOverlay2}"
                   FontFamily="{StaticResource CodeFont}" FontSize="11"/>
    </Border>
</UserControl>
