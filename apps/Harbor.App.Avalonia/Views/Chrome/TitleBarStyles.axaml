<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- TitleBarStyles — traffic-light buttons for the custom title bar.
         Located in Views/Chrome/ and included via App.axaml Styles. -->

    <Style Selector="Button.TrafficLight">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionFast}"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.TrafficLight /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.TrafficLight.Close">       <Setter Property="Background" Value="#FF5F57"/></Style>
    <Style Selector="Button.TrafficLight.Minimize">    <Setter Property="Background" Value="#FEBC2E"/></Style>
    <Style Selector="Button.TrafficLight.Maximize">    <Setter Property="Background" Value="#28C840"/></Style>
    <Style Selector="Button.TrafficLight PathIcon">
        <Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="#66000000"/>
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="StackPanel.TrafficLights:pointerover Button.TrafficLight PathIcon">
        <Setter Property="Opacity" Value="1"/>
    </Style>

</Styles>
