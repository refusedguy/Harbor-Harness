<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vma="clr-namespace:Harbor.Desktop.Abstractions.ViewModels;assembly=Harbor.Desktop.Abstractions"
        xmlns:views="clr-namespace:Harbor.App.Avalonia.Views"
        x:Class="Harbor.App.Avalonia.Views.OnboardingWindow"
        Title="Harbor — Welcome"
        Width="720" Height="640"
        MinWidth="600" MinHeight="540"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgAppBrush}"
        FontFamily="{DynamicResource FontUi}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="Full">

    <Window.Resources>
        <views:EqualityConverter x:Key="EqualityConv" />
        <views:InequalityConverter x:Key="InequalityConv" />
        <views:FinishLabelConverter x:Key="FinishLabelConv" />
        <views:StepToStepperBrushConverter x:Key="StepBrushConv" />
    </Window.Resources>

    <!--
        Root DockPanel so the custom-drawn title bar (matching the one in
        MainWindow.axaml) sits above the wizard body. Same
        ExtendClientAreaChromeHints=PreferNone trick: hide the native Windows
        caption buttons so the onboarding window's chrome matches the main
        window's chrome — no jarring "white Windows bar" between the wizard
        and the main app.
    -->
    <DockPanel LastChildFill="True">

        <!-- Custom Windows title bar (matches MainWindow.axaml) -->
        <Border x:Name="TitleBar"
                DockPanel.Dock="Top"
                Height="36"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="⚓" FontSize="14" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Harbor — Welcome" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <Button Classes="WindowButton" Click="Minimize_Click"
                            ToolTip.Tip="Minimize"
                            Content="&#xE949;" />
                    <Button Classes="WindowButton WindowButtonClose" Click="Close_Click"
                            ToolTip.Tip="Close"
                            Content="&#xE8BB;" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid RowDefinitions="Auto,*,Auto" Margin="36,28,36,24">

            <!-- ════════════ Header: brand + progress stepper + step title ════════════ -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,20">

                <!-- Brand + welcome -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                    <TextBlock Text="⚓" FontSize="28" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Harbor" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Progress stepper: 5 dots connected by lines.
                 Each dot is colored by the StepToStepperBrushConverter
                 based on whether its index is < / = / > CurrentStep. -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto"
                      HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Ellipse Grid.Column="0" Width="12" Height="12"
                             Fill="{Binding CurrentStep, Converter={StaticResource StepBrushConv}, ConverterParameter=1}" />
                    <Rectangle Grid.Column="1" Height="2" Fill="{StaticResource StepperConnectorBrush}"
                               VerticalAlignment="Center" Margin="2,0" />
                    <Ellipse Grid.Column="2" Width="12" Height="12"
                             Fill="{Binding CurrentStep, Converter={StaticResource StepBrushConv}, ConverterParameter=2}" />
                    <Rectangle Grid.Column="3" Height="2" Fill="{StaticResource StepperConnectorBrush}"
                               VerticalAlignment="Center" Margin="2,0" />
                    <Ellipse Grid.Column="4" Width="12" Height="12"
                             Fill="{Binding CurrentStep, Converter={StaticResource StepBrushConv}, ConverterParameter=3}" />
                    <Rectangle Grid.Column="5" Height="2" Fill="{StaticResource StepperConnectorBrush}"
                               VerticalAlignment="Center" Margin="2,0" />
                    <Ellipse Grid.Column="6" Width="12" Height="12"
                             Fill="{Binding CurrentStep, Converter={StaticResource StepBrushConv}, ConverterParameter=4}" />
                    <Rectangle Grid.Column="7" Height="2" Fill="{StaticResource StepperConnectorBrush}"
                               VerticalAlignment="Center" Margin="2,0" />
                    <Ellipse Grid.Column="8" Width="12" Height="12"
                             Fill="{Binding CurrentStep, Converter={StaticResource StepBrushConv}, ConverterParameter=5}" />
                </Grid>

                <!-- Step title + "Step N of 5" caption -->
                <TextBlock Grid.Row="2" Text="{Binding StepTitle}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="3" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding CurrentStep, StringFormat='Step {0} of 5'}" />
            </Grid>

            <!-- ════════════ Body: changes per step (ORCA card) ════════════ -->
            <Border Grid.Row="1" Classes="CardElevated" CornerRadius="12" Padding="24">
                <Panel>

                    <!-- Step 1: Welcome -->
                    <StackPanel
                        IsVisible="{Binding CurrentStep, Converter={StaticResource EqualityConv}, ConverterParameter=1}"
                        Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Your local-first AI coding agent."
                                   FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock
                            Text="This wizard takes about a minute and sets up your first provider, default model, and theme. You can change any of this later in Settings."
                            TextWrapping="Wrap" Foreground="{StaticResource TextSubtleBrush}"
                            HorizontalAlignment="Center" TextAlignment="Center" />
                        <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="8"
                                Padding="12,10" Margin="0,8,0,0"
                                BorderBrush="{DynamicResource StateSuccessBrush}" BorderThickness="2,0,0,0">
                            <TextBlock
                                Text="💡 Tip: pick Ollama if you want to run models locally — no API key required."
                                TextWrapping="Wrap" Foreground="{DynamicResource StateSuccessBrush}" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <!-- Step 2: Provider selection (with icons) -->
                    <StackPanel
                        IsVisible="{Binding CurrentStep, Converter={StaticResource EqualityConv}, ConverterParameter=2}"
                        Spacing="8">
                        <TextBlock Text="Select at least one provider:" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextSubtleBrush}" FontSize="13"
                                   Classes="Label" />
                        <ScrollViewer Height="340" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Providers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vma:OnboardingProviderOption">
                                        <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="8"
                                                Padding="14,10" Margin="0,3"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1,1,1,1">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                          Click="Provider_Checkbox_Changed"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Icon}"
                                                           FontSize="22" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Margin="12,0,8,0" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                               FontSize="14" />
                                                    <TextBlock Text="{Binding AuthEnvVar, StringFormat='env: {0}'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               FontFamily="{DynamicResource FontMono}"
                                                               IsVisible="{Binding RequiresKey}" />
                                                    <TextBlock Text="local — no key required"
                                                               FontSize="11" Foreground="{DynamicResource StateSuccessBrush}"
                                                               IsVisible="{Binding !RequiresKey}" />
                                                </StackPanel>
                                                <Border Grid.Column="3" Background="{DynamicResource BgPanelBrush}"
                                                        CornerRadius="4" Padding="8,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DefaultModel}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               FontFamily="{DynamicResource FontMono}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Step 3: API key -->
                    <StackPanel
                        IsVisible="{Binding CurrentStep, Converter={StaticResource EqualityConv}, ConverterParameter=3}"
                        Spacing="14" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                            <TextBlock Text="{Binding SelectedProvider.Icon}" FontSize="32"
                                       VerticalAlignment="Center" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding SelectedProvider.DisplayName}" FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Enter your API key" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock IsVisible="{Binding SelectedProvider.RequiresKey}"
                                   Text="{Binding SelectedProvider.AuthEnvVar, StringFormat='Will be saved to the {0} field in ~/.harbor/config.json'}"
                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        <TextBox IsVisible="{Binding SelectedProvider.RequiresKey}"
                                 Text="{Binding ApiKey, Mode=TwoWay}"
                                 PlaceholderText="sk-…"
                                 PasswordChar="•"
                                 FontFamily="{DynamicResource FontMono}"
                                 MinHeight="44" />
                        <Border IsVisible="{Binding !SelectedProvider.RequiresKey}"
                                Background="{DynamicResource BgSubtleBrush}" CornerRadius="8"
                                Padding="14,10"
                                BorderBrush="{DynamicResource StateSuccessBrush}" BorderThickness="2,0,0,0">
                            <TextBlock Text="✓ This provider doesn't need an API key. Click Next to continue."
                                       TextWrapping="Wrap" Foreground="{DynamicResource StateSuccessBrush}" FontSize="13" />
                        </Border>
                    </StackPanel>

                    <!-- Step 4: Default model -->
                    <StackPanel
                        IsVisible="{Binding CurrentStep, Converter={StaticResource EqualityConv}, ConverterParameter=4}"
                        Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="Pick the default model for new sessions:"
                                   Foreground="{StaticResource TextSubtleBrush}" FontSize="13"
                                   Classes="Label" />
                        <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="8"
                                Padding="12,8"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SelectedProvider.Icon}" FontSize="20"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedProvider.DisplayName, StringFormat='Provider: {0}'}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBox Text="{Binding DefaultModel, Mode=TwoWay}"
                                 PlaceholderText="model id"
                                 FontFamily="{DynamicResource FontMono}"
                                 MinHeight="44" />
                        <TextBlock Text="You can switch models anytime with /model or in Settings."
                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Step 5: Theme -->
                    <StackPanel
                        IsVisible="{Binding CurrentStep, Converter={StaticResource EqualityConv}, ConverterParameter=5}"
                        Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="Choose your theme:" Foreground="{StaticResource TextSubtleBrush}"
                                   FontSize="13"
                                   Classes="Label" />
                        <StackPanel Spacing="8">
                            <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="8" Padding="14,10"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <RadioButton Content="🌙  Dark (Catppuccin Mocha)" GroupName="Theme"
                                             FontSize="14"
                                             IsChecked="{Binding ThemeChoice, Converter={StaticResource EqualityConv}, ConverterParameter=dark, Mode=TwoWay}" />
                            </Border>
                            <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="8" Padding="14,10"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <RadioButton Content="☀️  Light (Catppuccin Latte)" GroupName="Theme"
                                             FontSize="14"
                                             IsChecked="{Binding ThemeChoice, Converter={StaticResource EqualityConv}, ConverterParameter=light, Mode=TwoWay}" />
                            </Border>
                            <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="8" Padding="14,10"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <RadioButton Content="🖥  System" GroupName="Theme"
                                             FontSize="14"
                                             IsChecked="{Binding ThemeChoice, Converter={StaticResource EqualityConv}, ConverterParameter=system, Mode=TwoWay}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Click Finish to save and start using Harbor."
                                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                </Panel>
            </Border>

            <!-- ════════════ Footer: nav buttons (ORCA Primary/Secondary) ════════════ -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,20,0,0">

                <Button Grid.Column="0" Classes="Ghost" Content="Skip"
                        Command="{Binding SkipCommand}"
                        ToolTip.Tip="Skip onboarding — opens the main window with defaults" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12"
                           IsVisible="{Binding IsBusy}" />

                <Button Grid.Column="2" Classes="Secondary" Content="← Back"
                        Command="{Binding BackCommand}"
                        Margin="0,0,10,0"
                        IsVisible="{Binding CurrentStep, Converter={StaticResource InequalityConv}, ConverterParameter=1}" />
                <Button Grid.Column="3" Classes="Primary"
                        Content="{Binding CurrentStep, Converter={StaticResource FinishLabelConv}}"
                        Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanAdvance}"
                        MinWidth="120" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
