<Styles xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- HdsPill — theme-aware pill-shaped control.
         Uses RadiusFull, Space2 tokens. Transitions: EaseNormal on hover/press.
         Disabled state uses TextTertiaryBrush (available in both Dark.axaml and HarborDark.axaml). -->

    <Style Selector="Button.hds-pill">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
        <Setter Property="Padding" Value="{StaticResource PaddingPill}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="{StaticResource EaseNormal}" />
                <BrushTransition Property="Foreground" Duration="{StaticResource EaseNormal}" />
                <BrushTransition Property="BorderBrush" Duration="{StaticResource EaseNormal}" />
                <DoubleTransition Property="Opacity" Duration="{StaticResource EaseNormal}" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.hds-pill:hover">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>

    <Style Selector="Button.hds-pill:pressed">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Button.hds-pill:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
</Styles>
