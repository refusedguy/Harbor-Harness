<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Avalonia;assembly=Avalonia.Base"
             x:Class="Harbor.App.Avalonia.Views.Components.EmptyState"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

    <Border Name="PART_Border"
            Background="{DynamicResource BgPanelBrush}"
            CornerRadius="{DynamicResource RadiusLg}"
            Padding="20">

        <StackPanel Name="PART_Stack"
                    Orientation="Vertical"
                    Spacing="{DynamicResource Space3}"
                    HorizontalAlignment="Center">

            <ContentControl Name="PART_Icon"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            Content="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Opacity="0.5"
                            Foreground="{DynamicResource TextTertiaryBrush}" />

            <TextBlock Name="PART_Title"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="{DynamicResource FontWeightSemiBold}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <TextBlock Name="PART_Subtitle"
                       Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="320" />

            <ContentControl Name="PART_Cta"
                           HorizontalAlignment="Center"
                           Content="{Binding Cta, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <ItemsControl ItemsSource="{Binding Suggestions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Command}"
                                CommandParameter="{Binding Prompt}">
                            <Border Background="{DynamicResource BgSubtleBrush}"
                                    CornerRadius="{DynamicResource RadiusMd}"
                                    Padding="10,6"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding Label}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
