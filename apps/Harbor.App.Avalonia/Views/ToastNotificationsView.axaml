<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:srv="clr-namespace:Harbor.Ui.Framework.Services;assembly=Harbor.Ui.Framework"
             xmlns:views="clr-namespace:Harbor.App.Avalonia.Views"
             x:Class="Harbor.App.Avalonia.Views.ToastNotificationsView"
             Background="Transparent"
             IsHitTestVisible="True">

    <!--
        Toast container — floating, bottom-right, ABOVE the status bar.

        Parent (MainWindow.axaml) places this UserControl as a SIBLING of the
        main DockPanel inside the root <Grid> (no row defs) with:
            ZIndex="1000"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,16,48"   (48 = status bar height + breathing room)
            IsHitTestVisible="True"
            Background="Transparent"

        So this UserControl just needs to stack the toasts vertically. We
        also clamp the width so very long messages don't stretch across the
        chat area, and align the stack to the right edge.

        The UserControl itself has Background="Transparent" + IsHitTestVisible="True"
        so the empty area around the toasts doesn't capture clicks (lets the
        underlying UI receive them) while the toasts themselves remain
        interactive (close button etc.).
    -->

    <ItemsControl ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Background="Transparent">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="srv:ToastNotification">
                <Border Classes="ToastCard"
                        Background="{StaticResource MochaSurface0}"
                        CornerRadius="8"
                        Padding="14,10"
                        BorderBrush="{Binding Kind, Converter={x:Static views:ToastBrushConverter.Instance}}"
                        BorderThickness="3,0,0,0"
                        BoxShadow="0 6 16 0 #80000000"
                        MinWidth="280" MaxWidth="380">
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Kind, Converter={x:Static views:ToastIconConverter.Instance}}"
                                       FontSize="14" VerticalAlignment="Center"
                                       Foreground="{Binding Kind, Converter={x:Static views:ToastBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding Kind, StringFormat='{}{0}'}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Kind, Converter={x:Static views:ToastBrushConverter.Instance}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13" LineHeight="18" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
