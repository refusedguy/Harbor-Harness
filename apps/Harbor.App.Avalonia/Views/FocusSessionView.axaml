<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Harbor.App.Avalonia.Views.FocusSessionView"
             Background="#80000000"
             PointerPressed="Backdrop_Click">

    <Border Background="{DynamicResource BgAppBrush}" CornerRadius="16"
            Width="640" Height="420" Padding="32"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BoxShadow="0 24 64 0 #80000000">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="Focus Mode" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" />
            <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,20" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
                <TextBlock Text="{Binding Model, TargetNullValue='—'}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding Provider, TargetNullValue='—'}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding Agent, TargetNullValue='—'}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <TextBlock Text="Esc to exit" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Classes="Subtle" Content="Exit Focus Mode" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
