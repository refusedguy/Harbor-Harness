<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uvm="clr-namespace:Harbor.Ui.Framework.ViewModels;assembly=Harbor.Ui.Framework.ViewModels"
             xmlns:views="clr-namespace:Harbor.App.Avalonia.Views"
             xmlns:ctrl="clr-namespace:Harbor.App.Avalonia.Views.Controls"
             xmlns:comp="clr-namespace:Harbor.App.Avalonia.Views.Components"
             xmlns:da="clr-namespace:Harbor.Ui.Framework.ViewModels;assembly=Harbor.Ui.Framework.ViewModels"
             x:Class="Harbor.App.Avalonia.Views.ChatView"
             x:Name="Root">


    <!--
        ORCA-level ChatView.

        Visual language:
          • Chat content uses UiFont (Inter) — no monospace pollution.
          • Role gutter (left) is a small accent pill in JetBrains Mono.
          • Each chat line is a card with rounded corners + subtle surface.
          • Tool-call cards slide in from the left (animation in AppStyles).
          • Streaming buffer sits above the input — soft accent background.
          • Input: multi-line TextBox, Enter = send, Shift+Enter = newline.
            The KeyDown handler sets e.Handled = true BEFORE invoking Send,
            which prevents Avalonia's TextBox from inserting a newline.
          • Send button is Primary (accent fill, dark text, hover = sky).
    -->

    <Grid RowDefinitions="*,Auto,Auto">

        <!-- ════════════ Chat history ════════════ -->
        <!-- Ф-A1b: ONE virtualized ListBox is the scroller AND the timeline —
             the previous ScrollViewer+StackPanel+2×ItemsControl never
             virtualized (infinite-height host) and split tool cards from
             messages. Pull-to-refresh transforms stay on the content host. -->
        <Border x:Name="ScrollContentHost" Grid.Row="0" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding ContentScale}" ScaleY="{Binding ContentScale}" />
                    <TranslateTransform Y="{Binding PullOffset}" />
                </TransformGroup>
            </Border.RenderTransform>
        <ListBox
                 x:Name="TimelineList"
                 ItemsSource="{Binding Timeline}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single"
                 PointerWheelChanged="ChatScrollViewer_PointerWheelChanged">
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <!-- A3: fade+slide entrance for realized rows. -->
                    <Style Selector="^">
                        <Style.Animations>
                            <Animation Duration="0:0:0.15" Easing="CubicEaseOut" FillMode="Forward">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="TranslateTransform.Y" Value="8" />
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="TranslateTransform.Y" Value="0" />
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <!-- Avalonia 12: typed DataTemplates in Resources are not
                     supported by this compiler, so ONE untyped template hosts
                     both visuals and toggles by the IsToolCard marker. -->
                <DataTemplate>
                    <Panel>
                        <ctrl:ToolCallCardView IsVisible="{Binding IsToolCard}" />
                        <Grid Margin="12,6,12,6" ColumnDefinitions="100,*" IsVisible="{Binding !IsToolCard}">
                            <!-- Role pill (JetBrains Mono, accent color) -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BgSubtleBrush}"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    BorderBrush="{Binding BrushKey, Converter={x:Static views:BrushKeyConverter.Instance}}"
                                    BorderThickness="2,0,0,0">
                                <TextBlock Text="{Binding RoleLabel}" FontFamily="{DynamicResource FontMono}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding BrushKey, Converter={x:Static views:BrushKeyConverter.Instance}}" />
                            </Border>
                            <!-- Message body — MarkdownRenderer -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BgRailBrush}"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="10,0,0,0"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1">
                                <ctrl:MarkdownRenderer Markdown="{Binding Text}" />
                            </Border>
                        </Grid>
                    </Panel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Border>

                <Border x:Name="PullIndicator"
                        Height="60"
                        VerticalAlignment="Top"
                        IsVisible="{Binding ShowPullIndicator}"
                        Opacity="{Binding PullProgress}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <PathIcon Data="{StaticResource IcRefresh}"
                              Width="20" Height="20"
                              Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding PullRefreshStatusText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   FontFamily="{DynamicResource FontMono}" />
                    </StackPanel>
                </Border>

        <!-- ════════════ Empty-state placeholder ════════════
             Shown when there are no chat lines and no tool calls and the
             agent isn't streaming/thinking. -->
        <comp:EmptyState Grid.Row="0"
                         Title="What are we building today?"
                         Subtitle="Harbor runs local-first agents over your tools and files — ask anything."
                         Suggestions="{Binding ContextualSuggestions}"
                         IsVisible="{Binding Lines.Count, Converter={x:Static views:EqualityConverter.Instance}, ConverterParameter=0}">
            <comp:EmptyState.Icon>
                <PathIcon Data="{StaticResource IcMessage}" Width="40" Height="40" />
            </comp:EmptyState.Icon>

            <!-- B2: hero composer — a real input in the center card while the
                 transcript is empty. Shares InputText/SendCommand with the
                 docked composer below; the docked one stays for continuity.
                 Injected via the Cta SLOT: a direct child element would replace
                 the whole UserControl content tree. -->
            <comp:EmptyState.Cta>
            <Border HorizontalAlignment="Center"
                    Width="560"
                    Background="{DynamicResource BgRailBrush}"
                    BorderBrush="#12FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="4">
                <TextBox x:Name="HeroInputBox"
                         AutomationProperties.Name="Chat input"
                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Ask Harbor anything…  ⏎ send · ⇧⏎ newline"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="120"
                         FontSize="14"
                         Padding="12,10"
                         BorderThickness="0"
                         Background="Transparent"
                         KeyDown="InputBox_KeyDown" />
            </Border>
            </comp:EmptyState.Cta>
        </comp:EmptyState>

        <!-- ════════════ Streaming / thinking indicators ════════════
             All three indicators live in a StackPanel so they don't overlap.
             Only one is visible at a time:
             - IsAgentRunning (not streaming): "Agent is running…" with blinking dots
             - IsStreaming: streaming text with typewriter cursor (wraps properly)
             - IsThinking: "thinking…" with emoji
        -->
        <StackPanel Grid.Row="1" Spacing="4">
            <!-- Agent-running banner -->
            <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="8"
                    Padding="14,10" Margin="12,4,12,4"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0"
                    IsVisible="{Binding IsAgentRunning}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="10" Height="10" Classes="StreamingDot" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontMono}" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="●●●" Foreground="{DynamicResource AccentBrush}" FontSize="10"
                               VerticalAlignment="Center" Opacity="0.7"
                               Classes="BlinkingCursor" />
                </StackPanel>
            </Border>

            <!-- Streaming buffer — VERTICAL layout, wraps properly, no overflow -->
            <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="8"
                    Padding="14,10" Margin="12,4,12,4"
                    BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="2,0,0,0"
                    IsVisible="{Binding IsStreaming}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Classes="StreamingDot" VerticalAlignment="Center" />
                        <TextBlock Text="streaming" Foreground="{DynamicResource StateWarningBrush}" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontMono}" FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Streaming text: wraps, bounded width, no overflow -->
                    <ctrl:MarkdownRenderer Markdown="{Binding StreamingBuffer}"
                                           MaxWidth="800" />
                </StackPanel>
            </Border>

            <!-- Thinking indicator -->
            <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="8"
                    Padding="14,8" Margin="12,4,12,4"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0"
                    IsVisible="{Binding IsThinking}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="8" Height="8" Classes="StreamingDot" VerticalAlignment="Center" />
                    <TextBlock Text="thinking…" Foreground="{DynamicResource AccentBrush}"
                               FontFamily="{DynamicResource FontMono}" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ════════════ Input area (ORCA-style) ════════════
             IsVisible binds to #Root.ShowInputArea so the Orca shell can hide
             the inline input area when its own ComposerView takes over. -->
        <Border Grid.Row="2" Background="{DynamicResource BgRailBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="12,10"
                IsVisible="{Binding #Root.ShowInputArea}">
            <StackPanel Orientation="Vertical">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         AutomationProperties.Name="Message input"
                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Message Harbor…"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="48" MaxHeight="160"
                         FontSize="14"
                         Padding="12,10"
                         KeyDown="InputBox_KeyDown" />
                <Button Grid.Column="1" Classes="Primary" Content="Send ▶"
                        AutomationProperties.Name="Send message"
                        Command="{Binding SendCommand}"
                        Margin="8,0,0,0"
                        Padding="20,12"
                        VerticalAlignment="Bottom" />
                <Button Grid.Column="1" Classes="Secondary" Content="Stop ■"
                        AutomationProperties.Name="Stop generation"
                        Command="{Binding StopCommand}"
                        Margin="8,0,0,0"
                        Padding="16,12"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding IsThinking}" />
            </Grid>
            <!-- C3: kbd chips replace the long instructional placeholder. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,6,0,0">
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="⏎ send" FontFamily="{DynamicResource FontMono}"
                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="⇧⏎ newline" FontFamily="{DynamicResource FontMono}"
                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
