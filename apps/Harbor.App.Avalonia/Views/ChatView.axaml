<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Harbor.App.Avalonia.ViewModels"
             xmlns:views="clr-namespace:Harbor.App.Avalonia.Views"
             xmlns:ctrl="clr-namespace:Harbor.App.Avalonia.Views.Controls"
             x:Class="Harbor.App.Avalonia.Views.ChatView">

    <!--
        ORCA-level ChatView.

        Visual language:
          • Chat content uses UiFont (Inter) — no monospace pollution.
          • Role gutter (left) is a small accent pill in JetBrains Mono.
          • Each chat line is a card with rounded corners + subtle surface.
          • Tool-call cards slide in from the left (animation in AppStyles).
          • Streaming buffer sits above the input — soft accent background.
          • Input: multi-line TextBox, Enter = send, Shift+Enter = newline.
            The KeyDown handler sets e.Handled = true BEFORE invoking Send,
            which prevents Avalonia's TextBox from inserting a newline.
          • Send button is Primary (accent fill, dark text, hover = sky).
    -->

    <Grid RowDefinitions="*,Auto,Auto">

        <!-- ════════════ Chat history ════════════ -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Tool-call cards (killer feature #2). -->
                <ItemsControl ItemsSource="{Binding ToolCalls}" Padding="12,8,12,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ToolCallViewModel">
                            <ctrl:ToolCallCardView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Text transcript (non-tool lines) — ORCA-style chat rows. -->
                <ItemsControl ItemsSource="{Binding Lines}" Padding="12,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ChatLineViewModel">
                            <Grid Margin="0,6" ColumnDefinitions="100,*">
                                <!-- Role pill (JetBrains Mono, accent color) -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource MochaSurface0}"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{Binding BrushKey, Converter={x:Static views:BrushKeyConverter.Instance}}"
                                        BorderThickness="2,0,0,0">
                                    <TextBlock Text="{Binding RoleLabel}" FontFamily="{StaticResource CodeFont}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding BrushKey, Converter={x:Static views:BrushKeyConverter.Instance}}"/>
                                </Border>
                                <!-- Message body — plain TextBlock. (The MarkdownRenderer
                                     control was stubbed out in another subagent's WIP but
                                     doesn't compile under .NET 10 + Markdig 0.38 — restore
                                     it once the markdig API migration is done.) -->
                                <Border Grid.Column="1"
                                        Background="{StaticResource MochaMantle}"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="10,0,0,0"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="14"
                                               LineHeight="20"
                                               Foreground="{Binding BrushKey, Converter={x:Static views:BrushKeyConverter.Instance}}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════ Empty-state placeholder ════════════
             Shown when there are no chat lines and no tool calls and the
             agent isn't streaming/thinking. The placeholder makes it
             OBVIOUS that the chat is the active view (rather than a blank
             canvas that could be mistaken for a hidden view). -->
        <Border Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="40"
                IsVisible="{Binding Lines.Count, Converter={x:Static views:EqualityConverter.Instance}, ConverterParameter=0}">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="💬" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="Start a conversation" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Type a message below to begin chatting with the AI agent"
                           FontSize="14" Opacity="0.6" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- ════════════ Streaming / thinking indicators ════════════ -->
        <!-- Agent-running banner — visible whenever the agent loop is active,
             with a status message ("Agent is running…" or "Streaming response…"). -->
        <Border Grid.Row="1" Background="{StaticResource MochaSurface0}" CornerRadius="8"
                Padding="14,10" Margin="12,4,12,4"
                BorderBrush="{StaticResource MochaBlue}" BorderThickness="2,0,0,0"
                IsVisible="{Binding IsAgentRunning}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="10" Height="10" Classes="StreamingDot" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource MochaBlue}" FontWeight="SemiBold"
                           FontFamily="{StaticResource CodeFont}" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Text="●●●" Foreground="{StaticResource MochaBlue}" FontSize="10"
                           VerticalAlignment="Center" Opacity="0.7"
                           Classes="BlinkingCursor"/>
            </StackPanel>
        </Border>

        <!-- Streaming buffer with typewriter cursor (killer feature #1). -->
        <Border Grid.Row="1" Background="{StaticResource MochaSurface0}" CornerRadius="8"
                Padding="14,8" Margin="12,4,12,4"
                BorderBrush="{StaticResource MochaPeach}" BorderThickness="2,0,0,0"
                IsVisible="{Binding IsStreaming}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="10" Height="10" Classes="StreamingDot" VerticalAlignment="Center"/>
                <TextBlock Text="streaming" Foreground="{StaticResource MochaPeach}" FontWeight="SemiBold"
                           FontFamily="{StaticResource CodeFont}" FontSize="11"
                           VerticalAlignment="Center"/>
                <ctrl:TypewriterStreamingText
                    Text="{Binding StreamingBuffer}"
                    IsStreaming="{Binding IsStreaming}"
                    VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Thinking indicator -->
        <Border Grid.Row="1" Background="{StaticResource MochaSurface0}" CornerRadius="8"
                Padding="14,8" Margin="12,4,12,4"
                BorderBrush="{StaticResource MochaBlue}" BorderThickness="2,0,0,0"
                IsVisible="{Binding IsThinking}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="🤔" VerticalAlignment="Center" FontSize="14"/>
                <TextBlock Text="thinking…" Foreground="{StaticResource MochaBlue}"
                           FontFamily="{StaticResource CodeFont}" FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ════════════ Input area (ORCA-style) ════════════ -->
        <Border Grid.Row="2" Background="{StaticResource MochaMantle}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Message Harbor…  (Enter to send, Shift+Enter for newline)"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="48" MaxHeight="160"
                         FontSize="14"
                         Padding="12,10"
                         KeyDown="InputBox_KeyDown"/>
                <Button Grid.Column="1" Classes="Primary" Content="Send ▶"
                        Command="{Binding SendCommand}"
                        Margin="8,0,0,0"
                        Padding="20,12"
                        VerticalAlignment="Bottom"/>
                <Button Grid.Column="2" Classes="Secondary" Content="Stop ■"
                        Command="{Binding StopCommand}"
                        Margin="8,0,0,0"
                        Padding="16,12"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding IsThinking}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
