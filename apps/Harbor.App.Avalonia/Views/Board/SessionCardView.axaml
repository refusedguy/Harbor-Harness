<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:Harbor.App.Avalonia.Views.Components"
             xmlns:vm="clr-namespace:Harbor.App.Avalonia.ViewModels.Board"
             x:Class="Harbor.App.Avalonia.Views.Board.SessionCardView"
             Width="260" Height="120"
             x:DataType="vm:SessionCardViewModel">

    <Border Classes="SessionCard" PointerPressed="OnCardPointerPressed">
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="{DynamicResource BgSubtleBrush}"
                        CornerRadius="9"
                        Padding="6,2">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <comp:StatusDot State="{Binding DotState}"
                                        Width="8" Height="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontMono}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Classes="hds-ghost"
                        Padding="4"
                        HorizontalAlignment="Right"
                        PointerPressed="OnKebabPointerPressed">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Rename" Command="{Binding RenameCommand}" />
                            <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                            <MenuItem Header="Archive" Command="{Binding ArchiveCommand}" />
                            <Separator />
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <TextBlock Text="⋯" FontSize="16" />
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis"
                       FontWeight="SemiBold"
                       FontSize="13"
                       MaxLines="1" />

            <TextBlock Text="{Binding PreviewText}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       MaxLines="1" />

            <TextBlock Text="{Binding RelativeTime}"
                       FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>
