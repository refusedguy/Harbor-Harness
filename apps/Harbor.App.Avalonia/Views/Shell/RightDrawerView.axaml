<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Harbor.App.Avalonia.Views"
             x:Class="Harbor.App.Avalonia.Views.Shell.RightDrawerView"
             Width="360">

    <Border Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,1,0"
            BoxShadow="-4 0 12 0 #20000000">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Drawer header -->
            <Border Grid.Row="0"
                    Height="44"
                    Padding="12,0"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding RightDrawerTab}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Classes="Subtle"
                            Content="✕"
                            Padding="8,4"
                            Click="Close_Click"
                            Grid.Column="1"
                            ToolTip.Tip="Close panel" />
                </Grid>
            </Border>

            <!-- Drawer content -->
            <ContentControl Grid.Row="1"
                    Padding="12"
                    Content="{Binding DrawerContent}">
            </ContentControl>

            <!-- Drawer footer (optional) -->
            <Border Grid.Row="2"
                    Height="32"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <TextBlock Text="Ready"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
