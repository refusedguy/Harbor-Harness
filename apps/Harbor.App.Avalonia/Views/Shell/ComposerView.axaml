<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Harbor.App.Avalonia.Views.Shell.ComposerView">

    <!--
        Orca composer — input box + Send / Stop button + helper line.

        Binds directly to the ChatViewModel (the OrcaShellView sets
        DataContext to its Chat property). The running-status banner above
        the input shows when ChatViewModel.IsAgentRunning is true.

        Enter (handled in code-behind) sends; Shift+Enter inserts a newline.
        The Send button is visible when not running; the Stop button takes
        its place while the agent is mid-turn.
    -->

    <Border Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
        <Grid RowDefinitions="Auto,Auto,Auto">

            <!-- Running status banner -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        IsVisible="{Binding IsAgentRunning}"
                        Margin="0,0,0,6">
                <Ellipse Width="6" Height="6"
                         Fill="{DynamicResource StateRunningBrush}"
                         VerticalAlignment="Center">
                    <Ellipse.Styles>
                        <Style Selector="Ellipse">
                            <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="INFINITE">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="1"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="50%">
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="1"/>
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Ellipse.Styles>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Input row -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Message Harbor…"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="36" MaxHeight="120"
                         Background="{DynamicResource BgInputBrush}"
                         BorderBrush="{DynamicResource BorderDefaultBrush}"
                         BorderThickness="1"
                         CornerRadius="6"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Padding="10,8"
                         KeyDown="InputBox_KeyDown"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Bottom"
                            Margin="8,0,0,0">
                    <Button Content="Send" Classes="Primary"
                            Command="{Binding SendCommand}"
                            IsVisible="{Binding !IsAgentRunning}"
                            Padding="16,8"
                            CornerRadius="6"/>
                    <Button Content="Stop" Classes="Danger"
                            Command="{Binding StopCommand}"
                            IsVisible="{Binding IsAgentRunning}"
                            Padding="16,8"
                            CornerRadius="6"/>
                </StackPanel>
            </Grid>

            <!-- Helper line -->
            <TextBlock Grid.Row="2"
                       Text="Enter send · Shift+Enter newline"
                       FontSize="10"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Margin="0,4,0,0"/>
        </Grid>
    </Border>
</UserControl>
