<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Harbor.Ui.Framework.ViewModels;assembly=Harbor.Ui.Framework.ViewModels"
             xmlns:local="clr-namespace:Harbor.App.Avalonia.ViewModels"
             xmlns:vw="clr-namespace:Harbor.App.Avalonia.Views"
             xmlns:comp="clr-namespace:Harbor.App.Avalonia.Views.Components"
             x:Class="Harbor.App.Avalonia.Views.Shell.SessionsFlyoutView"
             Width="280"
             MinWidth="280"
             x:DataType="local:SessionListViewModel">

    <Border Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,1,0"
            CornerRadius="{DynamicResource RadiusMd}"
            Padding="12">

        <StackPanel Spacing="8">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="SESSIONS" Classes="Caption" Foreground="{DynamicResource TextTertiaryBrush}"/>
                <Button Name="SessionsFlyout_NewSessionButton" Classes="hds-ghost" ToolTip.Tip="New session" Click="NewSession_Click"
                        AutomationProperties.AutomationId="SessionsFlyout_NewSessionButton">
                    <PathIcon Data="{StaticResource IcAdd}" Width="14" Height="14"/>
                </Button>
            </StackPanel>

            <!-- Search -->
            <TextBox Name="SessionsFlyout_SearchBox" Classes="hds-flush" PlaceholderText="Search sessions..."
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="SessionsFlyout_SearchBox"/>

            <!-- Session list -->
            <ListBox Name="SessionsFlyout_List" ItemsSource="{Binding Sessions}"
                     SelectedItem="{Binding ActiveSession, Mode=TwoWay}"
                     Background="Transparent"
                     AutomationProperties.AutomationId="SessionsFlyout_List">
                <!-- #2681 G27: the chat timeline is virtualized but the session
                     list was not, so every row was realized on first paint. A
                     project with hundreds of sessions paid that cost on every
                     flyout open. Set the panel explicitly so this row count is
                     bounded no matter which theme styles are loaded. -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <!-- FIX: items are SessionItemViewModel (SessionListViewModel.Sessions),
                         NOT SessionRowViewModel — the stale DataType made compiled
                         bindings fail the runtime cast and render blank titles. -->
                    <DataTemplate DataType="vm:SessionItemViewModel" x:DataType="vm:SessionItemViewModel">
                        <!-- #2681 G24: reuse the presentational row instead of an
                             inline title/meta template. SessionItemViewModel already
                             carries status, git dirt, relative time and message count,
                             so the flyout now shows the same state as the board card. -->
                        <comp:SessionRow Title="{Binding Title}"
                                         Subtitle="{Binding MetaLine}"
                                         RelativeTime="{Binding RelativeTime}"
                                         MessageCount="{Binding MessageCount}"
                                         IsDirty="{Binding GitIsDirty}"
                                         StatusColorKey="{Binding Status, Converter={x:Static vw:SessionStatusToBrushKeyConverter.Instance}}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>