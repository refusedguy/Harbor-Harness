<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Harbor.App.Avalonia.Views"
             x:Class="Harbor.App.Avalonia.Views.Shell.SessionRowView">

    <UserControl.Resources>
    </UserControl.Resources>

    <!--
        Orca dense session row — 2-3 line layout:

          Line 1: ● status dot | title (medium weight)        | relative time   | ×
          Line 2:               | meta line (model · mode) — JetBrains Mono
          Line 3:               | status line (error / running) — only when HasStatusLine

        Right-click opens a ContextMenu (Delete / Rename). Double-click also
        triggers Rename. A hover-visible × button on the right edge triggers
        Delete with a confirmation dialog.
    -->

    <Border x:Name="RowBorder"
            Padding="8,6"
            CornerRadius="4"
            Background="{Binding RowBackgroundKey, Converter={x:Static conv:BrushKeyConverter.Instance}}"
            BorderBrush="{Binding RowBorderKey, Converter={x:Static conv:BrushKeyConverter.Instance}}"
            BorderThickness="2,0,0,0"
            PointerPressed="RowBorder_OnPointerPressed"
            PointerEntered="RowBorder_OnPointerEntered"
            PointerExited="RowBorder_OnPointerExited">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="_Delete"
                          Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="_Rename"
                          Command="{Binding DataContext.RenameSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding}" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">

            <!-- Status dot -->
            <Ellipse Grid.Row="0" Grid.Column="0"
                     Width="6" Height="6"
                     Fill="{Binding StatusBrushKey, Converter={x:Static conv:BrushKeyConverter.Instance}}"
                     VerticalAlignment="Top"
                     Margin="0,4,4,0" />

            <!-- Title -->
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding Title}"
                       FontWeight="Medium" FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />

            <!-- Time -->
            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="{Binding RelativeTime}" FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Top" />

            <!-- Delete button (hover-visible) -->
            <Button x:Name="DeleteButton"
                    Grid.Row="0" Grid.Column="3"
                    Classes="Ghost"
                    Content="×"
                    FontSize="14"
                    Width="18" Height="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    ToolTip.Tip="Delete session"
                    Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Opacity="0"
                    IsCancel="False" />

            <!-- Meta line: model · mode -->
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{Binding MetaLine}" FontSize="11"
                       FontFamily="{DynamicResource FontMono}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,2,0,0" />

            <!-- Status line (only when present) -->
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{Binding StatusLine}" FontSize="11"
                       Foreground="{DynamicResource TextDangerBrush}"
                       IsVisible="{Binding HasStatusLine}"
                       Margin="0,2,0,0" />
        </Grid>
    </Border>
</UserControl>
