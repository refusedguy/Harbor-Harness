<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Harbor.App.Avalonia.ViewModels"
             xmlns:ctrl="clr-namespace:Harbor.App.Avalonia.Views.Controls"
             xmlns:comp="clr-namespace:Harbor.App.Avalonia.Views.Components"
             xmlns:views="clr-namespace:Harbor.App.Avalonia.Views"
             x:Class="Harbor.App.Avalonia.Views.SettingsView">

    <!--
        Section bodies. Each key is named by SettingsSections so the search
        can filter the accordion's Sections without losing a live control: the
        body stays parented to its row and every AutomationProperties.Name on
        an input is exactly where it was before the accordion conversion.
    -->
    <UserControl.Resources>
        <!-- Theme -->
        <StackPanel x:Key="ThemeBody" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox SelectedItem="{Binding ThemeSettings.Theme, Mode=TwoWay}" MinWidth="180"
                          AutomationProperties.Name="Theme">
                    <ComboBoxItem Content="dark" />
                    <ComboBoxItem Content="light" />
                    <ComboBoxItem Content="system" />
                </ComboBox>
                <Button Classes="Subtle" Content="Preview"
                        Command="{Binding ThemeSettings.ApplyThemeCommand}"
                        ToolTip.Tip="Apply the theme immediately without saving." />
            </StackPanel>

            <!--
                Palette picker (#583). The ItemsSource is the catalog's own
                projection, so this list cannot fall out of step with Themes/Hds/.
            -->
            <StackPanel Spacing="6" Margin="0,8,0,0">
                <TextBlock Text="Palette" Classes="Label" />
                <ItemsControl ItemsSource="{Binding ThemeSettings.AvailableThemes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Height="64" Margin="0,0,8,8"
                                    CornerRadius="6" ClipToBounds="True"
                                    Background="{Binding Surface}"
                                    BorderBrush="{Binding Accent}" BorderThickness="1"
                                    ToolTip.Tip="{Binding DisplayName}"
                                    PointerPressed="OnThemePreviewClick">
                                <StackPanel VerticalAlignment="Bottom" Margin="8,0,8,6" Spacing="4">
                                    <Rectangle Height="4" Width="28" HorizontalAlignment="Left"
                                               Fill="{Binding Accent}" />
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{Binding Text}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- Default provider -->
        <StackPanel x:Key="DefaultProviderBody" Spacing="4">
            <!-- #2681 G17: pick from the same provider catalogue the
                 wizard uses instead of free-form text. The VM's
                 SelectedProviderId seam keeps an unset/custom id
                 from being erased by an unmatched ComboBox. -->
            <ComboBox ItemsSource="{Binding AvailableProviderIds}"
                      SelectedItem="{Binding SelectedProviderId, Mode=TwoWay}"
                      AutomationProperties.Name="Default provider"
                      HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Default model -->
        <StackPanel x:Key="DefaultModelBody" Spacing="4">
            <TextBox Text="{Binding DefaultModel, Mode=TwoWay}"
                     AutomationProperties.Name="Default model"
                     PlaceholderText="tencent/hy3:free, gpt-4o, claude-sonnet-4, …" />
        </StackPanel>

        <!-- Font family -->
        <StackPanel x:Key="FontFamilyBody" Spacing="4">
            <TextBox Text="{Binding FontFamily, Mode=TwoWay}" PlaceholderText="Inter"
                     AutomationProperties.Name="Font family" />
        </StackPanel>

        <!-- Storage backend -->
        <StackPanel x:Key="StorageBackendBody" Spacing="4">
            <!-- #677: an empty selection is a real state, not a bug — it
                 means "not chosen", and the composition preset decides
                 (CLI jsonl, desktop memory). -->
            <!-- #2681 G18: only backends the desktop build can actually
                 resolve may be offered here. The sqlite factory in
                 SessionStoreRegistry sits behind HARBOR_WITH_ALL_PROVIDERS,
                 which the Avalonia csproj does not define. -->
            <ComboBox SelectedItem="{Binding StorageBackend, Mode=TwoWay}" MinWidth="180"
                      AutomationProperties.Name="Storage backend">
                <ComboBoxItem Content="memory" />
                <ComboBoxItem Content="jsonl" />
            </ComboBox>
            <TextBlock Text="Leave empty to use the app's default backend."
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <!-- Log level -->
        <StackPanel x:Key="LogLevelBody" Spacing="4">
            <ComboBox SelectedItem="{Binding LogLevel, Mode=TwoWay}" MinWidth="180"
                      AutomationProperties.Name="Log level">
                <ComboBoxItem Content="trace" />
                <ComboBoxItem Content="debug" />
                <ComboBoxItem Content="info" />
                <ComboBoxItem Content="warning" />
                <ComboBoxItem Content="error" />
            </ComboBox>
        </StackPanel>

        <!-- Ollama host. Read-only on purpose (#677): ProviderFactories
             snapshots OLLAMA_HOST into an HttpClient while AddHarbor
             composes, so this screen cannot change a running app. -->
        <StackPanel x:Key="OllamaHostBody" Spacing="4">
            <TextBox Text="{Binding OllamaHost, Mode=OneWay}" IsReadOnly="True"
                     AutomationProperties.Name="Ollama host"
                     PlaceholderText="http://localhost:11434"
                     ToolTip.Tip="Read from OLLAMA_HOST when Harbor starts. Set the environment variable before launching to change it." />
        </StackPanel>

        <!-- Onboarding -->
        <StackPanel x:Key="OnboardingBody" Spacing="4">
            <Button Classes="Subtle" Content="Re-run setup wizard"
                    Command="{Binding RerunOnboardingCommand}"
                    ToolTip.Tip="Resets OnboardingCompleted=false. Restart Harbor to launch the wizard." />
        </StackPanel>

        <!-- Provider Configuration (per-provider API keys + model browser) -->
        <StackPanel x:Key="ProviderConfigurationBody" Spacing="6">
            <TextBlock Text="Set an API key per provider, then click Test to verify the connection."
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding ProviderConfigs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ProviderConfigViewModel">
                        <Border Background="{StaticResource MochaMantle}" CornerRadius="6"
                                Padding="10" Margin="0,3">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <!-- Provider name + auth badge -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                            Spacing="8">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Id}" FontSize="10"
                                               FontFamily="{StaticResource FontMono}"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <Border Grid.Row="0" Grid.Column="1"
                                        Background="{StaticResource MochaSurface0}"
                                        CornerRadius="4" Padding="6,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding AuthIcon}" FontSize="12"
                                                   Foreground="{StaticResource MochaGreen}" />
                                        <TextBlock Text="{Binding AuthText}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- API key input (hidden for no-key providers like Ollama) -->
                                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                         Margin="0,6,0,0"
                                         IsVisible="{Binding RequiresApiKey}"
                                         AutomationProperties.Name="Provider API key"
                                         Text="{Binding ApiKey, Mode=TwoWay}"
                                         PasswordChar="•"
                                         PlaceholderText="Paste API key…" />

                                <!-- Action row -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Button Classes="Subtle" Content="Save key" Padding="10,4"
                                            Command="{Binding SaveKeyCommand}" />
                                    <Button Classes="Subtle" Content="Test connection" Padding="10,4"
                                            Command="{Binding TestConnectionCommand}"
                                            IsEnabled="{Binding !IsTesting}" />
                                    <TextBlock Text="{Binding TestResult}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Model browser -->
        <StackPanel x:Key="BrowseModelsBody" Spacing="4">
            <TextBlock Text="Pick a model to make it the active session's model."
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />
            <ctrl:ProviderModelPicker DataContext="{Binding Picker}" Height="380" />
        </StackPanel>

        <!--
            K29: filter settings by section title. The query is view state only
            (never persisted); the code-behind filters SettingsSections.All with
            the same alias strings the view-model uses to compute
            HasSearchResults, so the two cannot disagree.
        -->
    </UserControl.Resources>

    <!--
        Settings modal — overlay with a centered card.

        Layout:
          • Backdrop: 50% black scrim that captures clicks (so a click
            outside the card reads as "dismiss").
          • Card: 760×640, padded, rounded, surface-tinted background.
          • Search row: TextBox + Clear button; filters the accordion sections.
          • Sections: an HDS Accordion over the data in SettingsSections; each
            row is an Expander that owns one of the bodies above. All rows open
            by default, so the screen shows the same controls it always did;
            automation names and the no-results state are unchanged.
          • Footer: Cancel (revert + close) + Save (persist + close).
    -->

    <!--
        Backdrop: 50% black scrim that captures clicks via Backdrop_Click so a
        click outside the card reads as "dismiss" (Bug fix: popups not closing
        on outside click). The inner Border has Background set so its clicks
        don't bubble to the backdrop (PointerPressed is a tunneling/bubbling
        routed event — the inner Border eats it before it reaches the outer).
    -->
    <Border Background="#80000000" ZIndex="200"
            PointerPressed="Backdrop_Click">
        <Border Background="{StaticResource MochaBase}" CornerRadius="12"
                Width="760" Height="640" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 16 40 0 #80000000">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Settings" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource MochaBlue}" />
                        <TextBlock Text="Persists to ~/.harbor/config.json + ~/.harbor/avalonia.json"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="Subtle" Content="✕" Padding="10,4"
                            AutomationProperties.Name="Close settings"
                            Click="Close_Click" ToolTip.Tip="Close (Esc)" />
                </Grid>

                <!-- Search row -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="Search settings…"
                             AutomationProperties.Name="Search settings"
                             ToolTip.Tip="Filter settings by section name, e.g. theme, model, API key." />
                    <Button Grid.Column="1" Classes="Subtle" Content="Clear"
                            Margin="8,0,0,0" Padding="10,4"
                            IsVisible="{Binding IsFiltering}"
                            Command="{Binding ClearSearchCommand}"
                            AutomationProperties.Name="Clear settings search" />
                </Grid>

                <Grid Grid.Row="2">
                    <!-- Scrollable settings: one accordion row per matching section -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasSearchResults}">
                        <comp:Accordion x:Name="SettingsSectionsAccordion"
                                        AutomationProperties.Name="Settings sections"
                                        Mode="Multiple" />
                    </ScrollViewer>

                    <!--
                        K29: an explicit empty state. Without it a query that
                        matches nothing leaves a blank scroll area, which reads as
                        "the settings disappeared" rather than "no match".
                    -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="8" Margin="24"
                                AutomationProperties.Name="Settings empty state"
                                IsVisible="{Binding !HasSearchResults}">
                        <TextBlock Text="No settings match this search"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource MochaBlue}"
                                   TextAlignment="Center" />
                        <TextBlock Text="Try a section name such as theme, model, storage or API key."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                            Spacing="8" Margin="0,12,0,0">
                    <Button Classes="Subtle" Content="Cancel" Click="Cancel_Click" />
                    <Button Classes="Primary" Content="Save" Command="{Binding SaveCommand}" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
