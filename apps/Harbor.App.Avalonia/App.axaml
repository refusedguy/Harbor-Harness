<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Harbor.App.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Harbor.App.Avalonia/Themes/Dark.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://Harbor.App.Avalonia/Themes/Typography.axaml"/>
        <StyleInclude Source="avares://Harbor.App.Avalonia/Themes/AppStyles.axaml"/>
    </Application.Styles>

</Application>
