<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harbor.App.Maui: .NET MAUI desktop app skeleton.

    Targets Windows + macOS Catalyst. Linux sandbox builds will fail without
    the `maui-windows` / `maui-maccatalyst` workloads installed
    (`dotnet workload install maui-windows maui-maccatalyst`). Build this
    project on Windows or macOS. On Linux, exclude it from the solution build
    by passing the project list explicitly, e.g.
    `dotnet build path/to/Harbor.Core.csproj` etc.
  -->

  <PropertyGroup>
    <!--
      Use TargetFramework (singular) on Linux/Windows so `dotnet build
      Harbor.slnx` knows which TFM to build — cross-targeted projects that
      only declare net10.0-windows confuse the solution driver and emit
      NETSDK1005 ("doesn't have a target for 'net10.0'"). On macOS, switch
      to TargetFrameworks (plural) to also produce a maccatalyst bundle.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0-windows;net10.0-maccatalyst</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Harbor.App.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      The repo uses Central Package Management (CPM). Under CPM, the MAUI
      SDK cannot add implicit <PackageReference Version="..." /> entries
      (NU1008), so we list them explicitly below — versions come from
      Directory.Packages.props. SkipValidateMauiImplicitPackageReferences
      silences the MA002 warning that asks us to set Version on the
      PackageReference (CPM does that for us).
    -->
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <!-- Display name + app id for the packaged app. -->
    <ApplicationTitle>Harbor</ApplicationTitle>
    <ApplicationId>com.harbor.app</ApplicationId>
    <ApplicationIdGuid>9c1b2a3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d</ApplicationIdGuid>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbor.Abstractions\Harbor.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Core\Harbor.Core.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Desktop.Abstractions\Harbor.Desktop.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Storage.Memory\Harbor.Storage.Memory.csproj"/>
    <ProjectReference Include="..\..\src\Harbor.Terminal.Abstractions\Harbor.Terminal.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      MAUI workload packages (versions pinned in Directory.Packages.props).
      Under CPM, the MAUI SDK cannot inject these implicitly — they must be
      declared here so the Microsoft.Maui.* namespaces resolve.
    -->
    <PackageReference Include="Microsoft.Maui.Controls"/>
    <PackageReference Include="Microsoft.Maui.Controls.Xaml"/>
    <PackageReference Include="Microsoft.Maui.Essentials"/>
    <PackageReference Include="Microsoft.Maui.Core"/>
    <PackageReference Include="Microsoft.Maui.Resizetizer" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.Maui.Controls.Build.Tasks" PrivateAssets="all"/>

    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="Markdig"/>
  </ItemGroup>

</Project>
