<?xml version="1.0" encoding="UTF-8" ?>

<!-- Harbor.App.Maui — application resource dictionary. -->
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Harbor.App.Maui"
             x:Class="Harbor.App.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Catppuccin Mocha accent — matches the dark theme used by Harbor.App.Avalonia/Wpf. -->
            <Color x:Key="MochaBase">#1E1E2E</Color>
            <Color x:Key="MochaText">#CDD6F4</Color>
            <Color x:Key="MochaBlue">#89B4FA</Color>
            <Color x:Key="MochaGreen">#A6E3A1</Color>
            <Color x:Key="MochaRed">#F38BA8</Color>
            <Color x:Key="MochaYellow">#F9E2AF</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource MochaText}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource MochaBlue}" />
                <Setter Property="TextColor" Value="{StaticResource MochaBase}" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
