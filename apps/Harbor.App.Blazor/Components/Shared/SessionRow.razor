@* SessionRow - sidebar row for a session.

    Platform-agnostic Blazor equivalent of the Avalonia
    Harbor.App.Avalonia.Views.Components.SessionRow control. Same
    props (Title / Subtitle / RelativeTime / MessageCount /
    StatusColorKey / IsDirty / IsActive), same look, same resource-key
    pattern.
*@

<div class="session-row @(IsActive ? "active" : "")">
    <div class="session-row-main">
        <div class="session-row-title">
            <span class="session-title">@Title</span>
            @if (IsDirty)
            {
                <span class="session-dirty" title="Working tree has uncommitted changes">*</span>
            }
        </div>
        <div class="session-subtitle">@Subtitle</div>
        <div class="session-meta">
            <span class="session-time">@RelativeTime</span>
            <span class="session-count">@MessageCount msgs</span>
        </div>
    </div>
    <span class="session-status-dot @($"brush-{StatusColorKey.ToLowerInvariant()}")"></span>
</div>

@code {
    /// <summary>Session title.</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Subtitle — usually agent + model.</summary>
    [Parameter]
    public string Subtitle { get; set; } = string.Empty;

    /// <summary>Pre-formatted relative time ("5m ago").</summary>
    [Parameter]
    public string RelativeTime { get; set; } = string.Empty;

    /// <summary>Live message count for this session.</summary>
    [Parameter]
    public int MessageCount { get; set; }

    /// <summary>Resource key for the status dot color.</summary>
    [Parameter]
    public string StatusColorKey { get; set; } = "MochaOverlay0";

    /// <summary>True when git working tree has uncommitted changes.</summary>
    [Parameter]
    public bool IsDirty { get; set; }

    /// <summary>True when this row is the currently-active session.</summary>
    [Parameter]
    public bool IsActive { get; set; }
}
