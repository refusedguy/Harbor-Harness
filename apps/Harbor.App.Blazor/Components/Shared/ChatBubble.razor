@using Harbor.Ui.Framework.ViewModels
@using ChatVm = Harbor.Ui.Framework.ViewModels.ChatLineViewModel
@* ChatBubble - renders a single chat line with role-coloured left border.
   Driven entirely by ChatLine properties (Role, Text) and uses the
   platform-agnostic ChatLineViewModel helpers (RoleLabel, RoleBrushKey)
   for the role pill, so the same look is shared across Blazor, Avalonia,
   WPF, MAUI. *@

@{
// Project the ChatLine through ChatLineViewModel to reuse the
// RoleLabel / RoleBrushKey derivation. This keeps the projection
// logic in one place (the record) instead of duplicating the switch
// expressions in every platform's chat template.
var vm = new ChatVm(Line.Role, Line.Text);
}

<div class="message-bubble role-@vm.RoleLabel">
    <div class="bubble-header">
        <span class="bubble-role role-text-@vm.RoleLabel">@vm.RoleLabel</span>
    </div>
    <div class="bubble-content">
        @vm.Text
    </div>
</div>

@code {
/// <summary>The chat line to render.</summary>
[Parameter]
public ChatLine Line { get; set; }
}
