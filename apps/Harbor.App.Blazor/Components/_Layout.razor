@* Main layout — the three-pane desktop shell:
   ┌─────────────┬──────────────────────────────────┐
   │             │  TopBar (session / model / cost) │
   │  Sidebar    ├──────────────────────────────────┤
   │  (nav)      │                                  │
   │             │  @Body (current page)            │
   │             │                                  │
   │             ├──────────────────────────────────┤
   │             │  StatusBar (state / tokens)      │
   └─────────────┴──────────────────────────────────┘
   The CommandPalette overlays the whole shell when Ctrl+P is pressed. @*@
@inherits LayoutComponentBase
@inject UiStore Store
@inject BlazorDispatcherAdapter Dispatcher
@inject CommandPaletteService Palette
@inject ToastService Toasts
@implements IDisposable

<div class="layout-shell" @onkeydown="OnKeyDownAsync">
    <Sidebar/>
    <div class="layout-main">
        <TopBar/>
        <main class="layout-body">
            @Body
        </main>
        <StatusBar/>
    </div>
    <ToastContainer/>
    <CommandPalette/>
</div>

@code {
protected override void OnInitialized()
{
    Store.Changed += OnStoreChanged;
    // Bind the adapter to the layout's render context so background
    // threads (VMs, services) can call InvokeAsync(StateHasChanged)
    // through it. InvokeAsync here is ComponentBase.InvokeAsync which
    // marshals to the render thread.
    Dispatcher.Bind(action => InvokeAsync(action));
}

private async void OnStoreChanged(object? _, UiStateChangedEventArgs __)
{
    // Re-render on the render thread (InvokeAsync marshals to the
    // render thread; no-op when already on it).
    await InvokeAsync(StateHasChanged).ConfigureAwait(false);
}

///     Global keydown handler — opens the command palette on Ctrl+P,
///     closes it on Escape when open. Other keys fall through to
///     the focused control.
/// <summary>
    ///     Global keydown handler — opens the command palette on Ctrl+P,
    ///     closes it on Escape when open. Other keys fall through to
    ///     the focused control.
    /// </summary>
private async Task OnKeyDownAsync(KeyboardEventArgs e)
{
    if (e is { Key: "p", CtrlKey: true })
    {
        await Palette.ToggleAsync().ConfigureAwait(false);
    }
    else if (e is { Key: "Escape" } && Palette.IsOpen)
    {
        await Palette.CloseAsync().ConfigureAwait(false);
    }
}

public void Dispose()
{
    Store.Changed -= OnStoreChanged;
}
}
