@page "/settings"
@inject SettingsViewModel Vm

<h1>Settings</h1>

<div class="settings-section">
    <h3>Theme</h3>
    <div class="settings-row">
        <label>Catppuccin palette</label>
        <select class="select-input" value="@Vm.SelectedTheme" @onchange="OnThemeChangedAsync">
            <option value="Mocha">Mocha (dark, default)</option>
            <option value="Macchiato">Macchiato (medium dark)</option>
            <option value="Latte">Latte (light)</option>
        </select>
    </div>
</div>

<div class="settings-section">
    <h3>Sessions Directory</h3>
    <div class="settings-row">
        <label>Path</label>
        <input class="text-input" @bind="Vm.SessionsDirectory" placeholder="~/.harbor/sessions"/>
    </div>
    <div class="settings-row" style="grid-template-columns:200px auto;">
        <span></span>
        <button class="btn-primary" @onclick="ApplyDirectoryAsync">Apply</button>
    </div>
</div>

<div class="settings-section">
    <h3>About</h3>
    <p>Harbor 0.4.0-alpha · Blazor Server shell · .NET 10.</p>
    <p>Source: <a href="https://github.com/harbor-sh/harbor">github.com/harbor-sh/harbor</a></p>
</div>

@code {
private async Task OnThemeChangedAsync(ChangeEventArgs e)
{
    if (Enum.TryParse<HarborTheme>(e.Value?.ToString(), out var theme))
    {
        Vm.SelectedTheme = theme;
    }
}

private Task ApplyDirectoryAsync() => Vm.ApplyDirectoryAsync();
}
