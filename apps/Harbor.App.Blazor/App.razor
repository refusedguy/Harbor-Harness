@using Harbor.App.Blazor.Components
@using Microsoft.AspNetCore.Components.Web
@* Root Razor component — the full HTML document. Routes the path to a Page
   inside the default _Layout. Loaded scripts: Blazor SignalR, Monaco loader,
   and the Harbor JS interop shim. Theme is set on the <html> element so CSS
   variables can switch themes via the ThemeService. @*@

<!DOCTYPE html>
<html lang="en" data-theme="mocha">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Harbor — AI Coding Agent</title>
    <link rel="stylesheet" href="css/site.css"/>
    <link rel="stylesheet" href="css/animations.css"/>
    <HeadOutlet/>
</head>
<body class="harbor-shell">
<Routes/>
<script src="_framework/blazor.web.js" autostart="true"></script>
<script src="js/monaco-loader.js" defer></script>
<script src="js/interop.js" defer></script>
</body>
</html>
