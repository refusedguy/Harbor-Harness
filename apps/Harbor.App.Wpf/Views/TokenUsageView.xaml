<UserControl x:Class="Harbor.App.Wpf.Views.TokenUsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Harbor.App.Wpf.ViewModels"
             Background="{DynamicResource App.Background}">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="{DynamicResource App.Surface}"
                Padding="10,8" Margin="0,0,0,10" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Input tokens" Foreground="{DynamicResource App.TextMuted}" FontSize="11"/>
                    <TextBlock Text="{Binding TotalInputTokensDisplay}"
                               Foreground="{DynamicResource App.Info}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Output tokens" Foreground="{DynamicResource App.TextMuted}" FontSize="11"/>
                    <TextBlock Text="{Binding TotalOutputTokensDisplay}"
                               Foreground="{DynamicResource App.Success}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Estimated cost" Foreground="{DynamicResource App.TextMuted}" FontSize="11"/>
                    <TextBlock Text="{Binding TotalCostDisplay}"
                               Foreground="{DynamicResource App.Warning}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button DockPanel.Dock="Bottom" Content="Reset" Padding="10,4"
                HorizontalAlignment="Right" Margin="0,10,0,0"
                Command="{Binding ResetCommand}"/>

        <!-- Custom bar chart (no LiveCharts2 dependency) -->
        <Border Background="{DynamicResource App.Surface}" CornerRadius="6" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Token usage per turn"
                           Foreground="{DynamicResource App.TextMuted}" FontSize="11" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Bars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TokenBarViewModel}">
                            <StackPanel Width="48" Margin="2,0">
                                <Grid Height="180" VerticalAlignment="Bottom">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="1" Background="{Binding InputBrush}"
                                            VerticalAlignment="Bottom" Height="{Binding InputHeight}"
                                            CornerRadius="3,3,0,0"/>
                                    <Border Grid.Row="0" Background="{Binding OutputBrush}"
                                            VerticalAlignment="Bottom" Height="{Binding OutputHeight}"
                                            CornerRadius="3,3,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{DynamicResource App.TextMuted}"
                                           FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
