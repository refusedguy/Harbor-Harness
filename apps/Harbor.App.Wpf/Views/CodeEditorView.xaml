<UserControl x:Class="Harbor.App.Wpf.Views.CodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource App.Background}">
    <DockPanel Margin="6">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource App.Surface}"
                Padding="6,4" Margin="0,0,0,6" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource App.Text}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SyntaxLanguage, StringFormat=' · {0}'}"
                               Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Open" Padding="10,4" Margin="0,0,4,0"
                            Command="{Binding OpenFileCommand}" />
                    <Button Content="Save" Padding="10,4" Margin="0,0,4,0"
                            Command="{Binding SaveFileCommand}" />
                    <Button Content="Format" Padding="10,4"
                            Command="{Binding FormatCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- AvalonEdit editor -->
        <avalonEdit:TextEditor x:Name="Editor"
                               ShowLineNumbers="True"
                               FontFamily="JetBrains Mono, Cascadia Code, Consolas, monospace"
                               FontSize="13"
                               Background="{DynamicResource App.Surface}"
                               Foreground="{DynamicResource App.Text}"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               WordWrap="False"
                               Padding="4" />
    </DockPanel>
</UserControl>
