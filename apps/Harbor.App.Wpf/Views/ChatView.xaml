<UserControl x:Class="Harbor.App.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Harbor.App.Wpf.ViewModels"
             Background="{DynamicResource App.Background}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />        <!-- Transcript -->
            <RowDefinition Height="Auto" />     <!-- Streaming buffer -->
            <RowDefinition Height="Auto" />     <!-- Input -->
        </Grid.RowDefinitions>

        <!-- Transcript -->
        <ListBox Grid.Row="0"
                 x:Name="Transcript"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{DynamicResource App.Text}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemsSource="{Binding Messages}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding DisplayTime}"
                                   Foreground="{DynamicResource App.TextMuted}"
                                   FontSize="11"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Role}"
                                   Foreground="{Binding RoleForeground}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Top" />
                        <RichTextBox Grid.Column="2"
                                     x:Name="MessageBody"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     Foreground="{DynamicResource App.Text}"
                                     FontSize="13"
                                     Padding="0"
                                     Loaded="MessageBody_Loaded" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Streaming buffer (visible when agent is running) -->
        <Border Grid.Row="1" Background="{DynamicResource App.Surface}" CornerRadius="4"
                Padding="8,3" Margin="0,6,0,0" Visibility="{Binding StreamingVisibility}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource App.Warning}" VerticalAlignment="Center" />
                <TextBlock Text=" streaming" Foreground="{DynamicResource App.Warning}" Margin="6,0,0,0" />
                <TextBlock Text="{Binding StreamingBuffer}" Foreground="{DynamicResource App.TextMuted}"
                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="900" />
            </StackPanel>
        </Border>

        <!-- Input -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     x:Name="InputBox"
                     Background="{DynamicResource App.Surface}"
                     Foreground="{DynamicResource App.Text}"
                     BorderBrush="{DynamicResource App.Border}"
                     BorderThickness="1"
                     Padding="8,6"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="32" MaxHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="InputBox_KeyDown" />
            <Button Grid.Column="1"
                    Content="Send (Ctrl+Enter)"
                    Padding="14,6" Margin="6,0,0,0"
                    Background="{DynamicResource App.Accent}"
                    Foreground="Black"
                    Command="{Binding SendCommand}" />
            <Button Grid.Column="2"
                    Content="Cancel"
                    Padding="12,6" Margin="6,0,0,0"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsStreaming}" />
        </Grid>
    </Grid>
</UserControl>
