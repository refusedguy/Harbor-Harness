<Window x:Class="Harbor.App.Wpf.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Harbor Settings"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource App.Text}" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,8,0,4" />
                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                          Background="{DynamicResource App.Surface}"
                          Foreground="{DynamicResource App.Text}" />

                <TextBlock Text="Default Agent" FontWeight="SemiBold" Margin="0,16,0,4" />
                <TextBox Text="{Binding DefaultAgent, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource App.Surface}"
                         Foreground="{DynamicResource App.Text}" />

                <TextBlock Text="Default Provider" FontWeight="SemiBold" Margin="0,16,0,4" />
                <TextBox Text="{Binding DefaultProvider, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource App.Surface}"
                         Foreground="{DynamicResource App.Text}" />

                <TextBlock Text="Default Model" FontWeight="SemiBold" Margin="0,16,0,4" />
                <TextBox Text="{Binding DefaultModel, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource App.Surface}"
                         Foreground="{DynamicResource App.Text}" />

                <TextBlock Text="UI" FontWeight="SemiBold" Margin="0,16,0,4" />
                <CheckBox Content="Auto-scroll chat"
                          IsChecked="{Binding AutoScrollChat}"
                          Foreground="{DynamicResource App.Text}" />
                <CheckBox Content="Send anonymous telemetry"
                          IsChecked="{Binding SendTelemetry}"
                          Foreground="{DynamicResource App.Text}" Margin="0,4,0,0" />

                <TextBlock Text="Font Size" FontWeight="SemiBold" Margin="0,16,0,4" />
                <Slider Minimum="10" Maximum="20" Value="{Binding FontSize}"
                        TickFrequency="1" IsSnapToTickEnabled="True" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset" Padding="14,6" Margin="0,0,8,0" Command="{Binding ResetCommand}" />
            <Button Content="Apply" Padding="14,6"
                    Background="{DynamicResource App.Accent}" Foreground="Black"
                    Command="{Binding ApplyCommand}" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
