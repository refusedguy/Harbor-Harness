<UserControl x:Class="Harbor.App.Wpf.Views.SessionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Harbor.App.Wpf.ViewModels"
             Background="{DynamicResource App.Surface}">
    <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Top" Text="Sessions"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource App.Text}"
                   Margin="2,0,0,6"/>

        <!-- Search box -->
        <TextBox DockPanel.Dock="Top"
                 Margin="0,0,0,6"
                 Background="{DynamicResource App.Background}"
                 Foreground="{DynamicResource App.Text}"
                 BorderBrush="{DynamicResource App.Border}"
                 BorderThickness="1"
                 Padding="6,4"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Action buttons -->
        <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,6,0,0">
            <Button Content="+ New" Margin="0,0,3,0" Command="{Binding NewSessionCommand}"/>
            <Button Content="⑂ Fork" Margin="3,0" Command="{Binding ForkSelectedCommand}"/>
            <Button Content="✕ Del" Margin="3,0,0,0" Command="{Binding DeleteSelectedCommand}"/>
        </UniformGrid>

        <!-- Sessions list -->
        <ListBox Background="Transparent"
                 BorderThickness="0"
                 Foreground="{DynamicResource App.Text}"
                 SelectedValue="{Binding SelectedSessionId}"
                 SelectedValuePath="Id"
                 ItemsSource="{Binding Sessions}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SessionEntryViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource App.Accent}"
                                CornerRadius="3" Width="20" Height="20">
                            <TextBlock Text="{Binding Badge}" Foreground="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="11"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource App.Text}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AgentName}" Foreground="{DynamicResource App.TextMuted}"
                                       FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}"
                                   Foreground="{DynamicResource App.TextMuted}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
