<UserControl x:Class="Harbor.App.Wpf.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Harbor.App.Wpf.Converters">
    <!--
        StatusBadge — reusable colored dot + label pill.
        Mirrors the Avalonia Harbor.App.Avalonia.Views.Components.StatusBadge.
    -->
    <UserControl.Resources>
        <conv:BrushKeyConverter x:Key="BrushKey"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="9"
            Padding="8,2"
            HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8"
                     Height="8"
                     Margin="0,0,6,0"
                     Fill="{Binding BrushKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BrushKey}}"
                     Visibility="{Binding ShowDot, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="11"
                       FontFamily="Consolas"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
