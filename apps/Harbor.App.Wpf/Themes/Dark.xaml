<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Catppuccin Mocha dark palette — https://catppuccin.com.
      Base / Mantle / Crust as surface levels; the accent colors (mauve, blue,
      green, peach, yellow) are used for syntax + status-bar highlights.
    -->
    <Color x:Key="Mocha.Base">#1E1E2E</Color>
    <Color x:Key="Mocha.Mantle">#181825</Color>
    <Color x:Key="Mocha.Crust">#11111B</Color>
    <Color x:Key="Mocha.Surface0">#313244</Color>
    <Color x:Key="Mocha.Surface1">#45475A</Color>
    <Color x:Key="Mocha.Surface2">#585B70</Color>
    <Color x:Key="Mocha.Overlay0">#6C7086</Color>
    <Color x:Key="Mocha.Overlay1">#7F849C</Color>
    <Color x:Key="Mocha.Overlay2">#9399B2</Color>
    <Color x:Key="Mocha.Text">#CDD6F4</Color>
    <Color x:Key="Mocha.Subtext0">#A6ADC8</Color>
    <Color x:Key="Mocha.Subtext1">#BAC2DE</Color>
    <Color x:Key="Mocha.Blue">#89B4FA</Color>
    <Color x:Key="Mocha.Lavender">#B4BEFE</Color>
    <Color x:Key="Mocha.Sapphire">#74C7EC</Color>
    <Color x:Key="Mocha.Sky">#89DCEB</Color>
    <Color x:Key="Mocha.Teal">#94E2D5</Color>
    <Color x:Key="Mocha.Green">#A6E3A1</Color>
    <Color x:Key="Mocha.Yellow">#F9E2AF</Color>
    <Color x:Key="Mocha.Peach">#FAB387</Color>
    <Color x:Key="Mocha.Maroon">#EBA0AC</Color>
    <Color x:Key="Mocha.Red">#F38BA8</Color>
    <Color x:Key="Mocha.Mauve">#CBA6F7</Color>
    <Color x:Key="Mocha.Pink">#F5C2E7</Color>
    <Color x:Key="Mocha.Flamingo">#F2CDCD</Color>
    <Color x:Key="Mocha.Rosewater">#F5E0DC</Color>

    <SolidColorBrush x:Key="Dark.BaseBrush" Color="{StaticResource Mocha.Base}" />
    <SolidColorBrush x:Key="Dark.MantleBrush" Color="{StaticResource Mocha.Mantle}" />
    <SolidColorBrush x:Key="Dark.CrustBrush" Color="{StaticResource Mocha.Crust}" />
    <SolidColorBrush x:Key="Dark.Surface0Brush" Color="{StaticResource Mocha.Surface0}" />
    <SolidColorBrush x:Key="Dark.Surface1Brush" Color="{StaticResource Mocha.Surface1}" />
    <SolidColorBrush x:Key="Dark.Surface2Brush" Color="{StaticResource Mocha.Surface2}" />
    <SolidColorBrush x:Key="Dark.Overlay0Brush" Color="{StaticResource Mocha.Overlay0}" />
    <SolidColorBrush x:Key="Dark.Overlay1Brush" Color="{StaticResource Mocha.Overlay1}" />
    <SolidColorBrush x:Key="Dark.Overlay2Brush" Color="{StaticResource Mocha.Overlay2}" />
    <SolidColorBrush x:Key="Dark.TextBrush" Color="{StaticResource Mocha.Text}" />
    <SolidColorBrush x:Key="Dark.Subtext0Brush" Color="{StaticResource Mocha.Subtext0}" />
    <SolidColorBrush x:Key="Dark.Subtext1Brush" Color="{StaticResource Mocha.Subtext1}" />
    <SolidColorBrush x:Key="Dark.BlueBrush" Color="{StaticResource Mocha.Blue}" />
    <SolidColorBrush x:Key="Dark.LavenderBrush" Color="{StaticResource Mocha.Lavender}" />
    <SolidColorBrush x:Key="Dark.GreenBrush" Color="{StaticResource Mocha.Green}" />
    <SolidColorBrush x:Key="Dark.YellowBrush" Color="{StaticResource Mocha.Yellow}" />
    <SolidColorBrush x:Key="Dark.PeachBrush" Color="{StaticResource Mocha.Peach}" />
    <SolidColorBrush x:Key="Dark.RedBrush" Color="{StaticResource Mocha.Red}" />
    <SolidColorBrush x:Key="Dark.MauveBrush" Color="{StaticResource Mocha.Mauve}" />

    <!-- Semantic aliases — the active theme binds to these and ThemeService
         swaps the underlying dictionary. -->
    <SolidColorBrush x:Key="App.Background" Color="{StaticResource Mocha.Base}" />
    <SolidColorBrush x:Key="App.Surface" Color="{StaticResource Mocha.Mantle}" />
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="{StaticResource Mocha.Surface0}" />
    <SolidColorBrush x:Key="App.Border" Color="{StaticResource Mocha.Surface1}" />
    <SolidColorBrush x:Key="App.Text" Color="{StaticResource Mocha.Text}" />
    <SolidColorBrush x:Key="App.TextMuted" Color="{StaticResource Mocha.Overlay0}" />
    <SolidColorBrush x:Key="App.Accent" Color="{StaticResource Mocha.Mauve}" />
    <SolidColorBrush x:Key="App.AccentSecondary" Color="{StaticResource Mocha.Blue}" />
    <SolidColorBrush x:Key="App.Success" Color="{StaticResource Mocha.Green}" />
    <SolidColorBrush x:Key="App.Warning" Color="{StaticResource Mocha.Yellow}" />
    <SolidColorBrush x:Key="App.Error" Color="{StaticResource Mocha.Red}" />
    <SolidColorBrush x:Key="App.Info" Color="{StaticResource Mocha.Sky}" />

    <!-- Role brushes for chat roles -->
    <SolidColorBrush x:Key="Role.User" Color="{StaticResource Mocha.Sky}" />
    <SolidColorBrush x:Key="Role.Assistant" Color="{StaticResource Mocha.Text}" />
    <SolidColorBrush x:Key="Role.Thinking" Color="{StaticResource Mocha.Overlay0}" />
    <SolidColorBrush x:Key="Role.Tool" Color="{StaticResource Mocha.Blue}" />
    <SolidColorBrush x:Key="Role.ToolResult" Color="{StaticResource Mocha.Green}" />
    <SolidColorBrush x:Key="Role.Error" Color="{StaticResource Mocha.Red}" />

    <!-- Code syntax highlighting (Mocha) -->
    <SolidColorBrush x:Key="Syntax.Keyword" Color="{StaticResource Mocha.Mauve}" />
    <SolidColorBrush x:Key="Syntax.String" Color="{StaticResource Mocha.Green}" />
    <SolidColorBrush x:Key="Syntax.Number" Color="{StaticResource Mocha.Peach}" />
    <SolidColorBrush x:Key="Syntax.Comment" Color="{StaticResource Mocha.Overlay0}" />
    <SolidColorBrush x:Key="Syntax.Class" Color="{StaticResource Mocha.Yellow}" />
    <SolidColorBrush x:Key="Syntax.Method" Color="{StaticResource Mocha.Blue}" />
    <SolidColorBrush x:Key="Syntax.Background" Color="{StaticResource Mocha.Mantle}" />
    <SolidColorBrush x:Key="Syntax.Foreground" Color="{StaticResource Mocha.Text}" />

</ResourceDictionary>
