<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      WPF Storyboard animations. Used by views for:
        - Page transitions (slide + fade)
        - Toast notifications (slide-in from top-right)
        - Button feedback (press-scale)
        - Streaming indicator pulse
        - Loading spinner rotation
    -->

    <!-- Toast slide-in from top-right -->
    <Storyboard x:Key="App.Anim.ToastSlideIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="320" To="0" Duration="0:0:0.32"
                         EasingFunction="{StaticResource App.Easing.Decelerate}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                         From="0" To="1" Duration="0:0:0.24"/>
    </Storyboard>

    <Storyboard x:Key="App.Anim.ToastSlideOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="0" To="320" Duration="0:0:0.24"
                         EasingFunction="{StaticResource App.Easing.Accelerate}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                         From="1" To="0" Duration="0:0:0.2"/>
    </Storyboard>

    <!-- Page transition (slide left + fade) -->
    <Storyboard x:Key="App.Anim.PageEnter">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="40" To="0" Duration="0:0:0.22"
                         EasingFunction="{StaticResource App.Easing.Decelerate}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                         From="0" To="1" Duration="0:0:0.18"/>
    </Storyboard>

    <!-- Streaming pulse — applies to the dot indicator -->
    <Storyboard x:Key="App.Anim.Pulse" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                         From="0.4" To="1.0" Duration="0:0:0.8"/>
    </Storyboard>

    <!-- Spinner rotation -->
    <Storyboard x:Key="App.Anim.Spin" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         From="0" To="360" Duration="0:0:1.4"/>
    </Storyboard>

    <!-- Easing functions -->
    <CubicEase x:Key="App.Easing.Decelerate" EasingMode="EaseOut"/>
    <CubicEase x:Key="App.Easing.Accelerate" EasingMode="EaseIn"/>
    <CubicEase x:Key="App.Easing.Standard" EasingMode="EaseInOut"/>

</ResourceDictionary>
