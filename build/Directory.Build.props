<?xml version="1.0" encoding="utf-8"?>
<!--
  build/Directory.Build.props — overrides for the build orchestrator projects.

  This file is picked up ONLY by the project under build/:
  _build.fallout/_build.fallout.csproj, the single build orchestrator after
  the step-4 removal of the legacy path (#2183). It overrides the
  solution-wide Directory.Build.props to give the orchestrator a permissive
  build environment:

    - TreatWarningsAsErrors=false   (generated code triggers CS0649 / CS0169)
    - GenerateDocumentationFile=false (bootstrap tool, not shipped)
    - ManagePackageVersionsCentrally=false  (the orchestrator pins its own dep
      chain; letting CPM try to pin transitively causes NU1701+NU1603 noise)
    - All analyzers OFF             (generated Build.cs scaffold we don't lint)

  We do NOT import the parent Directory.Build.props — the build project is a
  tool, not part of the solution proper, and inheriting solution-wide
  strictness would force analyzers / TreatWarningsAsErrors onto code we
  don't own.
-->
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The orchestrator is a tool, not a shipped assembly. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS1591;CA1416</NoWarn>

    <!-- Don't let CPM reject the orchestrator's transitive deps. The copy of
         this property in _build.fallout.csproj is the one that decides (the
         SDK imports Directory.Build.props first and Directory.Packages.props
         second, so the root file turns CPM back on after this file set it
         off) — keep all copies in step when any of them changes. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>

    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzers>false</RunAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>

  <!-- Explicitly opt out of every analyzer pulled in by the solution-wide
       Directory.Build.props. The build/ project lives OUTSIDE src|tests|apps
       and shouldn't inherit solution-wide analyzer PackageReferences. -->
  <ItemGroup>
    <PackageReference Remove="Roslynator.Analyzers"/>
    <PackageReference Remove="SonarAnalyzer.CSharp"/>
    <PackageReference Remove="Microsoft.CodeAnalysis.NetAnalyzers"/>
    <PackageReference Remove="AsyncFixer"/>
    <PackageReference Remove="ReflectionAnalyzers"/>
    <PackageReference Remove="Microsoft.CodeAnalysis.BannedApiAnalyzers"/>
    <PackageReference Remove="Meziantou.Analyzer"/>
    <PackageReference Remove="DotNetProjectFile.Analyzers"/>
  </ItemGroup>

</Project>
