<Project Sdk="Microsoft.NET.Sdk">

  <!--
    _build.fallout.csproj — the single build entry point.

    This is the Fallout orchestrator. It started as the step-0 pilot (issue
    #2179), was made primary in #2180 step 1, and became the only build path
    when the retired second orchestrator was removed in #2183 step 4. The
    port was produced by `fallout-migrate` in dry-run mode
    (Fallout.Migrate 10.4.0) and hand-checked:

        Fallout.Common 10.4.0, FalloutBuild, using Fallout.*
        (ProjectModel => Fallout.Solutions)

    The pins below are the ADR-023 pins. The root marker is .fallout/, and
    .github/workflows/fallout-pilot.yml is the CI verifier (15-target argv
    and exit-code checks plus the AOT/R9 publish).

    The project sits in its own directory so `build/Directory.Build.props`
    (permissive, no parent import, CPM off) applies to it alone.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8618</NoWarn>
    <RootNamespace>Harbor.Build</RootNamespace>
    <AssemblyName>_build.fallout</AssemblyName>

    <!--
      CPM is off for build/ in both places (build/Directory.Build.props and
      here). This file is therefore the only place the Fallout version and
      its transitive pins are decided.

      Fallout.Common 10.4.0 is pinned per ADR-023: it is the newest
      10.x listed on nuget.org that still exposes the shaded
      `Fallout.Common.ProjectModel` / `Fallout.Solutions` pair this code
      uses. The migration tool itself resolves 10.5.0 by default (it has
      no version flag); we override that with the ADR pin.

      fallout-migrate does NOT rewrite the transitive pins, and its real
      run drops the System.Security.Cryptography.Xml pin outright. We keep
      the pin here: Fallout.Tooling asks for 10.0.10, which is inside the
      11 advisory ranges 10.0.13 closes. NuGet.Packaging is 6.14.3 because
      Fallout.Tooling 10.4.0 requires it; an older pin would be NU1605
      (restore error) with CPM off. Microsoft.Build* stay at 18.0.2,
      matching Fallout.ProjectModel.
    -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.4.0"/>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13"/>
    <PackageReference Include="Microsoft.Build" Version="18.0.2"/>
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.0.2"/>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2"/>
    <PackageReference Include="NuGet.Packaging" Version="6.14.3"/>
  </ItemGroup>

</Project>
