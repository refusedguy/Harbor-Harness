<Project Sdk="Microsoft.NET.Sdk">

  <!--
    _build.csproj - NUKE build entry point.

    Lives in build/ (NOT src/, apps/, or tests/) so the solution-wide
    Directory.Build.props / targets / CPM analyzers don't apply. Instead, the
    sibling build/Directory.Build.props gives NUKE a permissive environment
    (analyzers OFF, CPM OFF, TreatWarningsAsErrors OFF).

    Run via the bootstrap scripts:
        ./build.sh Compile          [Linux / macOS]
        build.ps1 Compile           [Windows PowerShell]

    Or directly:
        dotnet run project=build Compile

    The Build.cs class defines targets: Clean, Restore, Compile, Test,
    ArchitectureTests, PublishCliMinimal, PublishCliFull, PublishSingleFile,
    PublishAot, PublishAvalonia, PublishBlazor, PublishAll.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8618</NoWarn>
    <RootNamespace>Harbor.Build</RootNamespace>
    <AssemblyName>_build</AssemblyName>

    <!--
      Disable Central Package Management for THIS project only. The solution-
      wide Directory.Packages.props enables CPM; NUKE is a build tool, not
      a shipped assembly, so we let it pin its own dep chain inline.
    -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nuke.Common" Version="9.0.4"/>
    <!--
      Direct pins override Nuke.Common 9.0.4's vulnerable transitive tree:
      - System.Security.Cryptography.Xml 8.0.0 → 10.0.11 (NU1903: GHSA-cvvh-rhrc-wg4q,
        GHSA-g8r8-53c2-pm3f, GHSA-mmjf-rqrv-855v, GHSA-w3x6-4m5h-cxqf)
      - Microsoft.Build* 17.12.6 → 17.14.28 (NU1903: GHSA-w3q9-fxm7-j8fq, GHSA-h4j7-5rxr-p4wc)
      - NuGet.Packaging 6.12.1 → 6.12.5 (NU1901: GHSA-g4vj-cjjj-v7hg)
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11"/>
    <PackageReference Include="Microsoft.Build" Version="17.14.28"/>
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.14.28"/>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28"/>
    <PackageReference Include="NuGet.Packaging" Version="6.12.5"/>
  </ItemGroup>

</Project>
