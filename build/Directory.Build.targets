<?xml version="1.0" encoding="utf-8"?>
<!--
  build/Directory.Build.targets — keep the repository-root targets in scope.

  MSBuild's Directory.Build.targets search stops at the FIRST file found
  walking up from the project directory, so this file under build/ hides the
  repository-root Directory.Build.targets from the orchestrator project.
  Import it explicitly, first, so the rest of the tree (generated-file
  settings, AOT defaults) is unchanged.

  The source exclusion this file used to carry for the retired second build
  project is gone with that project (#2183 step 4).
-->
<Project>

  <Import Project="../Directory.Build.targets"/>

</Project>
